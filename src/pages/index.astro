  .pm-clip{display:flex; align-items:center; gap:10px; text-align:left; width:100%; font-family:var(--disp); font-weight:600; font-size:14px; color:var(--bone); background:rgba(236,236,234,.03); border:1px solid rgba(236,236,234,.1); border-radius:7px; padding:11px 13px; cursor:pointer; transition:border-color .2s, background .2s}
