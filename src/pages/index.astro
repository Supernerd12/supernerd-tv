  .pm.show-detail .pm-overview{display:none}
  .pm.show-detail .pm-detail{display:block}
  .pm-pdesc{color:var(--bone); opacity:.8; font-size:14.5px; line-height:1.6; margin:10px 0 0; max-width:70ch; white-space:pre-wrap}
