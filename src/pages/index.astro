  /* detail screen */
  .pm-detailbar{display:flex; align-items:center; gap:14px; margin-bottom:16px}
  .pm-backbtn{font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--green-hi); background:none; border:1px solid rgba(186,192,30,.4); border-radius:30px; padding:7px 14px; cursor:pointer; flex:0 0 auto}
