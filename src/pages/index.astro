  .lb-nav{position:absolute; top:50%; transform:translateY(-50%); width:52px; height:52px; border-radius:50%; border:1px solid rgba(236,236,234,.3); background:rgba(5,5,5,.55); color:var(--bone); font-size:26px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center}
  .lb-x:hover,.lb-nav:hover{border-color:var(--green-hi); color:var(--green-hi)}
  .lb-prev{left:18px} .lb-next{right:18px}
  .lb-count{position:absolute; bottom:20px; left:50%; transform:translateX(-50%); font-family:var(--mono); font-size:11px; letter-spacing:.2em; color:var(--dim)}

  @media (max-width:760px){
