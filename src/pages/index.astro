---
import { getCollection } from 'astro:content';
const entries = (await getCollection('work')).sort(
  (a, b) => (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title)
);
const ORDER = entries.map((e) => e.id.replace(/\.[^.]+$/, ''));
const PROJECTS = {};
for (const e of entries) {
  const id = e.id.replace(/\.[^.]+$/, '');
  PROJECTS[id] = {
    title: e.data.title,
    tags: e.data.categories || [],
    hero: e.data.hero || '',
    description: e.data.description || '',
    pieces: (e.data.pieces || []).map((pc) => ({
      title: pc.title,
      hero: pc.hero || '',
      video: pc.video || '',
      description: pc.description || '',
      gallery: pc.gallery || [],
      novideo: pc.no_video || false,
    })),
  };
}
const WORK_JSON = JSON.stringify({ ORDER, PROJECTS });
