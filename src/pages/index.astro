  .pm-siblings::-webkit-scrollbar{height:5px} .pm-siblings::-webkit-scrollbar-thumb{background:rgba(186,192,30,.4); border-radius:3px}
  .pm-sib{font-family:var(--mono); font-size:10px; letter-spacing:.04em; color:var(--dim); background:rgba(236,236,234,.04); border:1px solid rgba(236,236,234,.12); border-radius:30px; padding:6px 12px; cursor:pointer; white-space:nowrap; transition:.2s}
  .pm-sib:hover{color:var(--bone); border-color:rgba(236,236,234,.4)}
  .pm-sib.on{color:var(--ink); background:var(--green-hi); border-color:var(--green-hi)}
  .pm-eyebrow{font-family:var(--mono); font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--dim); margin-bottom:4px}
  .pm-eyebrow:empty{display:none}
  .pm-dtitle{font-family:var(--disp); font-weight:700; font-size:clamp(21px,2.8vw,32px); letter-spacing:-.01em; margin:0 0 14px}
  .pm-gallery{position:relative; margin-top:16px}
