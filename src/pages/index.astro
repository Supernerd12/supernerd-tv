  .pm-piece-img{position:relative; aspect-ratio:16/10; border-radius:9px; background:#101010 center/cover no-repeat; border:1px solid rgba(236,236,234,.12); overflow:hidden; transition:border-color .2s, box-shadow .25s}
  .pm-piece.noimg .pm-piece-img{background:linear-gradient(135deg, rgba(186,192,30,.20), rgba(5,5,5,.65))}
