<script is:inline>
(function(){
  const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  const fine=matchMedia('(pointer:fine)').matches;
  const $=s=>document.querySelector(s);
  const smoke=$('.p-smoke'),flask=$('.p-flask'),person=$('.p-person'),fsmoke=$('.p-fsmoke');
  const word=$('#word'),wedge=$('#wedge'),bioov=$('#bioov'),nm=$('#bname'),ui=$('#ui'),intro=$('#intro');
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const fOut=(P,s,e)=>1-clamp((P-s)/(e-s),0,1);
  const fIn=(P,s,e)=>clamp((P-s)/(e-s),0,1);
  const SPAN=1.5; // viewports of scroll the turn spans; keep in sync with .scene height (250vh)
  const BIO_LAG=0.45; // on exit, the settled bio rises at this fraction of scroll speed so Work slides over it (depth). 1 = no lag

  let tx=0,ty=0,cx=0,cy=0,raf=null;

  // person turn sequence (scroll-scrubbed canvas) + sharp posters at the ends
  const pseq=$('#pseq'), pctx=pseq?pseq.getContext('2d'):null, pend=$('#pend');
  const FRAMES=121, fimgs=[]; let lastF=-1, curP=0, dpr=Math.min(2,window.devicePixelRatio||1);
  const IW=1920, IH=1080, BX=0.44257, BY=0.15479, BW=0.42499, BH=0.84521; // new tall frames shrunk to match the current figure's exact on-screen size (feet/head/center)
  function sizeSeq(){ if(!pseq)return; const r=pseq.getBoundingClientRect(); if(!r.width)return;
    pseq.width=Math.round(r.width*dpr); pseq.height=Math.round(r.height*dpr); lastF=-1; drawSeq(Math.round(curP*(FRAMES-1))); }
  function drawSeq(i){ if(!pctx)return; const img=fimgs[i]; if(!img||!img.complete||!img.naturalWidth)return;
    const cw=pseq.width,ch=pseq.height, s=Math.max(cw/IW,ch/IH), fX=(cw-IW*s)*0.7, fY=(ch-IH*s)*0.5;
    pctx.clearRect(0,0,cw,ch); pctx.drawImage(img, fX+BX*IW*s, fY+BY*IH*s, BW*IW*s, BH*IH*s); lastF=i; }
  for(let k=0;k<FRAMES;k++){ const im=new Image(); const n=String(k).padStart(3,'0');
    im.onload=()=>{ const want=Math.round(curP*(FRAMES-1)); if(k===want||(lastF<0&&k===0)) drawSeq(want); };
    im.src='/hero/seq/f'+n+'.webp'; fimgs[k]=im; }
  addEventListener('resize',sizeSeq);

  function render(){
    raf=null;
    const y=scrollY||pageYOffset,H=innerHeight,P=clamp(y/(H*SPAN),0,1); curP=P;
    const yExit=Math.max(0,y-H*SPAN);                 // px scrolled past the settled bio
    const lagY=(1-BIO_LAG)*Math.min(yExit,H);         // how far the bio is held back so Work covers it slower-than-1:1
    cx+=(tx-cx)*0.12; cy+=(ty-cy)*0.12;
    smoke.style.opacity=fOut(P,0,.55);
    smoke.style.transform=`translate(${(-cx*6).toFixed(1)}px,${(-cy*4).toFixed(1)}px)`;
    fsmoke.style.opacity=fOut(P,0,.42);
    fsmoke.style.transform=`translate(${(-cx*30).toFixed(1)}px,${(-cy*16).toFixed(1)}px)`;
    flask.style.transform=`translate(${(-cx*14).toFixed(1)}px,${(-P*0.55*H-cy*7).toFixed(1)}px)`;
    word.style.transform=`translate(${(-cx*12).toFixed(1)}px,${(-P*1.0*H-cy*6).toFixed(1)}px) translateY(-50%)`;
    const ptr=`translate(${(-cx*8).toFixed(1)}px,${(-cy*4+lagY).toFixed(1)}px)`;
    person.style.transform=ptr; person.style.opacity=fOut(P,0,.04);
    if(pseq){ pseq.style.transform=ptr; const fi=Math.round(P*(FRAMES-1)); if(fi!==lastF) drawSeq(fi); }
    if(pend){ pend.style.transform=ptr; pend.style.opacity=fIn(P,.9,1); }
    const wp=fIn(P,.1,.5); wedge.style.opacity=wp; wedge.style.transform=`translate(${((1-wp)*60).toFixed(1)}px,${lagY.toFixed(1)}px)`;
    bioov.style.transform=`translateY(${(H*(1-P)+lagY).toFixed(1)}px)`;
    const no=clamp((P-.4)/.5,0,1); nm.style.opacity=no; nm.style.filter=`blur(${((1-no)*16).toFixed(1)}px)`;
    ui.style.transform=`translateY(${(-P*H).toFixed(1)}px)`; ui.style.opacity=fOut(P,0,.5);
    if(Math.abs(cx-tx)>0.001||Math.abs(cy-ty)>0.001) schedule();
  }
  function schedule(){ if(!raf) raf=requestAnimationFrame(render); }
  addEventListener('scroll',schedule,{passive:true}); addEventListener('resize',schedule);
  function onMove(e){ tx=(e.clientX/innerWidth-.5); ty=(e.clientY/innerHeight-.5); schedule(); }
  if(fine&&!reduce) addEventListener('mousemove',onMove,{passive:true});

  let gyroOn=false;
  function startGyro(){ if(gyroOn)return; gyroOn=true;
    addEventListener('deviceorientation',e=>{ if(e.gamma==null&&e.beta==null)return;
      tx=clamp((e.gamma||0)/28,-1,1)*0.6; ty=clamp(((e.beta||0)-45)/28,-1,1)*0.6; schedule(); },{passive:true}); }
  function enableGyro(){ if(fine||reduce)return; const D=window.DeviceOrientationEvent;
    if(D&&typeof D.requestPermission==='function'){ D.requestPermission().then(s=>{if(s==='granted')startGyro();}).catch(()=>{}); } else if(D){ startGyro(); } }

  // smooth fast scroll
  function scrollToY(ty,dur){ dur=dur||650; const s=scrollY,d=ty-s,t0=performance.now(),ez=x=> x<0.5 ? 4*x*x*x : 1-Math.pow(-2*x+2,3)/2;
    (function step(t){ const k=Math.min(1,(t-t0)/dur); scrollTo(0,s+d*ez(k)); if(k<1)requestAnimationFrame(step); })(performance.now()); }

  // menu + contact
  const burger=$('#burger'),menu=$('#menu'),cmodal=$('#cmodal');
  burger.addEventListener('click',()=>document.body.classList.toggle('menu-open'));
  function openContact(){ document.body.classList.remove('menu-open'); document.body.classList.add('contact-open'); }
  function closeContact(){ document.body.classList.remove('contact-open'); }
  $('#contactBtn').addEventListener('click',openContact);
  $('#studioContactBtn')?.addEventListener('click',openContact);
  $('#cclose').addEventListener('click',closeContact);
  cmodal.addEventListener('click',e=>{ if(e.target===cmodal) closeContact(); });
  const bmodal=$('#bmodal');
  $('#metaBtn').addEventListener('click',()=>scrollToY(innerHeight*SPAN*0.99,3200));
  $('#moreBtn').addEventListener('click',()=>document.body.classList.add('bio-open'));
  $('#bclose').addEventListener('click',()=>document.body.classList.remove('bio-open'));
  bmodal.addEventListener('click',e=>{ if(e.target===bmodal) document.body.classList.remove('bio-open'); });
  addEventListener('keydown',e=>{ if(e.key==='Escape'){ closeContact(); document.body.classList.remove('menu-open','bio-open'); } });
  menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
    document.body.classList.remove('menu-open');
    if(a.hasAttribute('data-contact')){ openContact(); return; }
    const g=a.dataset.go; let y=0, dur=900;
    if(g==='0') y=0;
    else if(g==='bio'){ y=innerHeight*SPAN*0.99; dur=3200; }
    else { const el=document.querySelector(g); if(el) y=el.getBoundingClientRect().top+scrollY; }
    scrollToY(y,dur);
  }));

  function enter(){ if(document.body.classList.contains('live'))return;
    document.body.classList.add('live'); intro.classList.add('gone'); enableGyro(); sizeSeq(); schedule(); }
  ['click','keydown','wheel','touchstart'].forEach(ev=>addEventListener(ev,enter,{once:true,passive:true}));
  setTimeout(()=>{ if(!document.body.classList.contains('live')) enter(); },4600);
  sizeSeq(); schedule();
})();
</script>
</body>
