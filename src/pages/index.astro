  .wc-tags{display:block; font-family:var(--mono); font-size:10px; letter-spacing:.07em; text-transform:uppercase; color:var(--dim); margin-top:10px; line-height:1.7}
  .wcard.hide{display:none}
  @media (max-width:760px){ .wgrid{grid-template-columns:1fr} }
  /* ---------- MODAL: clip list ---------- */
  .pm-body{display:flex; gap:22px; margin-top:4px}
  .pm-stage{flex:1 1 60%; min-width:0}
  .pm-clips{flex:1 1 38%; min-width:0; display:flex; flex-direction:column}
