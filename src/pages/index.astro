      function step(ts){ if(t0===null)t0=ts; var k=Math.min(1,(ts-t0)/280); elGTrack.scrollLeft=start+(target-start)*(k*(2-k)); if(k<1)requestAnimationFrame(step); else galResumeSoon(); } requestAnimationFrame(step); }
    function lbOpen(list,i){ galPause(); lbList=list; lbI=i; lbRender(); elLB.classList.add('open'); elLB.setAttribute('aria-hidden','false'); }
    function lbRender(){ lbImg.src=lbList[lbI]||''; lbCount.textContent=(lbI+1)+' / '+lbList.length; var two=lbList.length>1; document.getElementById('lbPrev').style.display=two?'':'none'; document.getElementById('lbNext').style.display=two?'':'none'; }
    function lbStep(d){ if(!lbList.length)return; lbI=(lbI+d+lbList.length)%lbList.length; lbRender(); }
    function lbClose(){ elLB.classList.remove('open'); elLB.setAttribute('aria-hidden','true'); lbImg.src=''; galResumeSoon(); }
    function openPiece(i){ var d=curProj; if(!d||!d.pieces[i]) return; var p=d.pieces[i];
      elEyebrow.textContent=d.title; elPieceTitle.textContent=p.title||'';
      if(curPlayer){curPlayer.destroy();curPlayer=null;}
      var stage=document.getElementById('pmStage');
      if(p.video){ stage.style.display=''; curPlayer=makePlayer(elVid, p.video, p.hero||d.hero||''); }
      else if(p.novideo){ stage.style.display='none'; elVid.innerHTML=''; }
      else { stage.style.display=''; elVid.innerHTML='<div class="pm-soon"><img src="'+SOON+'" alt=""><span>Coming Soon</span></div>'; }
      aboutLock=false; elAboutWrap.classList.remove('open'); elAboutBody.style.maxHeight='0px';
      if(p.description){ elAboutInner.textContent=p.description; elAboutWrap.hidden=false; } else { elAboutWrap.hidden=true; elAboutInner.textContent=''; }
      renderGallery(p.gallery||[]);
      elSiblings.innerHTML='';
      if(d.pieces.length>1){ d.pieces.forEach(function(pp,j){ var b=document.createElement('button'); b.className='pm-sib'+(j===i?' on':''); b.textContent=pp.title||('Piece '+(j+1)); b.onclick=function(){ openPiece(j); }; elSiblings.appendChild(b); }); }
      elBack.style.display=(d.pieces.length>1?'':'none');
      modal.classList.add('show-detail'); elGTrack.scrollLeft=0; }
    function open(pid){ var d=PROJECTS[pid]; if(!d) return; curProj=d;
      elTitle.textContent=d.title;
      elTags.innerHTML=(d.tags||[]).filter(function(t){return t!=='Art Direction';}).map(function(t){return '<span>'+t+'</span>';}).join('');
      elProjDesc.textContent=d.description||''; elProjDesc.style.display=(d.description?'':'none');
      elPieceGrid.innerHTML='';
      (d.pieces||[]).forEach(function(p,i){ var b=document.createElement('button'); b.className='pm-piece'+(p.hero?'':' noimg'); b.setAttribute('data-i',i);
        b.innerHTML='<span class="pm-piece-img" style="'+bg(p.hero)+'"><span class="pm-piece-play">&#9654;</span></span><span class="pm-piece-lab"></span>';
        b.querySelector('.pm-piece-lab').textContent=p.title||('Piece '+(i+1));
        b.onclick=function(){ openPiece(i); }; elPieceGrid.appendChild(b); });
      modal.classList.remove('show-detail');
      modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.classList.add('pm-lock');
      if((d.pieces||[]).length===1){ openPiece(0); } }
    function backToOverview(){ if(curProj && curProj.pieces.length>1){ stopGal(); modal.classList.remove('show-detail'); if(curPlayer){curPlayer.destroy();curPlayer=null;} } else { close(); } }
    function close(){ stopGal(); modal.classList.remove('open','show-detail'); modal.setAttribute('aria-hidden','true'); document.body.classList.remove('pm-lock'); if(curPlayer){curPlayer.destroy();curPlayer=null;} }
    elBack.addEventListener('click',backToOverview);
    elGallery.querySelector('.pm-gprev').addEventListener('click',function(){ galScroll(-1); });
    elGallery.querySelector('.pm-gnext').addEventListener('click',function(){ galScroll(1); });
    function aboutSet(open){ elAboutWrap.classList.toggle('open',open); elAboutBody.style.maxHeight=open?(elAboutInner.offsetHeight+'px'):'0px'; }
    elAboutWrap.addEventListener('mouseenter',function(){ if(!aboutLock) aboutSet(true); });
    elAboutWrap.addEventListener('mouseleave',function(){ if(!aboutLock) aboutSet(false); });
    elAbout.addEventListener('click',function(){ aboutLock=!aboutLock; aboutSet(aboutLock); });
    (function(){ var dn=false,sx=0,sl=0;
      elGTrack.addEventListener('pointerdown',function(e){ dn=true; sx=e.clientX; sl=elGTrack.scrollLeft; gDragged=false; galPause(); try{elGTrack.setPointerCapture(e.pointerId);}catch(x){} });
      elGTrack.addEventListener('pointermove',function(e){ if(!dn)return; var dx=e.clientX-sx; if(Math.abs(dx)>4) gDragged=true; elGTrack.scrollLeft=sl-dx; });
      window.addEventListener('pointerup',function(){ if(dn){ dn=false; galResumeSoon(); } });
      elGTrack.addEventListener('wheel',function(e){ if(Math.abs(e.deltaY)>Math.abs(e.deltaX)){ galPause(); elGTrack.scrollLeft+=e.deltaY; e.preventDefault(); galResumeSoon(); } },{passive:false});
      elGallery.addEventListener('mouseenter',function(){ galPause(); });
      elGallery.addEventListener('mouseleave',function(){ if(galTimer){clearTimeout(galTimer);galTimer=null;} galPaused=false; }); })();
    document.getElementById('lbPrev').addEventListener('click',function(e){ e.stopPropagation(); lbStep(-1); });
    document.getElementById('lbNext').addEventListener('click',function(e){ e.stopPropagation(); lbStep(1); });
    document.getElementById('lbClose').addEventListener('click',lbClose);
    elLB.addEventListener('click',function(e){ if(e.target===elLB) lbClose(); });
    document.addEventListener('keydown',function(e){ if(!elLB.classList.contains('open'))return; if(e.key==='Escape')lbClose(); else if(e.key==='ArrowLeft')lbStep(-1); else if(e.key==='ArrowRight')lbStep(1); });
    var tags=[]; ORDER.forEach(function(pid){ (PROJECTS[pid].tags||[]).forEach(function(t){ if(t!=='Art Direction' && tags.indexOf(t)<0) tags.push(t); }); });
    filterBar.innerHTML='<button class="wf on" data-tag="">All</button>'+tags.map(function(t){return '<button class="wf" data-tag="'+t+'">'+t+'</button>';}).join('');
    grid.innerHTML=ORDER.map(function(pid){ var d=PROJECTS[pid]; var n=(d.pieces||[]).length;
      return '<button class="wcard'+(d.hero?'':' noimg')+'" data-proj="'+pid+'" data-tags="|'+(d.tags||[]).join('|')+'|">'
        +'<span class="wc-bg" style="'+bg(d.hero)+'"></span>'
        +'<span class="wc-top"><span class="wc-title">'+d.title+'</span><span class="wc-count">'+n+'</span></span>'
        +'<span class="wc-tags">'+(d.tags||[]).filter(function(t){return t!=='Art Direction';}).join(' &middot; ')+'</span></button>'; }).join('');
    [].forEach.call(grid.querySelectorAll('.wcard'),function(c){ c.addEventListener('click',function(){ open(c.getAttribute('data-proj')); }); });
    filterBar.addEventListener('click',function(e){ var b=e.target.closest('.wf'); if(!b) return; [].forEach.call(filterBar.children,function(x){x.classList.remove('on');}); b.classList.add('on'); var tag=b.getAttribute('data-tag');
      [].forEach.call(grid.querySelectorAll('.wcard'),function(c){ var show=(!tag)||c.getAttribute('data-tags').indexOf('|'+tag+'|')>=0; c.classList.toggle('hide',!show); }); });
    [].forEach.call(modal.querySelectorAll('[data-pmclose]'),function(b){ b.addEventListener('click',close); });
    document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&modal.classList.contains('open')&&!elLB.classList.contains('open')) close(); });
  })();


  (function(){
    var sec=document.querySelector('.collab'); if(!sec) return;
    var track=sec.querySelector('.cl-track'), spine=sec.querySelector('.cl-spine'), robot=sec.querySelector('#clrobot'), robotBox=sec.querySelector('.cl-robot');
    if(!track) return;
    var revs=[].slice.call(sec.querySelectorAll('[data-rev]'));
    var N=61, frames=[], pad=function(n){n=''+n; while(n.length<3)n='0'+n; return n;};
    for(var k=0;k<N;k++){ var im=new Image(); im.src='/collab/seq/r'+pad(k)+'.webp'; frames.push(im); }
    if(robot) robot.src=frames[0].src;
    var cur=-1, reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduce){ revs.forEach(function(el){el.classList.add('in');}); if(spine) spine.style.transform='scaleY(1)'; }
    else sec.classList.add('cl-on');
    var vh=innerHeight, total=Math.max(1,track.offsetHeight-vh), ticking=false;
    function cl(v){return v<0?0:v>1?1:v;}
    function recalc(){ vh=innerHeight; total=Math.max(1,track.offsetHeight-vh); }
    function update(){ ticking=false;
      var r=track.getBoundingClientRect();
      var p=cl(-r.top/total);                 /* pinned progress: categories + spine */
      var rH=robotBox?robotBox.getBoundingClientRect().height:vh*0.5;
      var START=Math.max(1, vh - rH);         /* don't start the pour until the arm is fully on-screen */
      var ap=cl(1 - r.top/START);             /* finishes exactly as it locks to the top */
      if(robot){ var idx=Math.round(ap*(N-1)); if(idx!==cur){ cur=idx; robot.src=frames[idx].src; } }
      if(robotBox){ if(ap>=0.985) robotBox.classList.add('glow-on'); else robotBox.classList.remove('glow-on'); }
      if(!reduce){
        for(var i=0;i<revs.length;i++){ var t=parseFloat(revs[i].getAttribute('data-rev'));
          if(p>=t){ if(!revs[i].classList.contains('in')) revs[i].classList.add('in'); }
          else if(revs[i].classList.contains('in')) revs[i].classList.remove('in'); }
        if(spine) spine.style.transform='scaleY('+cl((p-0.02)/0.84)+')';
      }
    }
    function onScroll(){ if(!ticking){ ticking=true; requestAnimationFrame(update); } }
    addEventListener('scroll',onScroll,{passive:true});
    addEventListener('resize',function(){recalc();update();});
    recalc(); update();
  })();
  $('#bclose').addEventListener('click',()=>document.body.classList.remove('bio-open'));
  bmodal.addEventListener('click',e=>{ if(e.target===bmodal) document.body.classList.remove('bio-open'); });
  addEventListener('keydown',e=>{ if(e.key==='Escape'){ closeContact(); document.body.classList.remove('menu-open','bio-open'); } });
  menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
    document.body.classList.remove('menu-open');
    if(a.hasAttribute('data-contact')){ openContact(); return; }
    const g=a.dataset.go; let y=0, dur=900;
    if(g==='0') y=0;
    else if(g==='bio'){ y=innerHeight*SPAN*0.99; dur=3200; }
    else { const el=document.querySelector(g); if(el) y=el.getBoundingClientRect().top+scrollY; }
    scrollToY(y,dur);
  }));

  function enter(){ if(document.body.classList.contains('live'))return;
    document.body.classList.add('live'); intro.classList.add('gone'); enableGyro(); sizeSeq(); schedule(); }
  ['click','keydown','wheel','touchstart'].forEach(ev=>addEventListener(ev,enter,{once:true,passive:true}));
  setTimeout(()=>{ if(!document.body.classList.contains('live')) enter(); },4600);
  sizeSeq(); schedule();
})();
</script>
</body>
