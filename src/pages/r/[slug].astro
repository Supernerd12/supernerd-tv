    H+=sectionWrap(eyebrow('Decisions needed')+'<table role="presentation" width="100%" cellpadding="0" cellspacing="0">'+qs+'</table>');
  }
  // WHAT IS LOCKED
  if(d.locked.length){
    var lk=d.locked.map(function(t){ return '<tr><td width="22" valign="top" style="font-size:14px;color:'+ACID+';padding:7px 8px 7px 0;">\u2713</td><td style="font-family:'+disp+';font-size:14px;line-height:1.5;color:'+G3+';padding:7px 0;">'+nlEsc(t)+'</td></tr>'; }).join('');
    H+=sectionWrap(eyebrow('What is locked')+'<table role="presentation" width="100%" cellpadding="0" cellspacing="0">'+lk+'</table>');
  }

  return '<div style="margin:0;padding:0;background:'+VOID+';">'
    +'<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:'+VOID+';padding:26px 0;font-family:'+disp+';"><tr><td align="center">'
    +'<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:'+INK2+';border:1px solid '+LINE+';border-radius:18px;overflow:hidden;">'
