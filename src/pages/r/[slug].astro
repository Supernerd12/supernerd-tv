    try{ await sb.from('newsletters').upsert({ review_slug:CONFIG.REVIEW_SLUG, project_key:NL.proj, data:NL.data, updated_by:me, updated_at:new Date().toISOString(), last_sent_at:new Date().toISOString() },{onConflict:'review_slug,project_key'}); }catch(e){}
    nlStatus('Sent to '+recips.length+' \u2713','ok');
  }catch(e){ nlStatus('Send failed: '+(e.message||'unknown'),'err'); }
  if(btn){ btn.disabled=false; btn.textContent='Send to project'; }
}

/* ============================================================
   v25 — APPROVALS (per-version sign-off)
   ============================================================ */
var APPROVALS = { proj:null, byAsset:{} };
var APPR_CUR=null, APPR_GRID=null;
function myCanApprove(){ return (typeof ADMIN!=='undefined' && ADMIN) || !!(AUTH && AUTH.canApprove); }
function apprCheck(){ return '<svg class="appr-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>'; }
function apprDate(iso){ try{ return new Date(iso).toLocaleDateString(undefined,{month:'short',day:'numeric'}); }catch(e){ return ''; } }
function apprStackOf(proj,itemId){ var found=null; (proj.sections||[]).forEach(function(sec){ (sec.stacks||[]).forEach(function(st){ if((st.versions||[]).some(function(v){return v.id===itemId;})) found=st; }); }); return found; }
function approvalsEnsure(projId){ if(APPROVALS.proj===projId){ apprRepaint(); return; } approvalsLoad(projId); }
async function approvalsLoad(projId){ APPROVALS.proj=projId; APPROVALS.byAsset={}; try{ var r=await sb.from('approvals').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',projId); (r.data||[]).forEach(function(a){ APPROVALS.byAsset[a.asset_id]=a; }); }catch(e){} apprRepaint(); }
function apprRepaint(){ if(APPR_CUR&&APPR_CUR.it){ apprRenderItem(APPR_CUR.proj,APPR_CUR.sec,APPR_CUR.it); } apprGridPaintAll(); }
function apprGridPaintAll(){ if(!APPR_GRID) return; (APPR_GRID.sec.stacks||[]).forEach(function(st){ var el=document.getElementById('rc-appr-'+st.id); if(!el) return; var v=st.versions[0]||{}; el.hidden = !APPROVALS.byAsset[assetId(APPR_GRID.proj,APPR_GRID.sec,v)]; }); }
function apprRenderItem(proj,sec,it){
  APPR_CUR={proj:proj,sec:sec,it:it};
  var slot=document.getElementById('appr-'+it.id); if(!slot) return;
  var a=APPROVALS.byAsset[assetId(proj,sec,it)]; var can=myCanApprove();
  if(a){
    var who=esc(a.approved_by_name||'Client'); var when=a.approved_at?apprDate(a.approved_at):'';
    slot.innerHTML='<span class="appr-badge ok" title="Approved'+(when?(' '+esc(when)):'')+'">'+apprCheck()+'Approved'+(a.approved_by_name?(' \u00b7 '+who):'')+(when?(' \u00b7 '+esc(when)):'')+'</span>'+(can?'<button class="appr-undo" type="button">Undo</button>':'');
    var u=slot.querySelector('.appr-undo'); if(u) u.onclick=function(){ apprUndo(proj,sec,it); };
  } else if(can){
    slot.innerHTML='<button class="appr-btn" type="button">'+apprCheck()+'Approve this version</button>';
    var b=slot.querySelector('.appr-btn'); if(b) b.onclick=function(){ apprApprove(proj,sec,it); };
  } else { slot.innerHTML=''; }
}
async function apprApprove(proj,sec,it){
  var slot=document.getElementById('appr-'+it.id); if(slot){ var b=slot.querySelector('.appr-btn'); if(b){ b.disabled=true; b.innerHTML=apprCheck()+'Approving\u2026'; } }
  var st=apprStackOf(proj,it.id);
  var nm=(AUTH&&AUTH.profile&&AUTH.profile.full_name)||myEmail()||'Client';
  var row={ review_slug:CONFIG.REVIEW_SLUG, project_key:proj.id, asset_id:assetId(proj,sec,it), stack_key:(st?st.id:null), title:(st?st.title:itemTitle(it)), version_label:(it.version||''), approved_by_name:nm, approved_by_email:myEmail(), approved_at:new Date().toISOString() };
  try{ var r=await sb.from('approvals').upsert(row,{onConflict:'review_slug,asset_id'}).select().single(); if(r.error){ alert('Could not approve: '+r.error.message); apprRenderItem(proj,sec,it); return; } APPROVALS.byAsset[row.asset_id]=r.data||row; }catch(e){ alert('Could not approve.'); apprRenderItem(proj,sec,it); return; }
  apprRenderItem(proj,sec,it); apprGridPaintAll();
}
async function apprUndo(proj,sec,it){
  if(!confirm('Remove approval from this version?')) return;
  try{ await sb.from('approvals').delete().eq('review_slug',CONFIG.REVIEW_SLUG).eq('asset_id',assetId(proj,sec,it)); }catch(e){}
  delete APPROVALS.byAsset[assetId(proj,sec,it)]; apprRenderItem(proj,sec,it); apprGridPaintAll();
}

/* ============================================================
