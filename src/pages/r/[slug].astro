  .ip-msg{font-family:var(--mono);font-size:11px;color:var(--green);margin-top:10px;min-height:13px}

  /* ===================================================================
     v10 — online presence dots, admin remove, partner detail
     =================================================================== */
  .pc-avwrap{position:relative;flex:0 0 auto}
  .pc-dot{position:absolute;right:-1px;bottom:-1px;width:13px;height:13px;border-radius:50%;background:#5a5e66;border:2.5px solid #16181c;transition:background .2s,box-shadow .2s}
  .pc-dot.on{background:#3fcf5e;box-shadow:0 0 9px rgba(63,207,94,.65)}
  .pc-remove{position:absolute;top:10px;right:10px;width:24px;height:24px;border-radius:7px;border:1px solid var(--hair-2);background:rgba(0,0,0,.35);color:var(--dim);cursor:pointer;font-size:15px;line-height:1;z-index:3;opacity:0;transition:opacity .15s,color .15s,border-color .15s}
  .pcard:hover .pc-remove{opacity:1}
  .pc-remove:hover{color:#e5757a;border-color:rgba(229,72,77,.5);background:rgba(229,72,77,.12)}
  .pd-top{display:flex;align-items:center;gap:14px;margin-bottom:16px}
  .pd-av{width:60px;height:60px;font-size:22px}
  .pd-name{font-size:19px;font-weight:800;letter-spacing:-.02em}
  .pd-role{font-family:var(--mono);font-size:12px;color:var(--dim);margin-top:3px}
  .pd-meta{font-family:var(--mono);font-size:12px;color:var(--bone);display:flex;flex-direction:column;gap:9px;padding:15px 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);margin-bottom:16px}
  .pd-meta>div{display:flex;align-items:center}
  .pd-meta .logo-mono{width:34px;height:34px;font-size:14px;margin-right:2px}
  .pd-email{color:var(--dim)}
  .pd-status{color:var(--dim)}
  .pd-remove{width:100%;font-family:var(--mono);font-size:12px;color:#e5757a;background:rgba(229,72,77,.08);border:1px solid rgba(229,72,77,.3);border-radius:10px;padding:12px;cursor:pointer;margin-bottom:6px}
  .pd-remove:hover{background:rgba(229,72,77,.15)}

  /* ===================================================================
     v11 — avatar cropper (zoom + reposition)
     =================================================================== */
  .cr-card{width:100%;max-width:340px;border-radius:22px;padding:26px;background:linear-gradient(170deg,#191b1f,#0d0e10 84%);border:1px solid rgba(255,255,255,.08);box-shadow:0 40px 120px -40px #000,inset 0 1px 0 rgba(255,255,255,.05);text-align:center}
  .cr-title{font-size:19px;font-weight:800;letter-spacing:-.02em}
  .cr-sub{font-family:var(--mono);font-size:11px;color:var(--dim);margin:5px 0 18px}
  .cr-stage{position:relative;width:264px;height:264px;margin:0 auto;border-radius:50%;overflow:hidden;background:#0b0c0d;cursor:grab;touch-action:none;box-shadow:0 0 0 1px rgba(255,255,255,.08)}
  .cr-stage:active{cursor:grabbing}
  .cr-stage img{position:absolute;user-select:none;-webkit-user-drag:none;max-width:none}
  .cr-ring{position:absolute;inset:0;border-radius:50%;box-shadow:inset 0 0 0 2px rgba(186,192,30,.45);pointer-events:none}
