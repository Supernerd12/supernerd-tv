  .meta-bar{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; flex-wrap:wrap}
  .up-stamp{font-family:var(--mono); font-size:11px; color:var(--dim)}
  .ver-chips{display:inline-flex; gap:6px; flex-wrap:wrap; margin-left:10px; vertical-align:middle}
