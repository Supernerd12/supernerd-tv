import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const reviews  = (await getCollection('reviews')).filter(r => r.data.published !== false);
  const projects = (await getCollection('reviewProjects')).filter(p => p.data.published !== false);
  const sections = (await getCollection('reviewSections')).filter(s => s.data.published !== false);
  const items    = (await getCollection('reviewItems')).filter(i => i.data.published !== false);

  const cleanId = (id) => String(id).replace(/\.(json|ya?ml)$/i, '');

  return reviews.map((review) => {
    const co = review.data;

    const PROJECTS = projects
      .filter(p => p.data.company_key === co.key)
      .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
      .map((p) => {
        const secs = sections
          .filter(s => s.data.project_key === p.data.key)
          .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
          .map((s) => {
            const its = items
              .filter(i => i.data.section_key === s.data.key)
              .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
              .map(i => ({
                id: cleanId(i.id),
                type: i.data.kind,
                title: i.data.title || '',
                label: i.data.label || '',
                version: i.data.version || '',
                stream_uid: i.data.stream_uid || '',
                src: i.data.image || i.data.src_url || '',
                download_url: i.data.download_url || '',
                date: i.data.date || '',
                archived: i.data.archived === true,
              }));
            return {
              id: s.data.key,
              name: s.data.name,
              current: its.filter(x => !x.archived),
              archive: its.filter(x => x.archived),
            };
          });
        return { id: p.data.key, title: p.data.title, tagline: p.data.tagline || '', sections: secs };
      });

    const data = { REVIEW_SLUG: co.key, COMPANY: { name: co.name, logo: co.logo || '' }, PROJECTS };
    return { params: { slug: co.url_slug }, props: { data } };
  });
}

