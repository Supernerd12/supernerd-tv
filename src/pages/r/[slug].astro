  .onb-av .drop:hover{border-color:rgba(186,192,30,.5);color:var(--green)}
  .onb-av .av-tx{font-family:var(--mono);font-size:11px;color:var(--dim);line-height:1.5}
  .onb-field{margin-bottom:16px}
