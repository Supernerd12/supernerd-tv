  .meta-bar{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; flex-wrap:wrap}
  .up-stamp{font-family:var(--mono); font-size:11px; color:var(--dim)}
  .ver-chips{display:inline-flex; gap:6px; flex-wrap:wrap; margin-left:10px; vertical-align:middle}
  .ver-chip{font-family:var(--mono); font-size:11px; letter-spacing:.04em; padding:3px 10px; border-radius:999px; border:1px solid rgba(186,192,30,.5); color:var(--green-hi); background:transparent; cursor:pointer; transition:background .12s var(--ease), color .12s var(--ease), border-color .12s var(--ease)}
