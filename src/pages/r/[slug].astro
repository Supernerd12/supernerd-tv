function openLogin(){ var ov=document.createElement('div'); ov.className='onb show'; ov.id='lmOv'; ov.innerHTML='<div class="lm-modal" id="lmCard"></div>'; document.body.appendChild(ov); ov.addEventListener('click',function(e){ if(e.target===ov) closeLogin(); }); loginStep1(); }
function closeLogin(){ var ov=document.getElementById('lmOv'); if(ov) ov.remove(); }
function loginStep1(){
  document.getElementById('lmCard').innerHTML='<div class="lm-title">Log in</div><div class="lm-sub">Access your partner profile for this project. No password needed.</div>'
    +'<button class="lm-google" id="lmG">'+gIcon()+' Continue with Google</button><div class="lm-or">or</div>'
    +'<div class="lm-mail"><input id="lmEmail" type="email" placeholder="you@company.com"><button id="lmSend">Magic link</button></div>'
    +'<div class="lm-msg" id="lmMsg"></div><div class="lm-foot"><button id="lmCancel">Cancel</button></div>';
  document.getElementById('lmG').onclick=function(){ signInGoogle(); };
  document.getElementById('lmSend').onclick=async function(){
