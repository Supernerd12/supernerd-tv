  .invite-pop{position:absolute;z-index:30;margin-top:8px;right:0;width:330px;padding:16px;border-radius:14px;background:rgba(18,19,22,.98);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid var(--hair-2);box-shadow:0 26px 70px -28px #000;text-align:left}
  .invite-pop h4{margin:0 0 4px;font-size:15px;font-weight:700}
  .invite-pop p{margin:0 0 12px;font-family:var(--mono);font-size:11px;color:var(--dim);line-height:1.5}
