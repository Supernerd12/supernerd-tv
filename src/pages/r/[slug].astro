import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const reviews  = (await getCollection('reviews')).filter(r => r.data.published !== false);
  const projects = (await getCollection('reviewProjects')).filter(p => p.data.published !== false);
  const items    = (await getCollection('reviewItems')).filter(i => i.data.published !== false);

  const cleanId = (id) => String(id).replace(/\.(json|ya?ml)$/i, '');
  const slug = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const pv = (v) => { const m = String(v || '').match(/(\d+)/); return m ? parseInt(m[1], 10) : 0; };
  const inferKind = (d) => {
    if (d.kind) return d.kind;
    if (d.stream_uid) return 'video';
    if (d.image) return 'image';
    const u = (d.src_url || d.image_url || '').toLowerCase();
    if (/\.(mp3|wav|m4a|aac|ogg|flac)$/.test(u)) return 'audio';
    if (/\.(png|jpe?g|gif|webp|svg|avif)$/.test(u)) return 'image';
    if (u) return 'file';
    return 'image';
  };
  const dateFromId = (id, explicit) => {
    if (explicit) return explicit;
    const m = String(id).match(/(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/);
    if (m) return `${m[1]}-${m[2]}-${m[3]}T${m[4]}:${m[5]}:${m[6]}`;
    return '';
  };

  return reviews.map((review) => {
    const co = review.data;

    const PROJECTS = projects
      .filter(p => p.data.company_key === co.key)
      .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
      .map((p) => {
        const mine = items
          .filter(i => i.data.project_key === p.data.key)
          .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
          .map((i) => {
            const id = cleanId(i.id);
            return {
              id,
              section: ((i.data.section || i.data.section_key || 'Other').trim()) || 'Other',
              type: inferKind(i.data),
              title: i.data.title || i.data.label || '',
              version: i.data.version || '',
              stream_uid: i.data.stream_uid || '',
              src: i.data.image || i.data.src_url || i.data.image_url || '',
              download_url: i.data.download_url || '',
              date: dateFromId(id, i.data.date),
            };
          });

        // group by section (order of first appearance)
        const secOrder = []; const secMap = new Map();
        for (const it of mine) {
          if (!secMap.has(it.section)) { secMap.set(it.section, []); secOrder.push(it.section); }
          secMap.get(it.section).push(it);
        }

        const sections = secOrder.map((sName) => {
          const list = secMap.get(sName);
          // group by Title into version stacks
          const stOrder = []; const stMap = new Map();
          for (const it of list) {
            const key = ((it.title || '').trim().toLowerCase()) || ('__' + it.id);
            if (!stMap.has(key)) { stMap.set(key, []); stOrder.push(key); }
            stMap.get(key).push(it);
          }
          const used = new Set();
          const stacks = stOrder.map((key) => {
            const versions = stMap.get(key).slice().sort((a, b) => {
              const dv = pv(b.version) - pv(a.version);
              if (dv !== 0) return dv;
              return String(b.date || '').localeCompare(String(a.date || ''));
            });
            const title = versions[0].title || 'Untitled';
            let base = (slug(sName) || 'sec') + '--' + (slug(title) || 'item');
            let sid = base, k = 2;
            while (used.has(sid)) { sid = base + '-' + (k++); }
            used.add(sid);
            return { id: sid, title, versions };
          });
          return { id: sName, name: sName, stacks };
        });

        return { id: p.data.key, title: p.data.title, tagline: p.data.tagline || '', sections };
      });

    const data = { REVIEW_SLUG: co.key, OWNER_LOGINS: ["hello@supernerd.tv","shaun@supernerd.tv"], COMPANY: { name: co.name, logo: co.logo || '' }, PROJECTS };
    return { params: { slug: co.url_slug }, props: { data } };
  });
}

