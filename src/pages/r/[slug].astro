function gridCardHTML(proj, sec, stack){
  const sel=stack.versions[0];
  const thumb=previewFor(sel);
  const verLabel=sel.version || ('v'+stack.versions.length);
  const kind=(sel.type||'').toUpperCase();
  const date=sel.date?fmtDate(sel.date):'';
  const thumbStyle=thumb?' style="background-image:url('+thumb.replace(/["\\]/g,'')+')"':'';
  const ph=thumb?'':'<span class="rc-ph">'+(sel.type==='video'?'▶':(sel.type==='audio'?'♪':(sel.type==='file'?'⤓':'▣')))+'</span>';
  const vbadge=(stack.versions.length>1||sel.version)?'<span class="rc-ver">'+esc(verLabel)+'</span>':'';
  const hideFlag=((typeof ADMIN!=='undefined'&&ADMIN) && isHidden(visKeyStack(proj.id,sec.id,stack.id)))?'<span class="hidden-flag">HIDDEN</span>':'';
  return '<a class="rcard" href="#p='+encodeURIComponent(proj.id)+'&s='+encodeURIComponent(sec.id)+'&k='+encodeURIComponent(stack.id)+'">'
    +'<div class="rc-thumb'+(thumb?'':' is-ph')+'"'+thumbStyle+'>'+ph+(kind?'<span class="rc-kind">'+esc(kind)+'</span>':'')+vbadge+'<span class="rc-appr" id="rc-appr-'+esc(stack.id)+'" hidden>'+apprCheck()+'</span>'+hideFlag+'<span class="rc-count" id="rc-count-'+esc(stack.id)+'"></span></div>'
    +'<div class="rc-meta"><span class="rc-title">'+esc(stack.title)+'</span><span class="rc-sub">'+esc(date||(stack.versions.length+' version'+(stack.versions.length===1?'':'s')))+'</span></div></a>';
}
async function loadGridCounts(proj, sec){
  try{
    const ids=[], map={};
    sec.stacks.forEach(st=>st.versions.forEach(v=>{ const aid=assetId(proj,sec,v); ids.push(aid); map[aid]=st.id; }));
    if(!ids.length) return;
    const { data, error }=await sb.from('comments').select('asset_id').eq('review_slug',CONFIG.REVIEW_SLUG).in('asset_id', ids);
    if(error) throw error;
    const counts={}; (data||[]).forEach(r=>{ const sid=map[r.asset_id]; if(sid) counts[sid]=(counts[sid]||0)+1; });
    sec.stacks.forEach(st=>{ const el=document.getElementById('rc-count-'+st.id); if(el){ const n=counts[st.id]||0; el.textContent='💬 '+n; el.classList.toggle('zero', n===0); } });
  }catch(e){ /* counts are best-effort */ }
}

/* ---------- a stack (deliverable + versions) ---------- */
function getSplit(){ var v; try{ v=parseFloat(localStorage.getItem('sn_versplit')); }catch(e){} return (v>=40&&v<=78)?v:64; }
function applySplit(p){ document.querySelectorAll('.ver-layout').forEach(function(l){ l.style.setProperty('--lp', p+'%'); }); }
function wireResizer(){
  applySplit(getSplit());
  document.querySelectorAll('.ver-gutter').forEach(function(g){
    if(g._wired) return; g._wired=true;
    g.addEventListener('pointerdown', function(e){
      var lay=g.closest('.ver-layout'); if(!lay) return;
      e.preventDefault(); g.classList.add('drag');
      try{ g.setPointerCapture(e.pointerId); }catch(_){}
      function clamp(ev){ var r=lay.getBoundingClientRect(); var p=(ev.clientX-r.left)/r.width*100; return Math.max(40,Math.min(78,p)); }
      function mv(ev){ applySplit(clamp(ev)); }
      function up(ev){ g.classList.remove('drag'); var p=clamp(ev); applySplit(p); try{ localStorage.setItem('sn_versplit', String(p)); }catch(_){} document.removeEventListener('pointermove',mv); document.removeEventListener('pointerup',up); }
      document.addEventListener('pointermove',mv); document.addEventListener('pointerup',up);
    });
  });
}
function stackHTML(proj, sec, stack){
  const sel = stack.versions[0];
  const showChips = stack.versions.length > 1 || !!sel.version;
  const chips = showChips ? '<div class="ver-chips">' + stack.versions.map((v,i)=>{
    const label = v.version || fmtDate(v.date) || ('v'+(stack.versions.length - i));
    return '<button class="ver-chip'+(i===0?' active':'')+'" data-stack="'+esc(stack.id)+'" data-v="'+esc(v.id)+'">'+esc(label)+'</button>';
  }).join('') + '</div>' : '';
  return '<section class="deliv" id="stack-'+stack.id+'"><div class="ver-layout" id="vlay-'+stack.id+'">'
    +'<div class="ver-head-l"><span class="deliv-title">'+esc(stack.title)+'</span>'+chips+'</div>'
    +'<div class="ver-gutter" id="vgut-'+stack.id+'" title="Drag to resize"><span class="vg-grip"></span></div>'
    +'<div class="ver-body" id="vbody-'+stack.id+'">'+versionBodyHTML(proj,sec,sel)+'</div>'
    +'</div></section>';
}

function selectVersion(stackId, versionId){
  const ctx=findStack(stackId); if(!ctx) return;
  const v=ctx.stack.versions.find(x=>x.id===versionId); if(!v) return;
  const body=document.getElementById('vbody-'+stackId); if(!body) return;
  body.innerHTML=versionBodyHTML(ctx.proj, ctx.sec, v);
  const stackEl=document.getElementById('stack-'+stackId);
  if(stackEl) stackEl.querySelectorAll('.ver-chip').forEach(c=> c.classList.toggle('active', c.dataset.v===versionId));
  wireVersion(ctx.proj, ctx.sec, v);
  apprRenderItem(ctx.proj, ctx.sec, v);
}

/* ---------- media ---------- */
function mediaHTML(it){
  if(it.type==='video' && it.stream_uid){
    return '<div class="stage" id="stage-'+it.id+'"><iframe id="if-'+it.id+'" src="https://'+CONFIG.STREAM_CUSTOMER+'/'+it.stream_uid+'/iframe" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;" allowfullscreen></iframe></div>';
  }
  if(it.type==='image' && it.src){
    return '<div class="stage is-image" id="stage-'+it.id+'"><div class="pin-wrap"><img id="img-'+it.id+'" src="'+esc(it.src)+'" alt="'+esc(itemTitle(it))+'" title="Click to enlarge"><div class="pin-layer" id="pinlayer-'+it.id+'"></div></div></div>';
  }
  if(it.type==='audio' && (it.src||it.download_url)){
    return '<div class="stage is-audio" id="stage-'+it.id+'"><audio controls src="'+esc(it.src||it.download_url)+'"></audio></div>';
  }
  if(it.type==='file'){
    return '<div class="stage is-file" id="stage-'+it.id+'"><div class="file-card"><div class="file-ic">⤓</div><div class="file-name">'+esc(itemTitle(it))+'</div></div></div>';
  }
  const need = it.type==='video' ? 'a Stream video ID' : (it.type==='image' ? 'an image' : 'a file URL');
  return '<div class="stage '+(it.type==='image'?'is-image':'')+'" id="stage-'+it.id+'"><div class="ph">Add '+need+' for "'+esc(itemTitle(it))+'".</div></div>';
}

function versionBodyHTML(proj, sec, it){
  const dl = downloadHref(it);
  const dlBtn = dl ? '<a class="dl-btn" href="'+esc(dl)+'" download target="_blank" rel="noopener">⤓ Download</a>' : '';
  const stamp = it.date ? '<span class="up-stamp">Uploaded '+esc(fmtStamp(it.date))+'</span>' : '';
  const shareBtn = '<button class="meta-share" id="share-'+it.id+'" type="button" title="Share">'+svgIcon('share')+'<span>Share</span></button><div class="share-pop" id="sharepop-'+it.id+'" hidden></div>';
  const gifBtn = (it.type==='video' && it.stream_uid && (typeof ADMIN!=='undefined' && ADMIN)) ? '<button class="meta-share gifbtn" id="gif-'+it.id+'" type="button" title="Make a looping GIF for slides"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 9v6M11 9v6M15 12h2.5M15 9h3M15 9v6"/></svg><span>GIF</span></button>' : '';
  const metaBar = '<div class="meta-bar"><div class="meta-left">'+dlBtn+stamp+'</div><div class="meta-right"><span class="appr" id="appr-'+it.id+'"></span>'+gifBtn+shareBtn+'</div></div>';
  const tcField = it.type==='video' ? '<div class="field f-tc"><label>Timecode</label><div class="tc-wrap"><input id="tc-'+it.id+'" placeholder="00:00"><button type="button" class="tc-now" id="tcnow-'+it.id+'" title="Grab the current play position">\u23f1 now</button></div></div>' : '';
  const pinTool = it.type==='image' ? '<button class="tool-btn" id="pin-'+it.id+'" type="button">📍 Pin to image</button><span class="pin-ind" id="pin-ind-'+it.id+'"></span>' : '';
  const composer = '<div class="composer"><div class="reply-ctx" id="replyctx-'+it.id+'" hidden></div>'
    + (tcField?'<div class="row">'+tcField+'</div>':'')
    + '<div class="field comp-body"><label>Note <span class="at-hint">— type @ to mention &amp; notify someone</span></label><textarea id="body-'+it.id+'" placeholder="What should change, or what is working? Type @ to tag someone."></textarea><div class="mention-pop" id="mentionpop-'+it.id+'" hidden></div></div>'
    + '<div class="composer-tools"><button class="tool-btn" id="rec-'+it.id+'" type="button">🎤 Record voice note</button>'+pinTool+'</div>'
    + '<div class="rec-prev" id="rec-prev-'+it.id+'"></div>'
    + '<div class="composer-foot"><button class="post" id="post-'+it.id+'" disabled>Post note</button><span class="msg" id="msg-'+it.id+'"></span></div></div>';
  const notesBar = '<div class="ver-head-r"><div class="notes-bar"><h3>Notes</h3><span class="count" id="count-'+it.id+'"></span><button class="notes-toggle" id="ntog-'+it.id+'" type="button" aria-expanded="true">Collapse</button></div></div>';
  const main = '<div class="ver-main">' + mediaHTML(it) + metaBar + composer + '</div>';
  const side = '<div class="ver-side"><div id="notes-'+it.id+'" class="notes-list fan"><div class="empty">Loading notes…</div></div></div>';
  return notesBar + main + side;
}

function gateFor(it){
  const btn=document.getElementById('post-'+it.id); if(!btn) return;
  const bEl=document.getElementById('body-'+it.id);
  const b=(bEl&&bEl.value||'').trim();
  btn.disabled = !(b || pendingAudio[it.id]);
}

function wireVersion(proj, sec, it){
  if(it.type==='video' && it.stream_uid && window.Stream){ try{ players[it.id]=Stream(document.getElementById('if-'+it.id)); }catch(e){} }
  var _gb=document.getElementById('gif-'+it.id); if(_gb) _gb.onclick=function(){ gifMaker(proj,sec,it); };
  if(it.type==='video'){
    var _tc=document.getElementById('tc-'+it.id), _body=document.getElementById('body-'+it.id), _now=document.getElementById('tcnow-'+it.id), _tcAuto=true;
    var _cur=function(){ try{ var p=players[it.id]; if(p && typeof p.currentTime==='number' && p.currentTime>0) return secsToTc(p.currentTime); }catch(e){} return null; };
    var _fill=function(){ var t=_cur(); if(t!=null && _tc){ _tc.value=t; } };
    if(_tc) _tc.addEventListener('input', function(){ _tcAuto=false; });
    if(_tc) _tc.addEventListener('focus', function(){ if(_tcAuto && !_tc.value) _fill(); });
    if(_body) _body.addEventListener('focus', function(){ if(_tcAuto && _tc && !_tc.value) _fill(); });
    if(_now) _now.addEventListener('click', function(){ _fill(); _tcAuto=false; if(_tc) _tc.focus(); });
  }
  if(it.type==='image' && it.src){ const img=document.getElementById('img-'+it.id); if(img) img.addEventListener('click', ()=>{ if(!pinMode[it.id]) lightboxImage(it.src, itemTitle(it)); }); }

  // pin controls (images)
  if(it.type==='image'){
    const pinBtn=document.getElementById('pin-'+it.id);
    const layer=document.getElementById('pinlayer-'+it.id);
    if(pinBtn) pinBtn.addEventListener('click', ()=>{
      pinMode[it.id]=!pinMode[it.id];
      pinBtn.classList.toggle('active', pinMode[it.id]);
      if(layer) layer.classList.toggle('arming', pinMode[it.id]);
      const ind=document.getElementById('pin-ind-'+it.id); if(ind) ind.textContent = pinMode[it.id] ? 'click the image to drop a pin' : '';
    });
    if(layer) layer.addEventListener('click', (e)=>{
      if(!pinMode[it.id]) return;
      const r=layer.getBoundingClientRect();
      const x=Math.max(0,Math.min(100,((e.clientX-r.left)/r.width)*100));
      const y=Math.max(0,Math.min(100,((e.clientY-r.top)/r.height)*100));
      pendingPin[it.id]={x,y};
      let pm=layer.querySelector('.pin-marker.pending'); if(!pm){ pm=document.createElement('span'); pm.className='pin-marker pending'; pm.textContent='+'; layer.appendChild(pm); }
      pm.style.left=x+'%'; pm.style.top=y+'%';
      const ind=document.getElementById('pin-ind-'+it.id); if(ind) ind.textContent='📍 pin set — write your note and post';
    });
  }

  // record voice note
  const rec=document.getElementById('rec-'+it.id);
  if(rec) rec.addEventListener('click', ()=>toggleRecord(it));

  // notes delegation: delete, seek, pin-badge, reactions, replies
  const box=document.getElementById('notes-'+it.id);
  if(box) box.addEventListener('click', (e)=>{
    const d=e.target.closest('.note-del'); if(d){ deleteNote(it.id, d.dataset.c); return; }
    const rcp=e.target.closest('.react-chip'); if(rcp){ toggleReaction(proj,sec,it, rcp.dataset.c, rcp.dataset.emoji); return; }
    const radd=e.target.closest('.react-add'); if(radd){ e.stopPropagation(); openReactPop(proj,sec,it, radd); return; }
    const rb=e.target.closest('.reply-btn'); if(rb){ setReply(it, rb.dataset.c); return; }
    const t=e.target.closest('.tc'); if(t && t.dataset.sec){ seek(it.id, +t.dataset.sec); return; }
    const pb=e.target.closest('.pin-badge'); if(pb){ const layer=document.getElementById('pinlayer-'+it.id); if(layer){ const mk=layer.querySelector('.pin-marker[data-c="'+pb.dataset.c+'"]'); if(mk){ mk.classList.add('flash'); mk.scrollIntoView({behavior:'smooth',block:'center'}); setTimeout(()=>mk.classList.remove('flash'),1100); } } }
  });

  // post
  const btn=document.getElementById('post-'+it.id);
  if(btn) btn.addEventListener('click', ()=>postNote(proj,sec,it));
  const nEl=document.getElementById('name-'+it.id), oEl=document.getElementById('nameother-'+it.id), bEl=document.getElementById('body-'+it.id);
  if(bEl) bEl.addEventListener('input', ()=>{ gateFor(it); mentionInput(it); });
  if(bEl) bEl.addEventListener('keyup', ()=>mentionInput(it));
  if(bEl) bEl.addEventListener('blur', ()=>{ setTimeout(()=>{ const mp=document.getElementById('mentionpop-'+it.id); if(mp){ mp.hidden=true; } }, 150); });
  const mp=document.getElementById('mentionpop-'+it.id);
  if(mp) mp.addEventListener('mousedown', (e)=>{ const b=e.target.closest('.mention-item'); if(b){ e.preventDefault(); pickMention(it, b.dataset.email, b.dataset.name); } });
  const shBtn=document.getElementById('share-'+it.id);
  if(shBtn) shBtn.addEventListener('click', (e)=>{ e.stopPropagation(); shareMenu(proj,sec,it); });
  const tg=document.getElementById('ntog-'+it.id); if(tg) tg.addEventListener('click', ()=>toggleNotes(it));
  loadNotes(proj,sec,it);
}

async function toggleRecord(it){
  const btn=document.getElementById('rec-'+it.id);
  const r=recorders[it.id];
  if(r && r.state==='recording'){ r.stop(); return; }
  if(!navigator.mediaDevices || !window.MediaRecorder){ alert('Voice recording is not supported in this browser. Try Chrome or a recent Safari.'); return; }
  try{
    const stream=await navigator.mediaDevices.getUserMedia({audio:true});
    const mr=new MediaRecorder(stream); const chunks=[];
    mr.ondataavailable=e=>{ if(e.data && e.data.size) chunks.push(e.data); };
    mr.onstop=()=>{
      stream.getTracks().forEach(t=>t.stop());
      const blob=new Blob(chunks, { type: mr.mimeType || 'audio/webm' });
      pendingAudio[it.id]=blob;
      const prev=document.getElementById('rec-prev-'+it.id);
      if(prev){ prev.innerHTML='<audio controls src="'+URL.createObjectURL(blob)+'"></audio><button class="rec-clear" id="rec-clear-'+it.id+'" type="button">remove</button>'; const rc=document.getElementById('rec-clear-'+it.id); if(rc) rc.addEventListener('click', ()=>{ pendingAudio[it.id]=null; prev.innerHTML=''; gateFor(it); }); }
      if(btn){ btn.classList.remove('recording'); btn.textContent='🎤 Record voice note'; }
      recorders[it.id]=null; gateFor(it);
    };
    recorders[it.id]=mr; mr.start();
    if(btn){ btn.classList.add('recording'); btn.textContent='■ Stop recording'; }
  }catch(e){ console.error(e); alert('Could not access the microphone — check that you allowed mic permission.'); }
}

async function uploadVoice(it){
  const blob=pendingAudio[it.id]; if(!blob) return null;
  const t=blob.type||''; const ext = t.indexOf('mp4')>-1?'mp4' : (t.indexOf('ogg')>-1?'ogg' : (t.indexOf('wav')>-1?'wav':'webm'));
  const path=CONFIG.REVIEW_SLUG+'/'+it.id+'/'+Date.now()+'.'+ext;
  const up=await sb.storage.from('review-voice').upload(path, blob, { contentType: blob.type||'audio/webm', upsert:false });
  if(up.error) throw up.error;
  const pub=sb.storage.from('review-voice').getPublicUrl(path);
  return pub.data.publicUrl;
}

function assetId(proj, sec, it){ return proj.id+':'+sec.id+':'+it.id; }

function toggleNotes(it){
  const box=document.getElementById('notes-'+it.id), btn=document.getElementById('ntog-'+it.id); if(!box) return;
  const collapsed=box.classList.toggle('collapsed');
  if(btn){ btn.textContent=collapsed?'Expand':'Collapse'; btn.setAttribute('aria-expanded', String(!collapsed)); }
  if(!collapsed){ box.classList.remove('fan'); void box.offsetWidth; box.classList.add('fan'); }
}
async function loadNotes(proj, sec, it){
  const box=document.getElementById('notes-'+it.id); if(!box) return;
  if(!AVA_LOADED){ try{ await loadAvatars(); }catch(e){} }
  try{
    const { data, error } = await sb.from('comments').select('*').eq('review_slug', CONFIG.REVIEW_SLUG).eq('asset_id', assetId(proj,sec,it)).order('created_at', { ascending:true });
    if(error) throw error;
    COMMENTS[it.id]=data;
    const ct=document.getElementById('count-'+it.id); if(ct) ct.textContent=data.length||'';
    // reactions (resilient: works even if comment_reactions table not created yet)
    REACTIONS[it.id]={};
    const ids=data.map(c=>c.id);
    if(ids.length){ try{ const rr=await sb.from('comment_reactions').select('*').in('comment_id', ids); if(!rr.error && rr.data){ rr.data.forEach(r=>{ const m=REACTIONS[it.id]; (m[r.comment_id]=m[r.comment_id]||{}); (m[r.comment_id][r.emoji]=m[r.comment_id][r.emoji]||[]).push({key:r.reactor_key,name:r.reactor_name||r.reactor_email||'Someone'}); }); } }catch(e){} }
    const pinned=data.filter(c=>c.pos_x!=null && c.pos_y!=null);
    const pinNum=new Map(); pinned.forEach((c,i)=>pinNum.set(c.id,i+1));
    if(!data.length){ box.innerHTML='<div class="empty">No notes yet. Add the first one below.</div>'; if(it.type==='image') renderPins(it, [], pinNum); return; }
    const mineSet=new Set(myComments());
    const children={}; const roots=[];
    data.forEach(c=>{ if(c.parent_id!=null && data.some(p=>p.id===c.parent_id)){ (children[c.parent_id]=children[c.parent_id]||[]).push(c); } else roots.push(c); });
    roots.reverse(); // newest top-level note first
    const numMap=new Map(); data.forEach((c,i)=>numMap.set(c.id,i+1));
    let html=''; roots.forEach(c=>{ html+=renderComment(it, c, 0, children, pinNum, mineSet, numMap, ''); });
    box.innerHTML=html;
    if(it.type==='image') renderPins(it, pinned, pinNum);
  }catch(e){
    console.error('load notes failed', e);
    box.innerHTML='<div class="empty">Could not load notes. Refresh the page to try again.</div>';
  }
}

function reactionBarHTML(it, c){
  const r=(REACTIONS[it.id] && REACTIONS[it.id][c.id]) || {};
  const a=getAuthor(it); const myKey=a.name ? (a.email||('name:'+a.name.toLowerCase())) : null;
  let chips='';
  Object.keys(r).forEach(em=>{ const arr=r[em]; const mine=myKey && arr.some(x=>x.key===myKey); const names=arr.map(x=>x.name).join(', '); chips+='<button type="button" class="react-chip'+(mine?' mine':'')+'" data-c="'+c.id+'" data-emoji="'+esc(em)+'" title="'+esc(names)+'">'+em+'<span class="rc-n">'+arr.length+'</span></button>'; });
  chips+='<button type="button" class="react-add" data-c="'+c.id+'" title="Add reaction" aria-label="Add reaction">'+svgIcon('smile')+'</button>';
  return '<div class="react-bar" data-c="'+c.id+'">'+chips+'</div>';
}

function renderComment(it, c, depth, children, pinNum, mineSet, numMap, parentName){
  const secs=parseTimecode(c.timecode);
  const canSeek=secs!=null && players[it.id];
  const tc=c.timecode ? '<button class="tc '+(canSeek?'':'static')+'" '+(canSeek?'data-sec="'+secs+'"':'disabled')+'>'+esc(c.timecode)+'</button>' : '';
  const del=(ADMIN || mineSet.has(c.id)) ? '<button class="note-del" title="Delete note" data-c="'+c.id+'">\u00d7</button>' : '';
  const pin=pinNum.has(c.id) ? '<button class="pin-badge" data-c="'+c.id+'" title="Show on image">'+pinNum.get(c.id)+'</button>' : '';
  const audio=c.audio_url ? '<audio controls preload="none" src="'+esc(c.audio_url)+'"></audio>' : '';
  const bodyHtml=c.body ? '<div class="note-body">'+mentionHighlight(c.body)+'</div>' : '';
  const bridge=(depth>0 && parentName) ? '<div class="reply-bridge">'+svgIcon('reply')+'<span>replying to '+esc(parentName)+'</span></div>' : '';
  const react=reactionBarHTML(it,c);
  const actions='<div class="note-actions"><button type="button" class="note-act reply-btn" data-c="'+c.id+'" title="Reply" aria-label="Reply">'+svgIcon('reply')+'</button><span class="note-num">#'+numMap.get(c.id)+'</span></div>';
  const head='<div class="note-head">'+pin+'<span class="note-name'+((ADMIN&&c.author_email)?' has-email':'')+'"'+((ADMIN&&c.author_email)?' title="'+esc(c.author_email)+'"':'')+'>'+esc(c.author_name||'Anonymous')+'</span>'+tc+'<span class="note-time" title="'+esc(fmtTime(c.created_at))+'">'+esc(relTime(c.created_at))+'</span>'+del+'</div>';
  let kids='';
  (children[c.id]||[]).forEach(k=>{ kids+=renderComment(it, k, depth+1, children, pinNum, mineSet, numMap, c.author_name); });
  const avUrl=c.author_avatar||avatarFor(c.author_email)||'';
  const avaEl=avUrl
    ? '<div class="ava" style="background-image:url('+esc(avUrl)+');background-size:cover;background-position:center;color:transparent"></div>'
    : '<div class="ava">'+esc((c.author_name||'?').trim().charAt(0)||'?')+'</div>';
  return '<div class="note'+(depth>0?' is-reply':'')+'" id="note-'+it.id+'-'+c.id+'">'
    + bridge
    + '<div class="note-row">'+avaEl+'<div class="note-main">'+head+bodyHtml+audio+react+actions+'</div></div>'
    + (kids?'<div class="reply-thread">'+kids+'</div>':'')
    + '</div>';
}

function renderPins(it, pinned, pinNum){
  const layer=document.getElementById('pinlayer-'+it.id); if(!layer) return;
  let html=pinned.map(c=>'<button class="pin-marker" data-c="'+c.id+'" style="left:'+c.pos_x+'%;top:'+c.pos_y+'%;">'+pinNum.get(c.id)+'</button>').join('');
  if(pendingPin[it.id]) html+='<span class="pin-marker pending" style="left:'+pendingPin[it.id].x+'%;top:'+pendingPin[it.id].y+'%;">+</span>';
  layer.innerHTML=html;
  layer.querySelectorAll('.pin-marker[data-c]').forEach(m=>m.addEventListener('click', (e)=>{
    e.stopPropagation();
    const note=document.getElementById('note-'+it.id+'-'+m.dataset.c);
    if(note){ note.scrollIntoView({behavior:'smooth',block:'center'}); note.classList.add('flash'); setTimeout(()=>note.classList.remove('flash'),1200); }
  }));
}

async function postNote(proj, sec, it){
  const tcEl=document.getElementById('tc-'+it.id), bodyEl=document.getElementById('body-'+it.id);
  const msg=document.getElementById('msg-'+it.id), btn=document.getElementById('post-'+it.id);
  const a=getAuthor(it); const tc=(tcEl?tcEl.value:'').trim(), body=(bodyEl.value||'').trim();
  msg.className='msg'; msg.textContent='';
  if(!a.name){ msg.className='msg err'; msg.textContent='Please log in to post.'; return; }
  if(!body && !pendingAudio[it.id]){ msg.className='msg err'; msg.textContent='Write a note or record a voice note.'; bodyEl.focus(); return; }
  btn.disabled=true; btn.textContent='Posting…';
  try{
    let audio_url=null;
    if(pendingAudio[it.id]){ audio_url=await uploadVoice(it); }
    const pin=pendingPin[it.id];
    const preview=previewFor(it, parseTimecode(tc));
    const row={ review_slug:CONFIG.REVIEW_SLUG, asset_id:assetId(proj,sec,it), author_name:a.name, timecode:tc||null, body:body||null };
    if(a.email) row.author_email=a.email;
    // commenter's avatar — the signed-in person's own avatar
    var _av=(AUTH.profile && AUTH.profile.avatar_url) || (a.email?avatarFor(a.email):'') || '';
    if(_av) row.author_avatar=_av;
    if(audio_url) row.audio_url=audio_url;
    if(pin){ row.pos_x=pin.x; row.pos_y=pin.y; }
    if(preview) row.preview_url=preview;
    const mentions=collectMentions(it);
    const rt=replyTo[it.id];
    let notify=mentions.slice();
    if(rt && rt.author_email) notify.push((rt.author_email||'').toLowerCase());
    const meEmail=(a.email||'').toLowerCase();
    row.notify_emails=[...new Set(notify)].filter(e=>e && e!==meEmail);
    if(rt && rt.id!=null) row.parent_id=rt.id;
    const { data:ins, error } = await sb.from('comments').insert(row).select();
    if(error) throw error;
    if(ins && ins[0] && ins[0].id) addMine(ins[0].id);
    bodyEl.value=''; if(tcEl) tcEl.value='';
    pendingAudio[it.id]=null; pendingPin[it.id]=null; pinMode[it.id]=false;
    mentionState[it.id]=null; clearReply(it);
    const prev=document.getElementById('rec-prev-'+it.id); if(prev) prev.innerHTML='';
    const pinBtn=document.getElementById('pin-'+it.id); if(pinBtn) pinBtn.classList.remove('active');
    const layer=document.getElementById('pinlayer-'+it.id); if(layer) layer.classList.remove('arming');
    const ind=document.getElementById('pin-ind-'+it.id); if(ind) ind.textContent='';
    await loadNotes(proj,sec,it);
    msg.className='msg'; msg.textContent='Posted.'; setTimeout(()=>{ msg.textContent=''; },2500);
  }catch(e){
    console.error('post failed', e);
    const m=(e && (e.message||e.error||'')+'').toLowerCase();
    if(m.includes('bucket') || m.includes('storage') || m.includes('row-level')) { msg.className='msg err'; msg.textContent='Voice upload failed — run comments-upgrade.sql so the review-voice bucket exists.'; }
    else if(m.includes('column') || m.includes('audio_url') || m.includes('pos_x')) { msg.className='msg err'; msg.textContent='Run comments-upgrade.sql first (new columns needed for voice/pins).'; }
    else { msg.className='msg err'; msg.textContent='Could not post that note. Check your connection and try again.'; }
  }finally{ btn.disabled=false; btn.textContent='Post note'; gateFor(it); }
}

async function deleteNote(itemId, commentId){
  if(!confirm('Delete this note? This cannot be undone.')) return;
  try{
    const { data, error } = await sb.from('comments').delete().eq('id', commentId).select();
    if(error) throw error;
    if(!data || data.length===0){ alert('Delete was blocked by the database. Run comments-upgrade.sql in Supabase (the delete policy is missing).'); return; }
    dropMine(commentId);
    const ctx=findItem(itemId); if(ctx) loadNotes(ctx.proj, ctx.sec, ctx.it);
  }catch(e){ console.error('delete failed', e); alert('Could not delete that note. '+((e&&e.message)||'')); }
}

function adminStrip(proj, sec){
  return '<div class="admin-strip"><span class="admin-tag">Admin</span><input id="ann-msg-'+sec.id+'" class="admin-input" placeholder="Optional message — e.g. \'New work is up for review\'"><button class="admin-btn" id="ann-btn-'+sec.id+'">Notify Team</button><span class="admin-msg" id="ann-status-'+sec.id+'"></span></div>';
}
async function announce(projId, secId){
  const proj=CONFIG.PROJECTS.find(p=>p.id===projId); if(!proj) return;
  const sec=proj.sections.find(s=>s.id===secId); if(!sec) return;
  const btn=document.getElementById('ann-btn-'+secId), st=document.getElementById('ann-status-'+secId), inp=document.getElementById('ann-msg-'+secId);
  const message=((inp&&inp.value)||'').trim();
  btn.disabled=true; const orig=btn.textContent; btn.textContent='Sending\u2026'; st.className='admin-msg'; st.textContent='';
  try{
    try{ await sb.from('announcements').insert({ review_slug:CONFIG.REVIEW_SLUG, project:proj.id, section:sec.id, message:message||null }); }catch(e){}
    if(!INVITES.length) await loadInvites();
    var own={}; (CONFIG.OWNER_LOGINS||[]).forEach(function(e){ own[String(e).toLowerCase()]=1; }); own[String(OWNER_EMAIL).toLowerCase()]=1;
    var recips=(INVITES||[]).filter(function(p){ return p.email && (!p.project_keys || !p.project_keys.length || p.project_keys.indexOf(proj.id)>=0); }).map(function(p){ return p.email; });
    recips=[...new Set(recips)].filter(function(e){ return e && !own[e.toLowerCase()]; });
    if(recips.length){
      var link='https://supernerd.tv/r/'+CONFIG.REVIEW_SLUG+'/#p='+encodeURIComponent(proj.id)+'&s='+encodeURIComponent(sec.id);
      var inner='<p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#c9ccd1;">New work is ready for you to review in <b style="color:#fff;">'+esc(proj.title)+' \u2014 '+esc(sec.name)+'</b>.</p>'
        +(message?'<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#c9ccd1;">'+esc(message)+'</p>':'')
        +'<a href="'+link+'" style="display:inline-block;background:#BAC01E;color:#0a0b0d;font-weight:700;font-size:14px;text-decoration:none;padding:11px 20px;border-radius:9px;">Open the review \u2192</a>';
      await sendEmail({ to:[OWNER_EMAIL], bcc:recips, subject:'New work is ready \u00b7 '+proj.title+' \u2014 '+sec.name, html:emailShell('New work is ready to review', inner), replyTo:OWNER_EMAIL });
      if(inp) inp.value=''; st.className='admin-msg ok'; st.textContent='Team emailed ('+recips.length+').'; setTimeout(()=>{ if(st) st.textContent=''; },3500);
    } else {
      if(inp) inp.value=''; st.className='admin-msg ok'; st.textContent='Posted \u2014 no partners to email yet.'; setTimeout(()=>{ if(st) st.textContent=''; },3500);
    }
  }catch(e){ console.error('notify failed', e); st.className='admin-msg err'; st.textContent='Could not send: '+(e.message||'try again'); }
  finally{ btn.disabled=false; btn.textContent=orig; }
}

