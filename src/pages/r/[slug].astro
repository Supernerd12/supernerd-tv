function calNav(dir){ var d=CAL.cursor;
  if(CAL.view==='month') CAL.cursor=new Date(d.getFullYear(),d.getMonth()+dir,1);
  else if(CAL.view==='week'){ CAL.cursor=new Date(d); CAL.cursor.setDate(d.getDate()+7*dir); }
  else { var b=CAL.day||CAL.cursor; var n=new Date(b); n.setDate(b.getDate()+dir); CAL.day=n; CAL.cursor=n; }
  calRender();
}
function calPopEl(){ var p=document.getElementById('calpop'); if(!p){ p=document.createElement('div'); p.id='calpop'; p.className='cal-pop'; document.body.appendChild(p); } return p; }
