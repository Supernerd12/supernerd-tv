  var m=document.getElementById('fdmount'); if(m) m.innerHTML='<div class="cal-loading">Loading\u2026</div>';
  try{ var rf=await sb.from('final_folders').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',projId).order('ord',{ascending:true}).order('created_at',{ascending:true}); if(rf&&rf.data) FD.folders=rf.data; }catch(e){}
