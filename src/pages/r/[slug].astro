      ov.remove(); deckLoad(projKey);
    }catch(e){ console.error('save deck failed', e); msg.className='msg err'; msg.textContent='Could not save — run presentations.sql and sign in as owner.'; btn.disabled=false; btn.textContent='Save'; }
