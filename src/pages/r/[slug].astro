  var linkBtn=document.getElementById('caLinkBtn'), form=document.getElementById('caLinkForm');
  if(linkBtn&&form){ linkBtn.onclick=function(){ form.hidden=!form.hidden; if(!form.hidden){ var l=document.getElementById('caLkLabel'); if(l) l.focus(); } };
    var cancel=document.getElementById('caLkCancel'); if(cancel) cancel.onclick=function(){ form.hidden=true; };
    var save=document.getElementById('caLkSave'); if(save) save.onclick=async function(){ var url=(document.getElementById('caLkUrl').value||'').trim(); if(!url){ return; } if(!/^https?:\/\//i.test(url)) url='https://'+url; var label=(document.getElementById('caLkLabel').value||'').trim(); var note=(document.getElementById('caLkNote').value||'').trim(); save.disabled=true; var row={ review_slug:CONFIG.REVIEW_SLUG, project_key:CA.proj, category:cat.k, kind:'link', name:label||url, note:note, url:url, created_by:myEmail() }; try{ var r=await sb.from('client_assets').insert(row).select().single(); if(r.error){ alert('Could not add: '+r.error.message); save.disabled=false; return; } CA.items.push(r.data); caRender(); }catch(e){ alert('Could not add link.'); save.disabled=false; } };
  }
  host.querySelectorAll('.ca-del').forEach(function(b){ b.onclick=function(e){ e.preventDefault(); e.stopPropagation(); caDelete(b.dataset.del); }; });
