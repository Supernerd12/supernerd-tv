   +'<div><label class="cev-l">Style</label><select id="cevKind" class="cev-in"><option value="major"'+((e.kind||'major')==='major'?' selected':'')+'>Full-day block</option><option value="meeting"'+(e.kind==='meeting'?' selected':'')+'>Meeting \u00b7 small</option></select></div></div>'
   +'<label class="cev-l">Project \u00b7 optional</label><input id="cevProj" class="cev-in" value="'+esc(e.proj&&e.proj!=='project'?e.proj:(CAL.projId||''))+'" placeholder="'+esc(CAL.projId||'project')+'">'
   +'<label class="cev-l">Notes \u00b7 optional</label><textarea id="cevNotes" class="cev-in cev-area" placeholder="Anything to add">'+esc(e.notes||'')+'</textarea>'
   +'<div class="cev-foot">'+(ev?'<button type="button" class="cev-del" data-cevdel>Delete</button>':'<span></span>')+'<div class="cev-actions"><button type="button" class="cev-cancel" data-cevx>Cancel</button><button type="button" class="cev-save" data-cevsave>'+(ev?'Save':'Add event')+'</button></div></div>'
