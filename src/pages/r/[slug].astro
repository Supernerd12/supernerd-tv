<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Supernerd — Review</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style is:global>

  :root{
    --ink:#050505; --panel:#0c0c0c; --green:#BAC01E; --green-hi:#D6DC3A;
    --bone:#ECECEA; --dim:rgba(236,236,234,.55); --line:rgba(236,236,234,.13);
    --disp:'Bricolage Grotesque',system-ui,sans-serif; --mono:'Space Mono',ui-monospace,monospace;
    --ease:cubic-bezier(.2,.7,.2,1);
  }
  *{box-sizing:border-box}
  html,body{margin:0; background:var(--ink); color:var(--bone)}
  body{font-family:var(--disp); -webkit-font-smoothing:antialiased; line-height:1.5}
  a{color:inherit; text-decoration:none}
  .wrap{max-width:1140px; margin:0 auto; padding:0 24px}
  .eyebrow{font-family:var(--mono); font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--green)}

  /* ---- header ---- */
  header{border-bottom:1px solid var(--line); padding:20px 0; position:sticky; top:0; background:rgba(5,5,5,.86); backdrop-filter:blur(10px); z-index:20}
  .head-row{display:flex; align-items:center; gap:16px}
  .logo{font-weight:800; letter-spacing:-.02em; font-size:19px; color:var(--green); white-space:nowrap; cursor:pointer}
  .logo b{color:var(--bone)}
  .cobrand{height:28px; width:auto; max-width:150px; object-fit:contain}
  .head-meta{margin-left:auto; text-align:right}
  .head-meta .co{font-size:14px; font-weight:600}

  /* ---- landing ---- */
  .landing{padding:60px 0 40px}
  .landing .co-name{font-size:clamp(34px,6vw,68px); font-weight:800; letter-spacing:-.03em; line-height:1; margin:10px 0 0}
  .landing .lead{color:var(--dim); margin:16px 0 48px; font-size:15px; max-width:56ch}
  .grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:18px}
  .card{display:block; border:1px solid var(--line); border-radius:10px; padding:24px; background:var(--panel); transition:border-color .18s var(--ease), transform .18s var(--ease)}
  .card:hover{border-color:rgba(186,192,30,.5); transform:translateY(-2px)}
  .card .c-eye{font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--dim)}
  .card h3{font-size:24px; font-weight:700; letter-spacing:-.02em; margin:12px 0 6px}
  .card .c-tag{color:var(--dim); font-size:14px}
  .card .c-foot{margin-top:22px; display:flex; align-items:center; justify-content:space-between}
  .card .c-count{font-family:var(--mono); font-size:12px; color:var(--dim)}
  .card .c-go{font-family:var(--mono); font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--green)}

  /* ---- project view ---- */
  .pv{display:grid; grid-template-columns:228px 1fr; gap:44px; padding:40px 0 0; align-items:start}
  .side{position:sticky; top:86px}
  .side .back{font-family:var(--mono); font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:var(--dim); display:inline-block; margin-bottom:18px}
  .side .back:hover{color:var(--green)}
  .side .pv-title{font-size:22px; font-weight:700; letter-spacing:-.02em; margin:0 0 20px; line-height:1.1}
  .nav{display:flex; flex-direction:column; gap:2px}
  .nav a{display:flex; align-items:baseline; gap:10px; padding:11px 12px; border-radius:7px; transition:background .15s var(--ease)}
  .nav a .n-num{font-family:var(--mono); font-size:11px; color:var(--dim)}
  .nav a .n-name{font-size:14.5px; font-weight:600}
  .nav a .n-ct{margin-left:auto; font-family:var(--mono); font-size:11px; color:var(--dim)}
  .nav a:hover{background:rgba(236,236,234,.05)}
  .nav a.active{background:rgba(186,192,30,.12)}
  .nav a.active .n-name{color:var(--green-hi)}
  .nav a.active .n-num{color:var(--green)}

  .main-head{margin-bottom:8px}
  .main-head h2{font-size:clamp(24px,4vw,38px); font-weight:800; letter-spacing:-.03em; margin:6px 0 0}

  /* ---- deliverable ---- */
  .deliv{padding:34px 0; border-top:1px solid var(--line)}
  .deliv:first-of-type{border-top:none; padding-top:22px}
  .deliv-head{display:flex; align-items:center; gap:12px; margin-bottom:15px; flex-wrap:wrap}
  .deliv-title{font-size:20px; font-weight:700; letter-spacing:-.02em}
  .deliv-ver{font-family:var(--mono); font-size:11px; color:var(--green-hi); border:1px solid rgba(186,192,30,.35); padding:2px 8px; border-radius:4px}
  .deliv-kind{font-family:var(--mono); font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink); background:var(--green); padding:3px 8px; border-radius:3px}

  .stage{position:relative; width:100%; aspect-ratio:16/9; max-height:62vh; background:#000; border-radius:8px; overflow:hidden; border:1px solid var(--line)}
  .stage iframe{position:absolute; inset:0; width:100%; height:100%; border:0}
  .stage.is-image{aspect-ratio:auto; max-height:none}
  .stage.is-image img{width:100%; height:auto; display:block; object-fit:contain}
  .ph{position:absolute; inset:0; display:flex; align-items:center; justify-content:center; text-align:center; padding:24px; color:var(--dim); font-family:var(--mono); font-size:13px; border:1px dashed var(--line); border-radius:8px}
  .is-image .ph{position:static; min-height:220px}

  .sec-empty{color:var(--dim); font-size:15px; padding:30px 0; font-family:var(--mono)}

  /* ---- notes ---- */
  .notes{margin-top:20px}
  .notes-bar{display:flex; align-items:center; gap:10px; margin-bottom:12px}
  .notes-bar h3{font-size:12px; font-family:var(--mono); letter-spacing:.14em; text-transform:uppercase; color:var(--dim); margin:0; font-weight:400}
  .count{font-family:var(--mono); font-size:12px; color:var(--green)}
  .note{display:flex; gap:12px; padding:13px 0; border-top:1px solid var(--line)}
  .note:first-child{border-top:none}
  .ava{flex:0 0 30px; height:30px; border-radius:50%; background:rgba(186,192,30,.16); color:var(--green); display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:12px; text-transform:uppercase}
  .note-main{flex:1; min-width:0}
  .note-head{display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:3px}
  .note-name{font-weight:600; font-size:14px}
  .tc{font-family:var(--mono); font-size:12px; color:var(--green-hi); background:rgba(186,192,30,.12); border:1px solid rgba(186,192,30,.3); padding:1px 7px; border-radius:4px; cursor:pointer}
  .tc:hover{background:rgba(186,192,30,.22)}
  .tc.static{cursor:default; color:var(--dim); border-color:var(--line); background:transparent}
  .note-time{font-family:var(--mono); font-size:11px; color:var(--dim); margin-left:auto}
  .note-body{font-size:14.5px; color:var(--bone); white-space:pre-wrap; word-wrap:break-word; line-height:1.55}
  .empty{color:var(--dim); font-size:14px; padding:6px 0 2px}

  /* ---- composer ---- */
  .composer{margin-top:16px; border:1px solid var(--line); border-radius:8px; padding:14px; background:var(--panel)}
  .composer .row{display:flex; gap:10px; margin-bottom:10px; flex-wrap:wrap}
  .field{display:flex; flex-direction:column; gap:5px}
  .field label{font-family:var(--mono); font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:var(--dim)}
  .composer input, .composer textarea{font-family:var(--disp); font-size:14.5px; color:var(--bone); background:#000; border:1px solid var(--line); border-radius:6px; padding:9px 11px; width:100%}
  .composer input::placeholder, .composer textarea::placeholder{color:rgba(236,236,234,.32)}
  .composer .f-name{width:220px}
  .composer .f-tc{width:120px}
  .composer .f-tc input{font-family:var(--mono)}
  .composer textarea{min-height:72px; resize:vertical; line-height:1.5}
  .composer:focus-within{border-color:rgba(186,192,30,.4)}
  input:focus-visible, textarea:focus-visible, button:focus-visible, .tc:focus-visible, .card:focus-visible, .nav a:focus-visible{outline:2px solid var(--green); outline-offset:2px}
  .composer-foot{display:flex; align-items:center; gap:14px; margin-top:10px}
  .post{font-family:var(--mono); font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink); background:var(--green); border:none; padding:10px 20px; border-radius:6px; cursor:pointer; font-weight:700; transition:background .15s var(--ease)}
  .post:hover{background:var(--green-hi)}
  .post:disabled{opacity:.5; cursor:default}
  .msg{font-size:13px; color:var(--dim)}
  .msg.err{color:#e8806b}

  footer{border-top:1px solid var(--line); margin-top:60px; padding:28px 0 56px; text-align:center}
  footer .mk{font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--dim)}
  footer .mk b{color:var(--green); font-weight:700}

  @media (max-width:760px){
    .pv{grid-template-columns:1fr; gap:22px}
    .side{position:static; top:auto}
    .side .pv-title{margin-bottom:14px}
    .nav{flex-direction:row; overflow-x:auto; gap:6px; padding-bottom:6px; -webkit-overflow-scrolling:touch}
    .nav a{flex:0 0 auto; white-space:nowrap}
    .nav a .n-ct{display:none}
    .composer .f-name{width:100%}
  }
  @media (prefers-reduced-motion:reduce){ *{transition:none!important; animation:none!important} }
  .logo-link{display:inline-flex; align-items:center}
  .logo-img{height:30px; width:auto; display:block}
  .co{cursor:pointer; transition:color .15s var(--ease)}
  .co:hover{color:var(--green)}
  footer a.mk:hover b{color:var(--green-hi)}
  .admin-strip{display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:4px 0 24px; padding:12px 14px; border:1px dashed rgba(186,192,30,.45); border-radius:8px; background:rgba(186,192,30,.05)}
  .admin-tag{font-family:var(--mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--ink); background:var(--green); padding:3px 8px; border-radius:3px}
  .admin-input{flex:1; min-width:200px; font-family:var(--disp); font-size:14px; color:var(--bone); background:#000; border:1px solid var(--line); border-radius:6px; padding:8px 11px}
  .admin-input::placeholder{color:rgba(236,236,234,.32)}
  .admin-btn{font-family:var(--mono); font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink); background:var(--green); border:none; padding:9px 16px; border-radius:6px; cursor:pointer; font-weight:700}
  .admin-btn:hover{background:var(--green-hi)}
  .admin-btn:disabled{opacity:.5; cursor:default}
  .admin-msg{font-size:12px; color:var(--dim)}
  .admin-msg.ok{color:var(--green)} .admin-msg.err{color:#e8806b}

  /* ---------- v2 additions ---------- */
  .deliv-date{font-family:var(--mono); font-size:11px; color:var(--dim); margin-left:auto}
  .dl-bar{margin-top:12px}
  .dl-btn{display:inline-flex; align-items:center; gap:8px; font-family:var(--mono); font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--green-hi); background:rgba(186,192,30,.08); border:1px solid rgba(186,192,30,.45); border-radius:7px; padding:10px 18px; transition:background .15s var(--ease), color .15s var(--ease)}
  .dl-btn:hover{background:var(--green); color:var(--ink)}
  .stage.is-image img{cursor:zoom-in}
  .stage.is-audio{aspect-ratio:auto; max-height:none; min-height:0; padding:18px; display:flex; align-items:center}
  .stage.is-audio audio{width:100%}
  .stage.is-file{aspect-ratio:auto; max-height:none}
  .file-card{display:flex; align-items:center; gap:14px; padding:22px}
  .file-ic{font-family:var(--mono); font-size:22px; color:var(--green)}
  .file-name{font-size:16px; font-weight:600}

  .archive{margin:0 0 26px}
  .archive-toggle{display:inline-flex; align-items:center; gap:8px; font-family:var(--mono); font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:var(--dim); background:none; border:1px solid var(--line); border-radius:7px; padding:9px 14px; cursor:pointer; transition:color .15s var(--ease), border-color .15s var(--ease)}
  .archive-toggle:hover{color:var(--green); border-color:rgba(186,192,30,.4)}
  .archive-toggle .ar-ic{color:var(--green)}
  .archive-toggle .ar-caret{transition:transform .15s var(--ease)}
  .archive.open .archive-toggle .ar-caret{transform:rotate(180deg)}
  .archive-row{display:none; gap:12px; overflow-x:auto; padding:16px 2px 6px; -webkit-overflow-scrolling:touch}
  .archive.open .archive-row{display:flex}
  .ar-card{flex:0 0 158px; text-align:left; background:var(--panel); border:1px solid var(--line); border-radius:9px; overflow:hidden; cursor:pointer; padding:0; transition:border-color .15s var(--ease), transform .15s var(--ease)}
  .ar-card:hover{border-color:rgba(186,192,30,.5); transform:translateY(-2px)}
  .ar-thumb{width:100%; aspect-ratio:16/10; background:#000; display:flex; align-items:center; justify-content:center; overflow:hidden}
  .ar-thumb img{width:100%; height:100%; object-fit:cover}
