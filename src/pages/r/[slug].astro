  .pin-badge{display:inline-flex; align-items:center; justify-content:center; min-width:19px; height:19px; padding:0 5px; border-radius:10px; background:var(--green); color:var(--ink); font-family:var(--mono); font-size:11px; font-weight:700; border:none; cursor:pointer; margin-right:7px}
  .note.flash{outline:2px solid var(--green); outline-offset:3px; border-radius:8px}
  .onboard{border:1px solid rgba(186,192,30,.25); border-radius:14px; padding:20px 22px; margin:0 0 30px; background:rgba(186,192,30,.04)}
  .ob-head{display:flex; align-items:center; gap:10px}
  .ob-head h3{margin:0; font-family:var(--disp); font-size:18px; color:var(--bone); letter-spacing:-.01em}
  .ob-sub{color:var(--dim); font-size:13px; margin:8px 0 14px}
  .ob-row{margin:8px 0}
  .ob-input{width:100%; box-sizing:border-box; background:#0c0c0c; border:1px solid var(--line); border-radius:8px; color:var(--bone); font-family:var(--mono); font-size:13px; padding:10px 12px}
  .ob-input:focus{outline:none; border-color:rgba(186,192,30,.55)}
  .ob-area{min-height:84px; resize:vertical}
  .ob-foot{display:flex; align-items:center; gap:12px; margin-top:8px; flex-wrap:wrap}
  .notify-box{margin:6px 0 2px; padding:12px 14px; border:1px solid rgba(186,192,30,.22); border-radius:10px; background:rgba(186,192,30,.04)}
  .notify-empty{font-family:var(--mono); font-size:11px; color:var(--dim); line-height:1.5}
  .notify-head{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:8px}
  .notify-title{font-family:var(--mono); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--dim)}
  .notify-all{font-family:var(--mono); font-size:11px; color:var(--green); background:none; border:none; cursor:pointer; text-decoration:underline}
  .notify-list{display:flex; flex-wrap:wrap; gap:7px}
