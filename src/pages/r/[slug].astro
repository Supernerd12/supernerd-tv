.pd-av{width:84px;height:84px;border-radius:18px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:30px;color:#0b0c0d;background-size:cover;background-position:center;box-shadow:inset 0 0 0 2px rgba(255,255,255,.08)}
.pd-top{display:flex;align-items:center;gap:16px;margin-bottom:4px}
.pd-id{min-width:0}
