/* ---------- GIF maker (Cloudflare Stream animated thumbnails) ---------- */
function gifMaker(proj,sec,it){
  if(!(it.type==='video'&&it.stream_uid)) return;
  var base='https://'+CONFIG.STREAM_CUSTOMER+'/'+it.stream_uid+'/thumbnails/thumbnail';
  var GM={ fps:24, a:0, b:48, out:15, scale:0.5, nativeH:1080, nativeW:1920 };
  function tOf(frame){ return Math.max(0, frame)/Math.max(1,GM.fps); }
  function durF(){ return Math.max(0, GM.b-GM.a); }
  function durS(){ return durF()/Math.max(1,GM.fps); }
  function outH(){ return Math.max(20, Math.round(GM.nativeH*GM.scale)); }
  function outW(){ return Math.round(GM.nativeW*GM.scale); }
  function stillURL(frame){ return base+'.jpg?time='+tOf(frame).toFixed(3)+'s&height=150'; }
  function gifURL(){ return base+'.gif?time='+tOf(GM.a).toFixed(3)+'s&duration='+durS().toFixed(3)+'s&height='+outH()+'&fps='+GM.out+'&fit=crop'; }
  var scales=[0.25,0.5,0.75,1], fpses=[8,12,15,24,30];
  function frameCtrl(which){ return '<div class="gm-pcol"><span class="gm-plab">'+(which==='a'?'Start':'End')+' frame</span><div class="gm-pimg" id="gmImg_'+which+'"></div>'
    +'<div class="gm-fnudge"><button class="gm-nudge" data-nud="'+which+'" data-d="-10">\u201310</button><button class="gm-nudge" data-nud="'+which+'" data-d="-1">\u20131</button>'
    +'<input id="gmF_'+which+'" type="number" step="1" min="0" value="'+(which==='a'?GM.a:GM.b)+'">'
    +'<button class="gm-nudge" data-nud="'+which+'" data-d="1">+1</button><button class="gm-nudge" data-nud="'+which+'" data-d="10">+10</button></div></div>'; }
  var html='<div class="gm-wrap"><div class="gm-head">GIF maker \u00b7 <b>'+esc(it.version?(itemTitle(it)+' '+it.version):itemTitle(it))+'</b></div>'
    +'<div class="gm-hint">Step through by frame. Looping clip pulled straight from the video \u2014 no re-upload, generated on Cloudflare.</div>'
    +'<div class="gm-row"><span class="gm-rlab">Source fps</span><input id="gmSrcFps" class="gm-fps-in" type="number" step="1" min="1" value="24"><span class="gm-rsub">how many frames = one second in this video</span></div>'
    +'<div class="gm-prev">'+frameCtrl('a')+frameCtrl('b')+'</div>'
    +'<div class="gm-row"><span class="gm-rlab">Size</span><div class="gm-opts" id="gmScale">'+scales.map(function(s){ return '<button class="gm-opt'+(s===GM.scale?' on':'')+'" data-s="'+s+'">'+s+'\u00d7<i id="gmpx-'+String(s).replace('.','_')+'"></i></button>'; }).join('')+'</div></div>'
    +'<div class="gm-row"><span class="gm-rlab">Smoothness</span><div class="gm-opts" id="gmFps">'+fpses.map(function(f){ return '<button class="gm-opt'+(f===GM.out?' on':'')+'" data-f="'+f+'">'+f+' fps</button>'; }).join('')+'</div></div>'
    +'<div class="gm-foot"><div class="gm-meta" id="gmMeta"></div><button class="ca-btn" id="gmGo" type="button">Generate GIF</button></div>'
    +'<div class="gm-out" id="gmOut"></div></div>';
  openOverlay(html, true);
  var $=function(id){ return document.getElementById(id); };
  function clampF(){ GM.a=Math.max(0,Math.round(+$('gmF_a').value||0)); GM.b=Math.max(0,Math.round(+$('gmF_b').value||0)); if(GM.b<GM.a){ GM.b=GM.a; $('gmF_b').value=GM.b; } }
  function paintPrev(){ $('gmImg_a').style.backgroundImage='url('+stillURL(GM.a)+')'; $('gmImg_b').style.backgroundImage='url('+stillURL(GM.b)+')'; }
  function paintSize(){ scales.forEach(function(s){ var el=$('gmpx-'+String(s).replace('.','_')); if(el) el.textContent=Math.round(GM.nativeH*s)+'p'; }); }
  function paintMeta(){ var f=durF(), d=durS(); var warn=d>15?' \u00b7 long clip \u2014 file will be large':(f<=0?' \u00b7 end must be after start':''); $('gmMeta').innerHTML='Clip: <b>'+f+' frame'+(f===1?'':'s')+'</b> \u00b7 '+d.toFixed(2)+'s \u00b7 '+outW()+'\u00d7'+outH()+' \u00b7 '+GM.out+' fps out'+(warn?'<span class="gm-warn">'+warn+'</span>':''); $('gmGo').disabled=(f<=0); }
  function refresh(){ paintPrev(); paintSize(); paintMeta(); }
  var probe=new Image(); probe.onload=function(){ if(probe.naturalHeight){ GM.nativeH=probe.naturalHeight; GM.nativeW=probe.naturalWidth; paintSize(); paintMeta(); } }; probe.src=base+'.jpg';
  $('gmSrcFps').oninput=function(){ GM.fps=Math.max(1,Math.round(+$('gmSrcFps').value||24)); refresh(); };
  $('gmF_a').oninput=function(){ clampF(); refresh(); };
  $('gmF_b').oninput=function(){ clampF(); refresh(); };
  document.querySelectorAll('.gm-nudge').forEach(function(b){ b.onclick=function(){ var k=b.dataset.nud, d=+b.dataset.d; if(k==='a'){ GM.a=Math.max(0,GM.a+d); if(GM.b<GM.a) GM.b=GM.a; } else { GM.b=Math.max(GM.a,GM.b+d); } $('gmF_a').value=GM.a; $('gmF_b').value=GM.b; refresh(); }; });
  document.querySelectorAll('#gmScale .gm-opt').forEach(function(b){ b.onclick=function(){ GM.scale=+b.dataset.s; document.querySelectorAll('#gmScale .gm-opt').forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); paintMeta(); }; });
  document.querySelectorAll('#gmFps .gm-opt').forEach(function(b){ b.onclick=function(){ GM.out=+b.dataset.f; document.querySelectorAll('#gmFps .gm-opt').forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); paintMeta(); }; });
  $('gmGo').onclick=function(){ var url=gifURL(); $('gmOut').innerHTML='<div class="gm-render">Rendering on Cloudflare\u2026 first build of a new clip can take a few seconds.</div><img class="gm-gif" src="'+esc(url)+'" alt="GIF preview" onload="var r=this.parentNode.querySelector(\'.gm-render\');if(r)r.remove()"><div class="gm-actions"><button class="ca-btn" id="gmDl" type="button">Download .gif</button><button class="ca-btn ghost" id="gmCopy" type="button">Copy URL</button></div>'; var dl=$('gmDl'); if(dl) dl.onclick=function(){ gmDownload(url); }; var cp=$('gmCopy'); if(cp) cp.onclick=function(){ try{ navigator.clipboard.writeText(url); cp.textContent='Copied \u2713'; setTimeout(function(){cp.textContent='Copy URL';},1500); }catch(e){} }; };
  refresh();
}
async function gmDownload(url){ try{ var r=await fetch(url); var b=await r.blob(); var u=URL.createObjectURL(b); var a=document.createElement('a'); a.href=u; a.download='supernerd-clip.gif'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(function(){ URL.revokeObjectURL(u); },4000); }catch(e){ window.open(url,'_blank'); } }

/* ============================================================
   v28 — PROJECT ORDER (owner drag-to-reorder)
   ============================================================ */
var PORDER={};
var REORG={ on:false, client:null };
async function porderLoad(){ try{ var r=await sb.from('project_order').select('project_id,ord').eq('review_slug',CONFIG.REVIEW_SLUG); PORDER={}; (r.data||[]).forEach(function(x){ PORDER[x.project_id]=x.ord; }); }catch(e){ PORDER={}; } }
function sortProjects(arr){ return arr.map(function(p,i){ return { p:p, o:(PORDER[p.id]!=null?PORDER[p.id]:(100000+i)) }; }).sort(function(a,b){ return a.o-b.o; }).map(function(x){ return x.p; }); }
function reorderStart(clientKey){
  if(!accessIsOwner()) return;
  REORG.on=true; REORG.client=clientKey;
  reorderRender();
}
function reorderRender(){
  var app=document.getElementById('app');
  var cl=(CONFIG.CLIENTS||[]).find(function(x){ return x.key===REORG.client; })||{name:'Projects'};
  var list=sortProjects(CONFIG.PROJECTS.filter(function(p){ return p.client===REORG.client; }));
  var rows=list.map(function(p,i){ var hid=isHidden(visKeyProject(p.id)); return '<div class="porg-row" draggable="true" data-pid="'+esc(p.id)+'"><span class="porg-grip">\u283f</span><span class="porg-num">'+(i+1)+'</span><span class="porg-title">'+esc(p.title||p.id)+(hid?' <span class="porg-hid">hidden</span>':'')+'</span><span class="porg-drag">drag</span></div>'; }).join('');
  app.innerHTML='<section class="landing"><div class="eyebrow">Organize \u00b7 '+esc(cl.name)+'</div><h1 class="co-name">Reorder projects</h1><p class="lead">Drag a row to set the order clients see. The numbers update as you go.</p><div class="porg-list" id="porgList">'+rows+'</div><div class="porg-bar"><button class="ca-btn ghost" id="porgCancel" type="button">Cancel</button><button class="ca-btn" id="porgDone" type="button">Done</button></div></section>';
  reorderWire();
}
function reorderWire(){
  var list=document.getElementById('porgList'); if(!list) return; var dragEl=null;
  list.querySelectorAll('.porg-row').forEach(function(row){
    row.addEventListener('dragstart', function(){ dragEl=row; setTimeout(function(){ row.classList.add('dragging'); },0); });
    row.addEventListener('dragend', function(){ row.classList.remove('dragging'); dragEl=null; porgRenumber(); });
  });
  list.addEventListener('dragover', function(e){ e.preventDefault(); if(!dragEl) return; var after=porgAfter(list, e.clientY); if(after==null) list.appendChild(dragEl); else list.insertBefore(dragEl, after); porgRenumber(); });
  var done=document.getElementById('porgDone'); if(done) done.onclick=reorderSave;
  var cancel=document.getElementById('porgCancel'); if(cancel) cancel.onclick=function(){ REORG.on=false; route(); };
}
function porgAfter(list, y){
  var els=[].slice.call(list.querySelectorAll('.porg-row:not(.dragging)'));
  return els.reduce(function(closest, child){ var box=child.getBoundingClientRect(); var off=y - box.top - box.height/2; if(off<0 && off>closest.offset){ return {offset:off, element:child}; } return closest; }, {offset:-Infinity, element:null}).element;
}
function porgRenumber(){ var list=document.getElementById('porgList'); if(!list) return; [].slice.call(list.querySelectorAll('.porg-row')).forEach(function(r,i){ var n=r.querySelector('.porg-num'); if(n) n.textContent=(i+1); }); }
async function reorderSave(){
  var list=document.getElementById('porgList'); if(!list){ REORG.on=false; route(); return; }
  var ids=[].slice.call(list.querySelectorAll('.porg-row')).map(function(r){ return r.dataset.pid; });
  var done=document.getElementById('porgDone'); if(done){ done.disabled=true; done.textContent='Saving\u2026'; }
  var rows=ids.map(function(id,i){ return { review_slug:CONFIG.REVIEW_SLUG, project_id:id, ord:i, updated_at:new Date().toISOString() }; });
  try{ var r=await sb.from('project_order').upsert(rows,{onConflict:'review_slug,project_id'}); if(r.error){ alert('Could not save order: '+r.error.message); if(done){ done.disabled=false; done.textContent='Done'; } return; } }
  catch(e){ alert('Could not save order.'); if(done){ done.disabled=false; done.textContent='Done'; } return; }
  ids.forEach(function(id,i){ PORDER[id]=i; });
  REORG.on=false; route();
}

</script>
