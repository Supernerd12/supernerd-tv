/* ---------- realtime presence (online lights) ---------- */
function presenceKey(){ return AUTH.user?AUTH.user.id:null; }
function startPresence(){
  var key=presenceKey();
  if(PRESENCE.channel && PRESENCE.key===key) return;
  stopPresence();
  if(!key) return;
  PRESENCE.key=key;
  try{
    var ch=sb.channel('partners-'+CONFIG.REVIEW_SLUG, { config:{ presence:{ key:key } } });
    ch.on('presence',{event:'sync'},function(){
      var st=ch.presenceState(); PRESENCE.online={};
      Object.keys(st).forEach(function(k){ PRESENCE.online[k]=1; });
      refreshOnlineDots();
    });
    ch.subscribe(function(status){ if(status==='SUBSCRIBED'){ try{ ch.track({ at:Date.now() }); }catch(e){} } });
    PRESENCE.channel=ch;
  }catch(e){}
}
function stopPresence(){ if(PRESENCE.channel){ try{ sb.removeChannel(PRESENCE.channel); }catch(e){} } PRESENCE.channel=null; PRESENCE.key=null; }
function refreshOnlineDots(){ document.querySelectorAll('.pc-dot[data-dot]').forEach(function(d){ d.classList.toggle('on', !!PRESENCE.online[d.dataset.dot]); }); }

