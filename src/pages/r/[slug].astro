  document.body.appendChild(ov);
  ov.addEventListener('click',function(e){ if(e.target===ov) ov.remove(); });
  document.getElementById('dkCancel').onclick=function(){ ov.remove(); };
  document.getElementById('dkSave').onclick=async function(){
