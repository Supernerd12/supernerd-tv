function nlWireChips(){ document.querySelectorAll('.nl-wchip').forEach(function(c){ c.onclick=function(){ var i=+c.dataset.wi; NL.data.titleGreen[i]=!NL.data.titleGreen[i]; c.classList.toggle('on'); }; }); }
var _nlHeroTimer=null;
function nlUpdHeroDeb(){ clearTimeout(_nlHeroTimer); _nlHeroTimer=setTimeout(nlUpdHero, 280); }
function nlUpdHero(){
  var d=NL.data; var box=document.getElementById('nlHeroPrev'); if(!box) return;
  var src = d.hero.uid ? nlStreamThumb(d.hero.uid, d.hero.t) : (d.hero.url||'');
  box.innerHTML = src ? '<img id="nlHeroImg" src="'+nlEsc(src)+'" alt="">' : '<div class="nl-hero-none">No frame yet</div>';
}

/* ---------- hero compositor (frame + scrim + title baked in) ---------- */
function nlLoadImg(src){ return new Promise(function(res,rej){ var im=new Image(); im.crossOrigin='anonymous'; im.onload=function(){res(im);}; im.onerror=function(){rej(new Error('img'));}; im.src=src; }); }
async function nlEnsureFont(){ try{ if(document.fonts&&document.fonts.load){ await document.fonts.load('800 64px "Bricolage Grotesque"'); await document.fonts.load('700 22px "Space Mono"'); if(document.fonts.ready) await document.fonts.ready; } }catch(e){} }
function nlDrawTracked(ctx, text, x, y, ls){ for(var i=0;i<text.length;i++){ ctx.fillText(text[i], x, y); x+=ctx.measureText(text[i]).width+ls; } }
function nlWrapWords(ctx, words, maxW){ var lines=[], cur=[], curW=0; for(var i=0;i<words.length;i++){ var ww=ctx.measureText(words[i]+' ').width; if(curW+ww>maxW && cur.length){ lines.push(cur); cur=[]; curW=0; } cur.push({w:words[i], gi:i}); curW+=ww; } if(cur.length) lines.push(cur); return lines; }
async function nlUploadHero(blob){ try{ var path=CONFIG.REVIEW_SLUG+'/'+NL.proj+'/newsletter/hero-'+Date.now()+'.jpg'; var up=await sb.storage.from('client-assets').upload(path, blob, {upsert:false, cacheControl:'3600', contentType:'image/jpeg'}); if(up.error) return ''; var pub=sb.storage.from('client-assets').getPublicUrl(path); return (pub&&pub.data)?pub.data.publicUrl:''; }catch(e){ return ''; } }
async function nlComposeHero(){
  var d=NL.data; var src=d.hero.url || (d.hero.uid?nlStreamThumb(d.hero.uid,d.hero.t):''); if(!src) return '';
  await nlEnsureFont();
  var img=await nlLoadImg(src);
  var W=1200, Hh=675; var cv=document.createElement('canvas'); cv.width=W; cv.height=Hh; var ctx=cv.getContext('2d');
  var ar=img.width/img.height, car=W/Hh, dw,dh,dx,dy;
  if(ar>car){ dh=Hh; dw=Hh*ar; dx=(W-dw)/2; dy=0; } else { dw=W; dh=W/ar; dx=0; dy=(Hh-dh)/2; }
  ctx.drawImage(img,dx,dy,dw,dh);
  var g=ctx.createLinearGradient(0,Hh*0.22,0,Hh); g.addColorStop(0,'rgba(10,10,11,0)'); g.addColorStop(1,'rgba(10,10,11,0.95)'); ctx.fillStyle=g; ctx.fillRect(0,0,W,Hh);
  var g2=ctx.createLinearGradient(0,0,W*0.66,0); g2.addColorStop(0,'rgba(10,10,11,0.55)'); g2.addColorStop(1,'rgba(10,10,11,0)'); ctx.fillStyle=g2; ctx.fillRect(0,0,W,Hh);
  var padX=66;
  ctx.textBaseline='alphabetic'; ctx.font='700 22px "Space Mono", monospace'; ctx.fillStyle='#B4C828';
  nlDrawTracked(ctx,(d.eyebrow||'PROJECT UPDATE NEWSLETTER').toUpperCase(), padX, Hh-176, 3);
  var words=(d.title||'').split(/\s+/).filter(Boolean);
  if(words.length){
    var fs=64; ctx.font='800 '+fs+'px "Bricolage Grotesque", sans-serif';
    var lines=nlWrapWords(ctx, words, W-padX*2); var lh=fs*1.05; var startY=Hh-58-(lines.length-1)*lh;
    lines.forEach(function(line,li){ var x=padX, y=startY+li*lh; line.forEach(function(it){ ctx.fillStyle=d.titleGreen[it.gi]?'#B4C828':'#FFFFFF'; ctx.fillText(it.w, x, y); x+=ctx.measureText(it.w+' ').width; }); });
  }
  var blob=await new Promise(function(res){ cv.toBlob(res,'image/jpeg',0.9); });
  if(!blob) return '';
  return await nlUploadHero(blob);
}
async function nlMaybeCompose(){
  var d=NL.data;
  if(!d.hero.uid && !d.hero.url){ d.hero.composed=''; return; }
  if(d.hero.uid) d.hero.url=nlStreamThumb(d.hero.uid,d.hero.t);
  var sig=(d.hero.url)+'|'+d.title+'|'+Object.keys(d.titleGreen).filter(function(k){return d.titleGreen[k];}).join(',');
  if(NL._heroSig===sig && d.hero.composed) return;
  var url=await nlComposeHero();
  if(url){ d.hero.composed=url; NL._heroSig=sig; }
}

/* ---------- preview / send / save ---------- */
function nlStatus(msg, cls){ var s=document.getElementById('nlStatus'); if(s){ s.textContent=msg; s.className='nl-status '+(cls||''); if(cls==='ok') setTimeout(function(){ if(s) s.textContent=''; }, 3000); } }
function nlOpenPreview(html){ var safe=html.replace(/"/g,'&quot;'); openOverlay('<div class="nl-preview-wrap"><div class="nl-preview-bar">Email preview</div><iframe class="nl-preview-frame" srcdoc="'+safe+'"></iframe></div>', true); }
async function nlPreview(){
  nlCollect(); var btn=document.getElementById('nlPreviewBtn'); if(btn){ btn.disabled=true; btn.textContent='Building\u2026'; }
  try{ await nlMaybeCompose(); }catch(e){}
  var html=nlEmailHTML(NL.data);
