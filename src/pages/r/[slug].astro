}
function reactorIdentity(it){ const a=getAuthor(it); if(!a.name) return null; return { key:(a.email||('name:'+a.name.toLowerCase())), name:a.name, email:a.email||null }; }
function itemDeepLink(proj, sec, it){ return location.origin+location.pathname+'#p='+encodeURIComponent(proj.id)+'&s='+encodeURIComponent(sec.id)+'&i='+encodeURIComponent(it.id); }
function mentionPeople(){ return [{name:OWNER_NAME,email:OWNER_EMAIL}].concat(INVITES.map(p=>({name:p.name||p.email,email:p.email}))); }
function mentionHighlight(body){
  let html=esc(body);
  const names=mentionPeople().map(p=>p.name).filter(Boolean);
  if(!names.length) return html.replace(/\n/g,'<br>');
  names.sort((a,b)=>b.length-a.length);
  const e2=s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  const re=new RegExp('@('+names.map(e2).join('|')+')(?![\\w])','g');
  return html.replace(re,'<span class="mention">@$1</span>').replace(/\n/g,'<br>');
}
function getSavedAuthor(){ try { return JSON.parse(localStorage.getItem(AUTHOR_KEY) || 'null'); } catch (e) { return null; } }
function setSavedAuthor(v, other){ try { localStorage.setItem(AUTHOR_KEY, JSON.stringify({ v: v||'', other: other||'' })); } catch (e) {} }
function personName(email){ const p = INVITES.find(x => x.email === email); return p ? (p.name || p.email) : email; }
function getAuthor(it){
  if(AUTH.profile){
    return { name: AUTH.profile.full_name || (AUTH.user&&AUTH.user.email) || 'Member', email: ((AUTH.user&&AUTH.user.email)||AUTH.profile.email||'').toLowerCase() };
  }
  if(AUTH.user){ return { name: AUTH.user.email, email: (AUTH.user.email||'').toLowerCase() }; }
  return { name:'', email:'' };
}
function onNameChange(it){
  const sel = document.getElementById('name-'+it.id), o = document.getElementById('nameother-'+it.id);
  const isOther = sel && sel.value === '__other__';
  if(o) o.style.display = isOther ? '' : 'none';
  setSavedAuthor(sel?sel.value:'', o?o.value:'');
  fillNotifyBox(it);
