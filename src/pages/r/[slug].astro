  .tool-btn.active{color:var(--ink); background:var(--green); border-color:var(--green)}
  .tool-btn.recording{color:#ff6b6b; border-color:rgba(255,107,107,.55)}
  .pin-ind{font-family:var(--mono); font-size:11px; color:var(--green-hi)}
  .rec-prev{margin:2px 0}
