/* ---------- Project Status ---------- */
var PSTAT_DEFAULTS=[{name:'On Track',color:'#22c55e'},{name:'Needs Client Review',color:'#eab308'},{name:'Waiting on Assets',color:'#f59e0b'},{name:'In Revision',color:'#3b82f6'},{name:'Final Delivery',color:'#a855f7'}];
var PSTAT_CACHE={};
function pstatGet(row){
  var phases=(row&&row.phases&&row.phases.length)?row.phases:PSTAT_DEFAULTS;
  var cur=(row&&row.phase)||phases[0].name;
  var match=phases.find(function(p){return p.name===cur;})||{name:cur,color:'#22c55e'};
  return {phases:phases, phase:cur, color:match.color};
}
async function projStatusLoad(projKey){
  var box=document.getElementById('projStatusBox'); if(!box) return;
  var row=null;
  try{ var r=await sb.from('project_status').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',projKey).maybeSingle(); if(!r.error) row=r.data; }catch(e){}
  PSTAT_CACHE[projKey]=row; projStatusRender(projKey);
}
function projStatusRender(projKey){
  var box=document.getElementById('projStatusBox'); if(!box) return;
  var st=pstatGet(PSTAT_CACHE[projKey]);
  var btn = ADMIN ? '<button class="pstat-edit" id="pstatEdit">Change</button>' : '';
  box.innerHTML='<div class="pstat-h"><span>Project Status</span>'+btn+'</div><div class="pstat-pill"><span class="pstat-dot" style="background:'+esc(st.color)+';color:'+esc(st.color)+'"></span><span class="pstat-name">'+esc(st.phase)+'</span></div>';
  if(ADMIN){ var e=document.getElementById('pstatEdit'); if(e) e.onclick=function(){ projStatusOpen(projKey); }; }
}
function projStatusOpen(projKey){
  var st=pstatGet(PSTAT_CACHE[projKey]); var phases=st.phases.map(function(p){return {name:p.name,color:p.color};}); var chosen=st.phase;
  var ov=document.createElement('div'); ov.className='onb show'; ov.id='pstatOv';
  function rowsHTML(){ return phases.map(function(p,i){ return '<div class="psrow"><button type="button" class="psrow-pick'+(p.name===chosen?' on':'')+'" data-i="'+i+'"><span class="pstat-dot" style="background:'+esc(p.color)+';color:'+esc(p.color)+'"></span>'+esc(p.name)+'</button><input type="color" class="psrow-col" data-i="'+i+'" value="'+esc(p.color)+'"><button type="button" class="psrow-del" data-i="'+i+'">\u2715</button></div>'; }).join(''); }
  function redraw(){ var c=document.getElementById('psList'); if(c){ c.innerHTML=rowsHTML(); wire(); } }
  function wire(){
    ov.querySelectorAll('.psrow-pick').forEach(function(b){ b.onclick=function(){ chosen=phases[+b.dataset.i].name; ov.querySelectorAll('.psrow-pick').forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); }; });
    ov.querySelectorAll('.psrow-col').forEach(function(c){ c.oninput=function(){ phases[+c.dataset.i].color=c.value; }; });
    ov.querySelectorAll('.psrow-del').forEach(function(d){ d.onclick=function(){ phases.splice(+d.dataset.i,1); if(!phases.length) phases.push({name:'On Track',color:'#22c55e'}); if(!phases.some(function(p){return p.name===chosen;})) chosen=phases[0].name; redraw(); }; });
  }
  ov.innerHTML='<div class="lm-modal"><div class="lm-title" style="font-size:19px">Project Status</div><p class="dk-hint" style="margin:0 0 12px">Pick the phase clients see. Add your own phases for this project.</p><div id="psList">'+rowsHTML()+'</div><div class="psadd"><input class="dk-i" id="psNew" placeholder="New phase name"><input type="color" id="psNewCol" value="#BAC01E"><button type="button" id="psAdd" class="deck-addver">+ Add phase</button></div><div class="lm-foot"><button id="psCancel">Cancel</button><button id="psSave" class="post">Save</button><span class="msg" id="psMsg"></span></div></div>';
  document.body.appendChild(ov); wire();
  ov.addEventListener('click',function(e){ if(e.target===ov) ov.remove(); });
  document.getElementById('psCancel').onclick=function(){ ov.remove(); };
  document.getElementById('psAdd').onclick=function(){ var n=(document.getElementById('psNew').value||'').trim(); if(!n) return; phases.push({name:n,color:document.getElementById('psNewCol').value||'#BAC01E'}); document.getElementById('psNew').value=''; redraw(); };
  document.getElementById('psSave').onclick=async function(){
    var msg=document.getElementById('psMsg'), btn=document.getElementById('psSave'); btn.disabled=true; btn.textContent='Saving\u2026';
    try{ var r=await sb.from('project_status').upsert({ review_slug:CONFIG.REVIEW_SLUG, project_key:projKey, phase:chosen, phases:phases, updated_at:new Date().toISOString() }, { onConflict:'review_slug,project_key' }); if(r.error) throw r.error; PSTAT_CACHE[projKey]={phase:chosen,phases:phases}; ov.remove(); projStatusRender(projKey); }
    catch(e){ console.error('status save failed',e); msg.className='msg err'; msg.textContent='Could not save — run tasks.sql first.'; btn.disabled=false; btn.textContent='Save'; }
  };
}

/* ---------- Task Manager ---------- */
var TASK_STATUSES=[
  {k:'new',label:'New task',color:'#9aa0a6'},
  {k:'in_progress',label:'In progress',color:'#3b82f6'},
  {k:'working_changes',label:'Working on changes',color:'#f59e0b'},
  {k:'needs_client_feedback',label:'Needs client feedback',color:'#a855f7'},
  {k:'uploaded',label:'Uploaded',color:'#06b6d4'},
  {k:'needs_approval',label:'Needs approval',color:'#eab308'},
  {k:'needs_changes',label:'Needs changes',color:'#ef4444'},
  {k:'complete',label:'Complete',color:'#22c55e'}
];
function taskStatus(k){ return TASK_STATUSES.find(function(s){return s.k===k;})||TASK_STATUSES[0]; }
function taskWho(t){ return (t&&t.owner_names&&t.owner_names.length)?t.owner_names.join(', '):((t&&t.owner_name)||''); }
function taskEmails(t){ var a=(t&&t.owner_emails&&t.owner_emails.length)?t.owner_emails.slice():[]; if(!a.length && t && t.owner_email) a=[t.owner_email]; return a.map(function(e){return String(e||'').toLowerCase();}).filter(Boolean); }
var TASKS_CACHE={};
function myEmail(){ return ((AUTH.user&&AUTH.user.email)||(AUTH.profile&&AUTH.profile.email)||'').toLowerCase(); }
async function taskBadgeLoad(projKey){
  var me=myEmail(); var b=document.getElementById('taskBadge');
  if(!me){ if(b) b.hidden=true; return; }
  try{
    var r=await sb.from('tasks').select('id,status,owner_email,owner_emails').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',projKey).neq('status','complete');
    if(r.error) throw r.error;
    var n=(r.data||[]).filter(function(t){ return taskEmails(t).indexOf(me)>=0; }).length;
    b=document.getElementById('taskBadge'); if(b){ if(n>0){ b.textContent=n; b.hidden=false; } else b.hidden=true; }
  }catch(e){}
}
async function taskLoad(projKey){
  var mount=document.getElementById('taskmount'); if(!mount) return;
  var rows=[];
  try{ var r=await sb.from('tasks').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',projKey).order('created_at',{ascending:true}); if(r.error) throw r.error; rows=r.data||[]; }
  catch(e){ console.error('tasks load failed',e); mount.innerHTML='<div class="sec-empty">Could not load tasks. Run tasks.sql in Supabase first.</div>'; return; }
  TASKS_CACHE[projKey]=rows;
  var addBtn='<div class="task-board-head"><button class="task-add" id="taskAddTop">+ Add task</button></div>';
  mount.innerHTML=addBtn+'<div class="task-cols">'+taskColHTML(projKey,'supernerd','Supernerd',rows)+taskColHTML(projKey,'client','Partner',rows)+'</div>';
  taskWire(projKey);
}
function taskColHTML(projKey,side,label,rows){
  var mine=rows.filter(function(t){return (t.side||'supernerd')===side;});
  var active=mine.filter(function(t){return t.status!=='complete';});
  var done=mine.filter(function(t){return t.status==='complete';});
  return '<div class="task-col" data-side="'+side+'"><div class="task-col-h"><h3>'+esc(label)+'</h3><button class="task-add-col" data-side="'+side+'">+ Add</button></div>'
    +'<div class="task-list">'+(active.map(taskCardHTML).join('')||'<div class="task-empty">No open tasks.</div>')+'</div>'
    +(done.length?'<div class="task-done-h">Completed</div><div class="task-done">'+done.map(taskDoneHTML).join('')+'</div>':'')
    +'</div>';
}
function taskTip(t){ return 'Assigned by '+(t.assigner_name||'\u2014')+(taskWho(t)?(' \u00b7 for '+taskWho(t)):'')+(t.due_date?(' \u00b7 due '+taskDue(t.due_date)):''); }
function taskCardHTML(t){
  var s=taskStatus(t.status);
  var opts=TASK_STATUSES.map(function(o){return '<option value="'+o.k+'"'+(o.k===t.status?' selected':'')+'>'+esc(o.label)+'</option>';}).join('');
  var due=t.due_date?('<span class="task-due">'+esc(taskDue(t.due_date))+'</span>'):'';
  return '<div class="task-card" data-id="'+esc(t.id)+'" title="'+esc(taskTip(t))+'">'
    +'<span class="task-light blink" style="--c:'+esc(s.color)+'"></span>'
    +'<div class="task-main"><div class="task-title">'+esc(t.title)+'</div><div class="task-sub">'+(taskWho(t)?'<span class="task-who">'+esc(taskWho(t))+'</span>':'')+due+'</div></div>'
    +'<select class="task-status" data-id="'+esc(t.id)+'" style="--c:'+esc(s.color)+'">'+opts+'</select>'
    +'<button class="task-edit" data-id="'+esc(t.id)+'" title="Edit">\u270e</button>'
    +(taskCanDelete(t)?'<button class="task-del" data-id="'+esc(t.id)+'" title="Delete">\u2715</button>':'')
    +'</div>';
}
function taskDoneHTML(t){
  return '<div class="task-card done" data-id="'+esc(t.id)+'" title="'+esc(taskTip(t))+'"><span class="task-light done"></span><div class="task-main"><div class="task-title">'+esc(t.title)+'</div></div>'
    +'<select class="task-status" data-id="'+esc(t.id)+'" style="--c:#22c55e">'+TASK_STATUSES.map(function(o){return '<option value="'+o.k+'"'+(o.k===t.status?' selected':'')+'>'+esc(o.label)+'</option>';}).join('')+'</select>'
    +(taskCanDelete(t)?'<button class="task-del" data-id="'+esc(t.id)+'" title="Delete">\u2715</button>':'')+'</div>';
}
function taskCanDelete(t){ return ADMIN || ((t.assigner_email||'').toLowerCase()===myEmail()); }
function taskDue(d){ try{ var x=new Date(d+'T00:00:00'); return x.toLocaleDateString(undefined,{month:'short',day:'numeric'}); }catch(e){ return d; } }
function taskWire(projKey){
  var mount=document.getElementById('taskmount'); if(!mount) return;
  var top=document.getElementById('taskAddTop'); if(top) top.onclick=function(){ taskOpen(projKey, null, null); };
  mount.querySelectorAll('.task-add-col').forEach(function(b){ b.onclick=function(){ taskOpen(projKey, b.dataset.side, null); }; });
  mount.querySelectorAll('.task-status').forEach(function(sel){ sel.onchange=function(){ taskSetStatus(projKey, sel.dataset.id, sel.value); }; });
  mount.querySelectorAll('.task-edit').forEach(function(b){ b.onclick=function(){ var row=(TASKS_CACHE[projKey]||[]).find(function(x){return x.id===b.dataset.id;}); taskOpen(projKey, row?row.side:null, row); }; });
  mount.querySelectorAll('.task-del').forEach(function(b){ b.onclick=function(){ taskDelete(projKey, b.dataset.id); }; });
}
async function taskSetStatus(projKey,id,status){
  try{ var r=await sb.from('tasks').update({status:status}).eq('id',id); if(r.error) throw r.error; taskLoad(projKey); taskBadgeLoad(projKey); }
  catch(e){ console.error('status update failed',e); alert('Could not update status.'); }
}
async function taskDelete(projKey,id){
  if(!confirm('Delete this task?')) return;
  try{ var r=await sb.from('tasks').delete().eq('id',id); if(r.error) throw r.error; taskLoad(projKey); taskBadgeLoad(projKey); }
  catch(e){ console.error('delete failed',e); alert('Could not delete.'); }
}
function taskPeople(){ var own={}; (CONFIG.OWNER_LOGINS||[]).forEach(function(e){ own[String(e).toLowerCase()]=1; }); own[String(OWNER_EMAIL).toLowerCase()]=1; if(ADMIN){ var me=myEmail(); if(me) own[me]=1; } var list=[], seen={}; (INVITES||[]).forEach(function(i){ var em=(i.email||'').toLowerCase(); if(!em||own[em]||seen[em]) return; seen[em]=1; list.push({name:i.name||i.email,email:i.email}); }); return list; }
function taskOpen(projKey, side, row){
  var editing=!!(row && row.id);
  var curSide = editing ? (row.side||'supernerd') : (side || (ADMIN ? 'client' : 'supernerd'));
  var ov=document.createElement('div'); ov.className='onb show'; ov.id='taskOv';
  var sel=function(v){return curSide===v?' selected':'';};
  var ppl=taskPeople();
  var pre = editing ? ((row.owner_emails&&row.owner_emails.length)?row.owner_emails:[row.owner_email]).filter(Boolean).map(function(e){return String(e).toLowerCase();}) : [];
  var preSet={}; pre.forEach(function(e){ preSet[e]=1; });
  var meChecked = editing && (preSet[myEmail()] || (row.owner_email||'').toLowerCase()===myEmail());
  var clientChecked = editing && !pre.length && !!row.owner_name;
  var assignHTML='<div class="tk-assign" id="tkAssign">'
    +'<label class="tk-ass"><input type="checkbox" class="tk-pick" value="__me__"'+(meChecked?' checked':'')+'> Me</label>'
    +ppl.map(function(p){ return '<label class="tk-ass"><input type="checkbox" class="tk-pick" value="'+esc(p.email)+'"'+(preSet[p.email.toLowerCase()]?' checked':'')+'> '+esc(p.name)+'</label>'; }).join('')
    +'<label class="tk-ass"><input type="checkbox" class="tk-pick" value="__client__"'+(clientChecked?' checked':'')+'> The partner (no specific person)</label>'
    +'</div>';
  ov.innerHTML='<div class="lm-modal"><div class="lm-title" style="font-size:19px">'+(editing?'Edit task':'New task')+'</div>'
    +'<label class="dk-l">For which list</label><select class="dk-i" id="tkSide"><option value="supernerd"'+sel('supernerd')+'>Supernerd (our to-do)</option><option value="client"'+sel('client')+'>Partner (their to-do — e.g. approvals)</option></select>'
    +'<label class="dk-l">Task</label><input class="dk-i" id="tkTitle" value="'+(editing?esc(row.title||''):'')+'" placeholder="e.g. Review the new animatic">'
    +'<label class="dk-l">Assigned to <span class="dk-hint">tick everyone responsible</span></label>'+assignHTML
    +'<label class="dk-l">Due date</label><div class="dk-daterow"><input class="dk-i" id="tkDue" type="date" value="'+(editing?(row.due_date?esc(row.due_date):''):new Date().toISOString().slice(0,10))+'"><button type="button" class="dk-calbtn" id="tkCal" title="Pick a date">'+calNavIcon('cal')+'</button></div>'
    +'<div class="lm-foot"><button id="tkCancel">Cancel</button><button id="tkSave" class="post">'+(editing?'Save':'Add task')+'</button><span class="msg" id="tkMsg"></span></div></div>';
  document.body.appendChild(ov);
  ov.addEventListener('click',function(e){ if(e.target===ov) ov.remove(); });
  document.getElementById('tkCancel').onclick=function(){ ov.remove(); };
  var tkCal=document.getElementById('tkCal'); if(tkCal) tkCal.onclick=function(){ var d=document.getElementById('tkDue'); try{ d.showPicker(); }catch(e){ d.focus(); } };
  document.getElementById('tkSave').onclick=async function(){
    var title=(document.getElementById('tkTitle').value||'').trim();
    var newSide=document.getElementById('tkSide').value;
    var due=document.getElementById('tkDue').value||null;
    var msg=document.getElementById('tkMsg'); if(!title){ msg.className='msg err'; msg.textContent='Name the task.'; return; }
    var _picks=[].slice.call(document.querySelectorAll('#tkAssign .tk-pick:checked')).map(function(c){return c.value;});
    var names=[], emails=[];
    _picks.forEach(function(v){ if(v==='__me__'){ names.push((AUTH.profile&&AUTH.profile.full_name)||'Me'); emails.push(myEmail()); } else if(v==='__client__'){ names.push('The partner'); } else { var p=ppl.find(function(x){return x.email===v;}); names.push(p?p.name:v); emails.push(v); } });
    emails=emails.filter(Boolean);
    if(!names.length && editing){ names=(row.owner_names&&row.owner_names.length)?row.owner_names:(row.owner_name?[row.owner_name]:[]); emails=(row.owner_emails&&row.owner_emails.length)?row.owner_emails:(row.owner_email?[row.owner_email]:[]); }
    var ownerName=names.join(', '), ownerEmail=emails[0]||'';
    var btn=document.getElementById('tkSave'); btn.disabled=true; btn.textContent='Saving\u2026';
    try{
      if(editing){
        var r=await sb.from('tasks').update({ side:newSide, title:title, owner_name:ownerName, owner_email:ownerEmail, owner_names:names, owner_emails:emails, due_date:due }).eq('id', row.id); if(r.error) throw r.error;
      } else {
        var an=(AUTH.profile&&AUTH.profile.full_name)||(ADMIN?'Supernerd':myEmail())||'Supernerd';
        var r2=await sb.from('tasks').insert({ review_slug:CONFIG.REVIEW_SLUG, project_key:projKey, side:newSide, title:title, owner_name:ownerName, owner_email:ownerEmail, owner_names:names, owner_emails:emails, assigner_name:an, assigner_email:myEmail(), due_date:due, status:'new' }); if(r2.error) throw r2.error;
        var _to=emails.filter(function(e){ return e && e.toLowerCase()!==myEmail(); }); if(_to.length) notifyTaskAssigned({title:title, names:names, due:due, projKey:projKey, assigner:an}, _to);
      }
      ov.remove(); taskLoad(projKey); taskBadgeLoad(projKey);
    }catch(e){ console.error('save task failed',e); msg.className='msg err'; msg.textContent='Could not save — run tasks.sql.'; btn.disabled=false; btn.textContent=editing?'Save':'Add task'; }
  };
}
function calParse(s){ var a=String(s).split('-'); return new Date(+a[0],+a[1]-1,+a[2]); }
function calSameDay(a,b){ return a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate(); }
function calTypeC(t){ return CAL.TYPES[t]?CAL.TYPES[t].c:'#8b8f98'; }
function calTypeL(t){ return CAL.TYPES[t]?CAL.TYPES[t].l:t; }
function calIsPast(e){ return e.d < calTodayK(); }
function calEvColor(e){ if(e.isTask) return e.frozen||'#BAC01E'; return calIsPast(e)?(e.frozen||'#8b8f98'):calTypeC(e.type); }
function calProjName(id){ return id||'project'; }
function calHexA(hex,a){ var h=hex.replace('#',''); return 'rgba('+parseInt(h.slice(0,2),16)+','+parseInt(h.slice(2,4),16)+','+parseInt(h.slice(4,6),16)+','+a+')'; }
function calLighten(hex){ var h=hex.replace('#',''); var r=parseInt(h.slice(0,2),16),g=parseInt(h.slice(2,4),16),b=parseInt(h.slice(4,6),16); r=Math.round(r+(255-r)*.45);g=Math.round(g+(255-g)*.45);b=Math.round(b+(255-b)*.45); return 'rgb('+r+','+g+','+b+')'; }
function calEvOn(dt){ var k=calKey(dt); return CAL.EV.filter(function(e){ return e.d===k && (CAL.filter==='all'||e.proj===CAL.filter); }); }
function calProjs(){ var seen={},out=[]; CAL.EV.forEach(function(e){ if(e.proj && !seen[e.proj]){ seen[e.proj]=1; out.push(e.proj); } }); return out; }
function calEvAttrs(e){ return 'data-eid="'+esc(e.id||'')+'" data-ttl="'+esc(e.title)+'" data-type="'+esc(e.type)+'" data-proj="'+esc(calProjName(e.proj))+'" data-date="'+e.d+'" data-time="'+esc(e.time||'')+'" data-col="'+calEvColor(e)+'" data-notes="'+esc(e.notes||'')+'"'; }
function calMajorKeyOn(dt){ var e=calEvOn(dt).filter(function(x){return x.kind!=='meeting';}); return e.length===1?(e[0].type+'|'+e[0].proj):null; }

function calRender(){
  var c=document.getElementById('calmount'); if(!c) return;
  var T=calToday();
  var title=CAL.view==='month'?(CAL_MON[CAL.cursor.getMonth()]+' '+CAL.cursor.getFullYear()):CAL.view==='week'?calWeekTitle():calDayTitle(CAL.day||CAL.cursor);
  var seg=['month','week','day'].map(function(v){return '<button class="'+(CAL.view===v?'on':'')+'" data-cv="'+v+'">'+v.charAt(0).toUpperCase()+v.slice(1)+'</button>';}).join('');
  var chips='<button class="cal-chip '+(CAL.filter==='all'?'on':'')+'" data-cf="all">All projects</button>'+calProjs().map(function(p){return '<button class="cal-chip '+(CAL.filter===p?'on':'')+'" data-cf="'+esc(p)+'"><span class="dot" style="background:'+(CAL.EV.filter(function(e){return e.proj===p;})[0]?calEvColor(CAL.EV.filter(function(e){return e.proj===p;})[0]):'#888')+'"></span>'+esc(p)+'</button>';}).join('');
  var body=CAL.view==='month'?calMonthHTML():CAL.view==='week'?calWeekHTML():calDayHTML(CAL.day||CAL.cursor);
