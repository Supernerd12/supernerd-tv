function calMonthHTML(){
  var y=CAL.cursor.getFullYear(),m=CAL.cursor.getMonth(),T=calToday();
  var first=new Date(y,m,1),start=first.getDay(),dts=[],mk=[];
  for(var j=0;j<42;j++){var d0=new Date(y,m,1-start+j);dts.push(d0);mk.push(calMajorKeyOn(d0));}
  var dow='<div class="cal-dow">'+CAL_DOW.map(function(d){return '<span>'+d+'</span>';}).join('')+'</div>';
  var cells='';
  for(var i=0;i<42;i++){
    var dt=dts[i],col=i%7,inM=dt.getMonth()===m;
    var evs=calEvOn(dt),majors=evs.filter(function(e){return e.kind!=='meeting';}),mtgs=evs.filter(function(e){return e.kind==='meeting';});
    var contLeft=col>0&&mk[i]&&mk[i-1]===mk[i],contRight=col<6&&mk[i]&&mk[i+1]===mk[i];
    var cls='cell'+(inM?'':' out')+(calSameDay(dt,T)?' today':''),inner='',cellAttrs='';
    if(majors.length===1){
      var e0=majors[0],c0=calEvColor(e0);
      cls+=' has-fill popcell'+(contLeft?' lcont':'')+(contRight?' rcont':''); cellAttrs=calEvAttrs(e0);
      inner='<div class="fill" style="background:linear-gradient(160deg,'+calHexA(c0,.34)+','+calHexA(c0,.15)+')"></div><div class="dnum">'+dt.getDate()+'</div>'+(contLeft?'':'<div class="fill-label" style="color:'+calLighten(c0)+'">'+esc(e0.title)+'</div>');
    } else if(majors.length>=2){
      var bars='<div class="bars">'+majors.map(function(e){return '<span class="bar cal-ev" '+calEvAttrs(e)+' style="background:'+calEvColor(e)+'"></span>';}).join('')+'</div>';
      var ch='<div class="evchips" style="margin-top:'+(majors.length*6+4)+'px">'+majors.map(function(e){return '<span class="evchip cal-ev" '+calEvAttrs(e)+' style="border-left-color:'+calEvColor(e)+';color:'+calLighten(calEvColor(e))+'">'+esc(e.title)+'</span>';}).join('')+'</div>';
      inner=bars+'<div class="dnum" style="margin-top:'+(majors.length*6)+'px">'+dt.getDate()+'</div>'+ch;
    } else { inner='<div class="dnum">'+dt.getDate()+'</div>'; }
    inner+=mtgs.map(function(e){return '<div class="mtg cal-ev" '+calEvAttrs(e)+'><span class="mdot"></span>'+(e.time?esc(String(e.time).replace(':00',''))+' ':'')+esc(e.title)+'</div>';}).join('');
    cells+='<div class="'+cls+'" data-calday="'+calKey(dt)+'" '+cellAttrs+'>'+inner+'</div>';
  }
  return dow+'<div class="cal-grid">'+cells+'</div>';
}
function calWeekStart(dt){ var d=new Date(dt); d.setDate(d.getDate()-d.getDay()); return d; }
function calWeekTitle(){ var s=calWeekStart(CAL.cursor),e=new Date(s); e.setDate(s.getDate()+6); return CAL_MON[s.getMonth()].slice(0,3)+' '+s.getDate()+' \u2013 '+CAL_MON[e.getMonth()].slice(0,3)+' '+e.getDate()+', '+e.getFullYear(); }
function calWeekHTML(){
  var s=calWeekStart(CAL.cursor),T=calToday(),cols='';
  for(var i=0;i<7;i++){ var dt=new Date(s); dt.setDate(s.getDate()+i);
    var evs=calEvOn(dt).sort(function(a,b){return (a.kind==='meeting'?1:0)-(b.kind==='meeting'?1:0);});
    var items=evs.map(function(e){return '<div class="wev cal-ev" '+calEvAttrs(e)+' data-calgoday="'+e.d+'" style="border-left-color:'+calEvColor(e)+';color:'+calLighten(calEvColor(e))+'">'+esc(e.title)+(e.time?'<span class="wt">'+esc(e.time)+'</span>':'')+'</div>';}).join('')||'<div class="wkemp">\u2014</div>';
    cols+='<div class="wcol'+(calSameDay(dt,T)?' today':'')+'"><h4 data-calgoday="'+calKey(dt)+'">'+CAL_DOW[dt.getDay()]+'<b>'+dt.getDate()+'</b></h4>'+items+'</div>';
  }
