  .onb-card{width:100%;max-width:540px;border-radius:22px;padding:36px;background:linear-gradient(170deg,#191b1f,#0d0e10 84%);border:1px solid rgba(255,255,255,.08);box-shadow:0 40px 120px -40px #000,inset 0 1px 0 rgba(255,255,255,.05);max-height:92vh;overflow:auto}
