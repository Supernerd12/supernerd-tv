      var ch='<div class="evchips" style="margin-top:'+(majors.length*6+4)+'px">'+majors.map(function(e){return '<span class="evchip cal-ev" '+calEvAttrs(e)+' style="border-left-color:'+calEvColor(e)+';color:'+calLighten(calEvColor(e))+'">'+esc(e.title)+'</span>';}).join('')+'</div>';
      inner=bars+'<div class="dnum" style="margin-top:'+(majors.length*6)+'px">'+dt.getDate()+'</div>'+ch;
