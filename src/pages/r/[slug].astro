async function caInsertFile(file, cat){
  try{
    var path=CONFIG.REVIEW_SLUG+'/'+(cat==='final'?FD.proj:CA.proj)+'/'+cat+'/'+Date.now()+'_'+caSafe(file.name);
    var up=await sb.storage.from('client-assets').upload(path, file, {upsert:false, cacheControl:'3600'});
    if(up.error){ alert('Upload failed: '+up.error.message); return null; }
    var pub=sb.storage.from('client-assets').getPublicUrl(path);
    var row={ review_slug:CONFIG.REVIEW_SLUG, project_key:(cat==='final'?FD.proj:CA.proj), category:cat, kind:'file', name:file.name, note:'', url:pub.data.publicUrl, file_name:file.name, file_type:file.type||'', size_bytes:file.size||null, created_by:myEmail() };
    var r=await sb.from('client_assets').insert(row).select().single();
    if(r.error){ alert('Uploaded, but could not record it: '+r.error.message); return null; }
    return r.data;
  }catch(e){ alert('Upload error.'); return null; }
}
async function caDelete(id){
  if(!confirm('Remove this asset?')) return;
  try{ var r=await sb.from('client_assets').delete().eq('id', id); if(r.error){ alert('Could not remove: '+r.error.message); return; } }catch(e){ alert('Could not remove.'); return; }
  CA.items=CA.items.filter(function(x){return x.id!==id;});
  FD.items=FD.items.filter(function(x){return x.id!==id;});
  if(currentFolder==='final') finalRender(); else caRender();
}

