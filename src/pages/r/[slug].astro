function calHidePop(){ var p=document.getElementById('calpop'); if(p) p.classList.remove('show'); }
function calPosPop(ev){ var p=calPopEl(),pw=p.offsetWidth,ph=p.offsetHeight,x=ev.clientX+14,y=ev.clientY+14; if(x+pw>innerWidth-8)x=ev.clientX-pw-14; if(y+ph>innerHeight-8)y=ev.clientY-ph-14; p.style.left=Math.max(8,x)+'px'; p.style.top=Math.max(8,y)+'px'; }
function calPretty(s){ var d=calParse(s); return CAL_DOW[d.getDay()]+', '+CAL_MON[d.getMonth()].slice(0,3)+' '+d.getDate(); }
function calUpsertType(t){ try{ sb.from('calendar_types').upsert({review_slug:CONFIG.REVIEW_SLUG,key:t,label:CAL.TYPES[t].l,color:CAL.TYPES[t].c,sort:CAL.ORDER.indexOf(t)},{onConflict:'review_slug,key'}).then(function(){},function(){}); }catch(e){} }
function calDeleteTypeDB(t){ try{ sb.from('calendar_types').delete().eq('review_slug',CONFIG.REVIEW_SLUG).eq('key',t).then(function(){},function(){}); }catch(e){} }
function calReloadEv(){
  return sb.from('calendar_events').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).order('date',{ascending:true}).then(function(re){
    CAL.EV=((re&&re.data)||[]).map(function(r){ return { id:r.id, d:r.date, type:r.type, title:r.title, proj:r.project_id||'project', kind:r.kind||'major', time:r.time||'', notes:r.notes||'', frozen:r.frozen_color||null }; });
    calRender();
  },function(){ calRender(); });
}
function calEvClose(){ var ov=document.getElementById('calEvOv'); if(ov) ov.classList.remove('show'); CAL.editEv=null; }
