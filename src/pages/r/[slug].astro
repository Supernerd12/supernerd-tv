      return '<tr><td width="16" valign="top" style="padding:8px 0;"><div style="width:8px;height:8px;border-radius:50%;background:'+ACID+';margin-top:6px;"></div></td><td style="font-family:'+disp+';font-size:14px;line-height:1.5;color:'+BONE+';padding:8px 0 8px 4px;">'+nlEsc(m.text)+tag+'</td></tr>';
    }).join('');
    H+=sectionWrap(eyebrow('Milestones')+'<table role="presentation" width="100%" cellpadding="0" cellspacing="0">'+ms+'</table>');
