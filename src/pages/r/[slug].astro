      +'<div style="font-family:'+disp+';font-size:30px;line-height:1.08;font-weight:800;letter-spacing:-.03em;">'+nlTitleHTML(d,ACID,'#FFFFFF')+'</div>'
      +(d.sub?'<div style="font-family:'+disp+';font-size:14px;line-height:1.5;color:'+G3+';margin-top:10px;">'+nlEsc(d.sub)+'</div>':'')+'</td></tr>';
