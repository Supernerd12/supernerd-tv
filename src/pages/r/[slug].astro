async function loadProfile(){
  AUTH.profile=null;
  if(!AUTH.user) return;
  // Owner/lead first — their identity is in review_settings, and it must win over
  // any leftover partner row so onboarding never pops and they don't get duplicated.
  var em=(AUTH.user.email||'').toLowerCase();
  var ownerEmail=(CONFIG.OWNER_LOGINS||[]).some(function(x){return String(x).toLowerCase()===em;});
  var d=null;
  try{ var ro=await sb.from('review_settings').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).maybeSingle(); d=ro&&ro.data; }catch(e){}
  var ownerUid=d&&d.owner_uid&&d.owner_uid===AUTH.user.id;
  if(ownerEmail||ownerUid){
    AUTH.profile={ id:AUTH.user.id, owner:true, full_name:(d&&d.owner_name)||'Supernerd', position:(d&&d.owner_position)||'', company_id:(d&&d.owner_company_id)||'supernerd', avatar_url:(d&&d.owner_avatar_url)||null, phone:(d&&d.owner_phone)||null, timezone:(d&&d.owner_timezone)||null };
    AUTH.canApprove=true;
    return;
  }
  try{ var r=await sb.from('profiles').select('*').eq('id',AUTH.user.id).maybeSingle(); AUTH.profile=r.data||null; }catch(e){ AUTH.profile=null; }
  AUTH.canApprove=false;
  try{ var iv=await sb.from('invites').select('can_approve').eq('review_slug',CONFIG.REVIEW_SLUG).eq('email',em).maybeSingle(); AUTH.canApprove=!!(iv&&iv.data&&iv.data.can_approve); }catch(e){}
}
function gateOverlay(){ if(document.getElementById('authGate')||!document.body) return; var g=document.createElement('div'); g.id='authGate'; g.setAttribute('style','position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:#050505;color:#8a8a86;font-family:var(--mono),monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase'); g.textContent='Verifying access\u2026'; document.body.appendChild(g); }
function gateClear(){ var g=document.getElementById('authGate'); if(g) g.remove(); }
function gateRedirect(){ try{ var nxt=encodeURIComponent(location.pathname+location.search+location.hash); location.replace('/portal?next='+nxt); }catch(e){ location.replace('/portal'); } }
function urlHasAuth(){ var s=(location.hash||'')+(location.search||''); return /access_token=|refresh_token=|[?&]code=|type=(magiclink|recovery|signup|invite)/.test(s); }
async function authInit(){
  gateOverlay();
  try{ var s=await sb.auth.getSession(); AUTH.user=(s&&s.data&&s.data.session)?s.data.session.user:null; if(AUTH.user) await loadProfile(); }catch(e){}
  if(!AUTH.user){
    if(!urlHasAuth()){ gateRedirect(); return; }       // logged out, no pending sign-in -> bounce to login
    setTimeout(function(){ if(!AUTH.user) gateRedirect(); }, 4500); // sign-in didn't complete -> bounce
  } else { gateClear(); }
  if(AUTH.profile && AUTH.profile.owner) ADMIN=true;
  await visLoad(); await porderLoad();
  AUTH.ready=true; renderAuthSlot(); startPresence(); try{ route(); }catch(e){}
  sb.auth.onAuthStateChange(function(ev, session){
    AUTH.user = session ? session.user : null;
    setTimeout(async function(){
      if(AUTH.user){ await loadProfile(); gateClear(); } else { AUTH.profile=null; }
      if(AUTH.profile && AUTH.profile.owner) ADMIN=true;
      renderAuthSlot(); startPresence();
      if(AUTH.user && !AUTH.profile && !(typeof ADMIN!=='undefined' && ADMIN)) openOnboarding();
      try{ route(); }catch(e){}
      if(currentFolder==='partners') loadPartners();
    },0);
  });
