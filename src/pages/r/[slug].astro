/* v12 — onboarding company logo upload */
.logo-row{display:flex;align-items:center;gap:13px}
.logo-prev{width:54px;height:54px;flex:0 0 auto;border-radius:11px;border:1.5px dashed var(--line);background-color:#0c0d0e;background-size:contain;background-repeat:no-repeat;background-position:center;background-origin:content-box;padding:7px;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:18px}
.logo-up{background:rgba(236,236,234,.06);border:1px solid var(--line);color:var(--bone);font-family:var(--mono);font-size:11px;letter-spacing:.04em;border-radius:10px;padding:10px 15px;cursor:pointer;transition:border-color .15s,background .15s}
.logo-up:hover{border-color:rgba(186,192,30,.55);color:var(--green);background:rgba(186,192,30,.08)}

/* ---- calendar: add-event button + event editor (v10) ---- */
.cal-addev{font-family:var(--mono);font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:#0c0d0e;background:var(--green);border:0;border-radius:9px;padding:8px 13px;font-weight:800;cursor:pointer;margin-right:10px;transition:background .15s var(--ease-out)}
.cal-addev:hover{background:var(--green-hi)}
.cev-card{width:min(440px,94vw);background:linear-gradient(168deg,#161719,#0d0e10);border:1px solid var(--hair);border-radius:18px;padding:22px 22px 18px;box-shadow:0 40px 120px -40px #000}
.cev-h{display:flex;align-items:center;justify-content:space-between;font-family:var(--disp);font-size:19px;font-weight:700;color:var(--bone);margin-bottom:14px}
.cev-x{background:none;border:0;color:var(--dim);font-size:22px;line-height:1;cursor:pointer;padding:0 2px}
.cev-x:hover{color:var(--bone)}
.cev-l{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);margin:12px 0 5px}
.cev-in{width:100%;box-sizing:border-box;background:#0b0c0d;border:1px solid var(--hair);border-radius:10px;padding:10px 12px;color:var(--bone);font-family:var(--disp);font-size:14px;outline:none}
.cev-in:focus{border-color:rgba(186,192,30,.5)}
.cev-area{min-height:64px;resize:vertical;font-family:var(--disp)}
.cev-row{display:flex;gap:12px}.cev-row>div{flex:1;min-width:0}
.cev-foot{display:flex;align-items:center;justify-content:space-between;margin-top:18px}
.cev-actions{display:flex;gap:9px}
.cev-save{background:var(--green);color:#0c0d0e;border:0;border-radius:10px;padding:10px 18px;font-weight:800;font-size:13px;cursor:pointer}
.cev-save:hover{background:var(--green-hi)}
.cev-cancel{background:transparent;color:var(--dim);border:1px solid var(--hair);border-radius:10px;padding:10px 16px;font-size:13px;cursor:pointer}
.cev-cancel:hover{color:var(--bone)}
.cev-del{background:transparent;color:#e5736f;border:1px solid rgba(229,72,77,.35);border-radius:10px;padding:10px 16px;font-size:13px;cursor:pointer}
.cev-del:hover{background:rgba(229,72,77,.12)}
.cev-msg{font-family:var(--mono);font-size:11px;color:#e5736f;margin-top:10px;min-height:14px}

/* ===================== v11/v16: review layout — title row aligned, draggable divider ===================== */
.ver-layout{display:grid;grid-template-columns:minmax(0,calc(var(--lp,64%) - 14px)) 14px minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);align-items:start}
.ver-body{display:contents}
.ver-head-l{grid-column:1;grid-row:1;display:flex;align-items:center;gap:12px;flex-wrap:wrap;min-width:0;padding-bottom:16px}
.ver-head-r{grid-column:3;grid-row:1;min-width:0;padding-bottom:16px}
.ver-head-r .notes-bar{margin:0}
.ver-main{grid-column:1;grid-row:2;min-width:0}
.ver-main .composer{margin-top:18px}
.ver-side{grid-column:3;grid-row:2;min-width:0;position:sticky;top:96px}
.ver-side .notes-list{max-height:calc(100vh - 210px);overflow-y:auto;padding-right:6px}
.ver-side .notes-list::-webkit-scrollbar{width:8px}
.ver-side .notes-list::-webkit-scrollbar-thumb{background:var(--hair);border-radius:8px}
/* the divider you can drag */
.ver-gutter{grid-column:2;grid-row:1 / span 2;align-self:stretch;cursor:col-resize;position:relative;touch-action:none}
.ver-gutter .vg-grip{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--hair);transform:translateX(-50%);transition:background .12s,width .12s}
.ver-gutter:hover .vg-grip,.ver-gutter.drag .vg-grip{background:var(--green);width:2px}
@media (max-width:900px){
  .ver-layout{display:flex;flex-direction:column;gap:14px}
  .ver-gutter{display:none}
  .ver-head-l{order:1;padding-bottom:0}
  .ver-main{order:2}
  .ver-head-r{order:3;padding-bottom:0}
  .ver-side{order:4;position:static;top:auto}
  .ver-side .notes-list{max-height:none;overflow:visible;padding-right:0}
  .ver-main .composer{margin-top:14px}
}

/* partner card: rectangular, wide-capable company logo + bigger name */
.pc-logo{display:inline-flex;align-items:center;height:34px;max-width:160px;flex:0 0 auto}
.pc-logo img{height:34px;max-width:160px;width:auto;object-fit:contain;display:block}
.pc-company{font-size:13px}

