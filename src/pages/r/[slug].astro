<body>
<header>
  <div class="wrap head-row">
    <a class="logo-link" href="https://supernerd.tv" target="_blank" rel="noopener" title="Visit supernerd.tv"><img class="logo-img" src="/email-logo.png" alt="Supernerd"></a>
    <img class="cobrand" id="cobrand" alt="" hidden>
    <div class="head-meta"><div class="eyebrow">Review</div><div class="co" id="coName" onclick="location.hash=''" title="Back to projects">—</div></div>
  </div>
</header>

<main class="wrap" id="app"></main>

<div id="overlay" onclick="if(event.target===this)closeOverlay()"><button class="ov-close" onclick="closeOverlay()" aria-label="Close">×</button><div class="ov-inner"></div></div>

<footer><div class="wrap"><a class="mk" href="https://supernerd.tv" target="_blank" rel="noopener">Crafted by <b>Supernerd</b></a></div></footer>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline src="https://embed.cloudflarestream.com/embed/sdk.latest.js"></script>
<script is:inline define:vars={{ data, SUPABASE_URL, SUPABASE_KEY, STREAM_CUSTOMER, ADMIN_KEY }}>
const CONFIG = Object.assign({ SUPABASE_URL, SUPABASE_KEY, STREAM_CUSTOMER, ADMIN_KEY }, data);
const sb = supabase.createClient(CONFIG.SUPABASE_URL, CONFIG.SUPABASE_KEY);
const ADMIN = !!CONFIG.ADMIN_KEY && new URLSearchParams(location.search).get('admin') === CONFIG.ADMIN_KEY;
let players = {};
const NAME_KEY = 'sn_review_name';
const getName = () => { try { return localStorage.getItem(NAME_KEY) || ''; } catch (e) { return ''; } };
const setName = (n) => { try { localStorage.setItem(NAME_KEY, n); } catch (e) {} };

function parseTimecode(tc){ if(!tc) return null; const parts=String(tc).trim().split(':').map(p=>parseInt(p,10)); if(parts.some(isNaN)) return null; let s=0; for(const p of parts){ s=s*60+p; } return s; }
function relTime(iso){ const d=(Date.now()-new Date(iso).getTime())/1000; if(d<60) return 'just now'; if(d<3600) return Math.floor(d/60)+'m ago'; if(d<86400) return Math.floor(d/3600)+'h ago'; return Math.floor(d/86400)+'d ago'; }
function fmtTime(iso){ const d=new Date(iso); return d.toLocaleString(undefined,{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}); }
function fmtDate(iso){ if(!iso) return ''; let d; const m=String(iso).match(/^(\d{4})-(\d{2})-(\d{2})$/); if(m){ d=new Date(+m[1], +m[2]-1, +m[3], 12); } else { d=new Date(iso); } if(isNaN(d.getTime())) return ''; return d.toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}); }
function esc(s){ const d=document.createElement('div'); d.textContent=(s==null?'':s); return d.innerHTML; }
function itemTitle(it){ return it.type==='video' ? (it.label||'Video') : (it.title || itemFallback(it)); }
function itemFallback(it){ return it.type==='audio' ? 'Audio' : (it.type==='file' ? 'File' : 'Untitled'); }
function downloadHref(it){ if(it.download_url) return it.download_url; if(it.type==='video' && it.stream_uid) return 'https://'+CONFIG.STREAM_CUSTOMER+'/'+it.stream_uid+'/downloads/default.mp4'; return it.src || ''; }

function seek(id, seconds){ const p=players[id]; if(p){ try{ p.currentTime=seconds; p.play(); const st=document.getElementById('stage-'+id); if(st) window.scrollTo({top:st.getBoundingClientRect().top+window.scrollY-86, behavior:'smooth'}); }catch(e){} } }

function chrome(){ document.getElementById('coName').textContent = CONFIG.COMPANY.name; if(CONFIG.COMPANY.logo){ const c=document.getElementById('cobrand'); c.src=CONFIG.COMPANY.logo; c.hidden=false; } }

/* ---------- overlay / lightbox ---------- */
function openOverlay(html, wide){ const o=document.getElementById('overlay'); o.querySelector('.ov-inner').innerHTML=html; o.classList.toggle('wide', !!wide); o.classList.add('show'); document.body.style.overflow='hidden'; }
function closeOverlay(){ const o=document.getElementById('overlay'); o.classList.remove('show'); o.querySelector('.ov-inner').innerHTML=''; document.body.style.overflow=''; }
function lightboxImage(src, cap){ openOverlay('<img class="ov-img" src="'+esc(src)+'" alt="'+esc(cap||'')+'">' + (cap ? '<div class="ov-cap">'+esc(cap)+'</div>' : '')); }
function openArchived(projId, secId, itemId){
  const proj=CONFIG.PROJECTS.find(p=>p.id===projId); if(!proj) return;
  const sec=proj.sections.find(s=>s.id===secId); if(!sec) return;
  const it=sec.archive.find(x=>x.id===itemId) || sec.current.find(x=>x.id===itemId); if(!it) return;
  openOverlay('<div class="ov-deliv">'+delivHTML(proj,sec,it)+'</div>', true);
  wireItem(proj,sec,it);
}

/* ---------- routing ---------- */
function route(){
  const h=new URLSearchParams(location.hash.replace(/^#/,'')); const p=h.get('p'), s=h.get('s');
  players={}; closeOverlay();
  if(!p){ renderLanding(); return; }
  const proj=CONFIG.PROJECTS.find(x=>x.id===p); if(!proj){ renderLanding(); return; }
  const sec=proj.sections.find(x=>x.id===s) || proj.sections[0];
  if(!sec){ renderLanding(); return; }
  renderProject(proj, sec);
}

/* ---------- landing ---------- */
function renderLanding(){
  const app=document.getElementById('app');
  const cards=CONFIG.PROJECTS.map(p=>{
    const items=p.sections.reduce((n,sec)=>n+sec.current.length+sec.archive.length,0);
    return '<a class="card" href="#p='+encodeURIComponent(p.id)+'" tabindex="0"><div class="c-eye">Project</div><h3>'+esc(p.title)+'</h3><div class="c-tag">'+esc(p.tagline||'')+'</div><div class="c-foot"><span class="c-count">'+p.sections.length+' sections · '+items+' item'+(items===1?'':'s')+'</span><span class="c-go">Open →</span></div></a>';
  }).join('');
  app.innerHTML='<section class="landing"><div class="eyebrow">Client review</div><h1 class="co-name">'+esc(CONFIG.COMPANY.name)+'</h1><p class="lead">Open a project to review its work. Each section holds its own deliverables, and every item has its own notes — leave feedback right under what you are looking at.</p><div class="grid">'+(cards||'<p class="sec-empty">No projects yet.</p>')+'</div></section>';
}

/* ---------- project view ---------- */
function renderProject(proj, sec){
  const app=document.getElementById('app');
  const nav=proj.sections.map((s,i)=>'<a href="#p='+encodeURIComponent(proj.id)+'&s='+encodeURIComponent(s.id)+'" class="'+(s.id===sec.id?'active':'')+'"><span class="n-num">'+String(i+1).padStart(2,'0')+'</span><span class="n-name">'+esc(s.name)+'</span><span class="n-ct">'+((s.current.length+s.archive.length)||'')+'</span></a>').join('');

  const adminHTML = ADMIN ? adminStrip(proj,sec) : '';
  const archiveHTML = sec.archive.length ? archivePanel(proj,sec) : '';
  const currentHTML = sec.current.length
    ? sec.current.map(it=>delivHTML(proj,sec,it)).join('')
    : (sec.archive.length ? '<div class="sec-empty">No current items — everything here is archived. Open the archive above.</div>' : '<div class="sec-empty">Nothing in '+esc(sec.name)+' yet.</div>');

  app.innerHTML='<div class="pv"><aside class="side"><a class="back" href="#">← '+esc(CONFIG.COMPANY.name)+'</a><h2 class="pv-title">'+esc(proj.title)+'</h2><nav class="nav">'+nav+'</nav></aside><div class="mainsec"><div class="main-head"><div class="eyebrow">'+esc(proj.title)+'</div><h2>'+esc(sec.name)+'</h2></div>'+adminHTML+archiveHTML+currentHTML+'</div></div>';

  sec.current.forEach(it=>wireItem(proj,sec,it));
  if(ADMIN){ const ab=document.getElementById('ann-btn-'+sec.id); if(ab) ab.addEventListener('click', ()=>announce(proj.id,sec.id)); }
}

/* ---------- archive panel ---------- */
function archivePanel(proj, sec){
  const cards=sec.archive.map(it=>{
    let thumb='';
    if(it.type==='image') thumb=it.src||'';
    else if(it.type==='video' && it.stream_uid) thumb='https://'+CONFIG.STREAM_CUSTOMER+'/'+it.stream_uid+'/thumbnails/thumbnail.jpg';
    const thumbHTML = thumb ? '<img src="'+esc(thumb)+'" alt="">' : '<div class="ar-glyph">'+(it.type==='audio'?'♪':'⤓')+'</div>';
    const ver = (it.type==='video' && it.version) ? ' · '+esc(it.version) : '';
    return '<button class="ar-card" onclick="openArchived(\''+proj.id+'\',\''+sec.id+'\',\''+it.id+'\')"><div class="ar-thumb">'+thumbHTML+'</div><div class="ar-meta"><div class="ar-title">'+esc(itemTitle(it))+ver+'</div><div class="ar-date">'+esc(fmtDate(it.date))+'</div></div></button>';
  }).join('');
  return '<div class="archive"><button class="archive-toggle" onclick="this.parentElement.classList.toggle(\'open\')"><span class="ar-ic">⌖</span> Archive — '+sec.archive.length+' older version'+(sec.archive.length===1?'':'s')+' <span class="ar-caret">▾</span></button><div class="archive-row">'+cards+'</div></div>';
}

/* ---------- a single deliverable ---------- */
function mediaHTML(it){
  if(it.type==='video' && it.stream_uid){
    return '<div class="stage" id="stage-'+it.id+'"><iframe id="if-'+it.id+'" src="https://'+CONFIG.STREAM_CUSTOMER+'/'+it.stream_uid+'/iframe" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;" allowfullscreen></iframe></div>';
  }
  if(it.type==='image' && it.src){
    return '<div class="stage is-image" id="stage-'+it.id+'"><img src="'+esc(it.src)+'" alt="'+esc(itemTitle(it))+'" title="Click to enlarge" onclick="lightboxImage(\''+esc(it.src)+'\',\''+esc(itemTitle(it))+'\')"></div>';
  }
  if(it.type==='audio' && (it.src||it.download_url)){
    return '<div class="stage is-audio" id="stage-'+it.id+'"><audio controls src="'+esc(it.src||it.download_url)+'"></audio></div>';
  }
  if(it.type==='file'){
    return '<div class="stage is-file" id="stage-'+it.id+'"><div class="file-card"><div class="file-ic">⤓</div><div class="file-name">'+esc(itemTitle(it))+'</div></div></div>';
  }
  const need = it.type==='video' ? 'a Stream video ID' : (it.type==='image' ? 'an image' : 'a file URL');
  return '<div class="stage '+(it.type==='image'?'is-image':'')+'" id="stage-'+it.id+'"><div class="ph">Add '+need+' for "'+esc(itemTitle(it))+'".</div></div>';
}

function delivHTML(proj, sec, it){
  const ver = (it.type==='video' && it.version) ? '<span class="deliv-ver">'+esc(it.version)+'</span>' : '';
  const date = it.date ? '<span class="deliv-date">'+esc(fmtDate(it.date))+'</span>' : '';
  const dl = downloadHref(it);
  const dlBar = dl ? '<div class="dl-bar"><a class="dl-btn" href="'+esc(dl)+'" download target="_blank" rel="noopener">⤓ Download</a></div>' : '';
  const tcField = it.type==='video' ? '<div class="field f-tc"><label>Timecode</label><input id="tc-'+it.id+'" placeholder="00:00"></div>' : '';
  return '<section class="deliv">'
    + '<div class="deliv-head"><span class="deliv-title">'+esc(itemTitle(it))+'</span>'+ver+'<span class="deliv-kind">'+it.type+'</span>'+date+'</div>'
    + mediaHTML(it)
    + dlBar
    + '<div class="notes"><div class="notes-bar"><h3>Notes</h3><span class="count" id="count-'+it.id+'"></span></div>'
    + '<div id="notes-'+it.id+'"><div class="empty">Loading notes…</div></div>'
    + '<div class="composer"><div class="row"><div class="field f-name"><label>Your name</label><input id="name-'+it.id+'" placeholder="e.g. Margot" value="'+esc(getName())+'"></div>'+tcField+'</div>'
    + '<div class="field"><label>Note</label><textarea id="body-'+it.id+'" placeholder="What should change, or what is working?"></textarea></div>'
    + '<div class="composer-foot"><button class="post" id="post-'+it.id+'" disabled>Post note</button><span class="msg" id="msg-'+it.id+'"></span></div></div></div>'
    + '</section>';
}

function wireItem(proj, sec, it){
  if(it.type==='video' && it.stream_uid && window.Stream){ try{ players[it.id]=Stream(document.getElementById('if-'+it.id)); }catch(e){} }
  const btn=document.getElementById('post-'+it.id);
  if(btn){
    btn.addEventListener('click', ()=>postNote(proj,sec,it));
    const nEl=document.getElementById('name-'+it.id), bEl=document.getElementById('body-'+it.id);
    const gate=()=>{ btn.disabled = !((nEl.value||'').trim() && (bEl.value||'').trim()); };
    nEl.addEventListener('input',gate); bEl.addEventListener('input',gate); gate();
  }
  loadNotes(proj,sec,it);
}

function assetId(proj, sec, it){ return proj.id+':'+sec.id+':'+it.id; }

async function loadNotes(proj, sec, it){
  const box=document.getElementById('notes-'+it.id); if(!box) return;
  try{
    const { data, error } = await sb.from('comments').select('*').eq('review_slug', CONFIG.REVIEW_SLUG).eq('asset_id', assetId(proj,sec,it)).order('created_at', { ascending:true });
    if(error) throw error;
    const ct=document.getElementById('count-'+it.id); if(ct) ct.textContent=data.length||'';
    if(!data.length){ box.innerHTML='<div class="empty">No notes yet. Add the first one below.</div>'; return; }
    box.innerHTML=data.map(c=>{
      const secs=parseTimecode(c.timecode);
      const canSeek=secs!=null && players[it.id];
      const tc=c.timecode ? '<button class="tc '+(canSeek?'':'static')+'" '+(canSeek?'onclick="seek(\''+it.id+'\','+secs+')"':'disabled')+'>'+esc(c.timecode)+'</button>' : '';
      return '<div class="note"><div class="ava">'+esc((c.author_name||'?').trim().charAt(0)||'?')+'</div><div class="note-main"><div class="note-head"><span class="note-name">'+esc(c.author_name||'Anonymous')+'</span>'+tc+'<span class="note-time" title="'+esc(relTime(c.created_at))+'">'+esc(fmtTime(c.created_at))+'</span></div><div class="note-body">'+esc(c.body)+'</div></div></div>';
    }).join('');
  }catch(e){
    console.error('load notes failed', e);
    box.innerHTML='<div class="empty">Could not load notes. Refresh the page to try again.</div>';
  }
}

async function postNote(proj, sec, it){
  const nameEl=document.getElementById('name-'+it.id), tcEl=document.getElementById('tc-'+it.id), bodyEl=document.getElementById('body-'+it.id);
  const msg=document.getElementById('msg-'+it.id), btn=document.getElementById('post-'+it.id);
  const name=(nameEl.value||'').trim(), tc=(tcEl?tcEl.value:'').trim(), body=(bodyEl.value||'').trim();
  msg.className='msg'; msg.textContent='';
  if(!name){ msg.className='msg err'; msg.textContent='Add your name first.'; nameEl.focus(); return; }
  if(!body){ msg.className='msg err'; msg.textContent='Write a note before posting.'; bodyEl.focus(); return; }
  btn.disabled=true; btn.textContent='Posting…';
  try{
    const { error } = await sb.from('comments').insert({ review_slug:CONFIG.REVIEW_SLUG, asset_id:assetId(proj,sec,it), author_name:name, timecode:tc||null, body:body });
    if(error) throw error;
    setName(name); bodyEl.value=''; if(tcEl) tcEl.value='';
    await loadNotes(proj,sec,it);
    msg.className='msg'; msg.textContent='Posted.'; setTimeout(()=>{ msg.textContent=''; },2500);
  }catch(e){
    console.error('post failed', e);
    msg.className='msg err'; msg.textContent='Could not post that note. Check your connection and try again.';
  }finally{ btn.disabled=false; btn.textContent='Post note'; }
}

function adminStrip(proj, sec){
  return '<div class="admin-strip"><span class="admin-tag">Admin</span><input id="ann-msg-'+sec.id+'" class="admin-input" placeholder="Optional message — e.g. \'Animatic v2 is up for review\'"><button class="admin-btn" id="ann-btn-'+sec.id+'">Notify team · '+esc(sec.name)+' ready</button><span class="admin-msg" id="ann-status-'+sec.id+'"></span></div>';
}
async function announce(projId, secId){
  const proj=CONFIG.PROJECTS.find(p=>p.id===projId); if(!proj) return;
  const sec=proj.sections.find(s=>s.id===secId); if(!sec) return;
  const btn=document.getElementById('ann-btn-'+secId), st=document.getElementById('ann-status-'+secId), inp=document.getElementById('ann-msg-'+secId);
  const message=((inp&&inp.value)||'').trim();
  btn.disabled=true; const orig=btn.textContent; btn.textContent='Sending…'; st.className='admin-msg'; st.textContent='';
  try{
    const { error } = await sb.from('announcements').insert({ review_slug:CONFIG.REVIEW_SLUG, project:proj.id, section:sec.id, message:message||null });
    if(error) throw error;
    if(inp) inp.value=''; st.className='admin-msg ok'; st.textContent='Team notified.'; setTimeout(()=>{ if(st) st.textContent=''; },3000);
  }catch(e){ console.error('announce failed', e); st.className='admin-msg err'; st.textContent='Could not send — is the announcements table set up?'; }
  finally{ btn.disabled=false; btn.textContent=orig; }
}

document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') closeOverlay(); });
chrome();
window.addEventListener('hashchange', route);
route();

</script>
</body>
</html>
