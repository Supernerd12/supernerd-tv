async function calEvSave(){
  var msg=document.getElementById('cevMsg');
  var title=(document.getElementById('cevTitle').value||'').trim();
  var date=document.getElementById('cevDate').value;
  var type=document.getElementById('cevType').value;
  var kind=document.getElementById('cevKind').value;
  var time=document.getElementById('cevTime').value||null;
  var proj=(document.getElementById('cevProj').value||'').trim()||CAL.projId||'project';
  var notes=(document.getElementById('cevNotes').value||'').trim()||null;
  if(!title){ msg.textContent='Add a title.'; return; }
  if(!date){ msg.textContent='Pick a date.'; return; }
  var rec={ review_slug:CONFIG.REVIEW_SLUG, project_id:proj, date:date, type:type, title:title, kind:kind, time:time, notes:notes };
  msg.textContent='Saving\u2026';
  try{
    var res = (CAL.editEv && CAL.editEv.id)
      ? await sb.from('calendar_events').update(rec).eq('id',CAL.editEv.id)
      : await sb.from('calendar_events').insert(rec);
    if(res && res.error){ msg.textContent=(res.error.message||'Could not save')+' \u2014 run calendar-write.sql in Supabase.'; return; }
  }catch(e){ msg.textContent='Could not save.'; return; }
  calEvClose(); await calReloadEv();
}
async function calEvDelete(){
  if(!(CAL.editEv && CAL.editEv.id)) return;
  if(!confirm('Delete this event? This can\u2019t be undone.')) return;
  try{ var res=await sb.from('calendar_events').delete().eq('id',CAL.editEv.id); if(res&&res.error){ var m=document.getElementById('cevMsg'); if(m) m.textContent=res.error.message||'Could not delete.'; return; } }catch(e){ return; }
  calEvClose(); await calReloadEv();
}
function calWire(){
  var c=document.getElementById('calmount'); if(!c) return;
  c.querySelectorAll('.seg button').forEach(function(b){b.onclick=function(){CAL.view=b.dataset.cv;calRender();};});
  c.querySelectorAll('.cal-chip').forEach(function(b){b.onclick=function(){CAL.filter=b.dataset.cf;calRender();};});
  var tb=c.querySelector('[data-ctoday]'); if(tb) tb.onclick=function(){CAL.cursor=calToday();CAL.day=calToday();calRender();};
  c.querySelectorAll('[data-cnav]').forEach(function(b){b.onclick=function(){calNav(+b.dataset.cnav);};});
  c.querySelectorAll('.cell').forEach(function(el){el.onclick=function(){CAL.day=calParse(el.dataset.calday);CAL.view='day';CAL.cursor=calParse(el.dataset.calday);calRender();};});
  c.querySelectorAll('[data-calgoday]').forEach(function(el){el.onclick=function(){CAL.day=calParse(el.dataset.calgoday);CAL.cursor=calParse(el.dataset.calgoday);CAL.view='day';calRender();};});
  c.querySelectorAll('.cal-ev,.popcell').forEach(function(el){el.addEventListener('mouseenter',function(){calShowPop(el);});el.addEventListener('mouseleave',calHidePop);el.addEventListener('mousemove',calPosPop);});
  c.querySelectorAll('[data-cedit]').forEach(function(b){b.onclick=function(){CAL.editing=!CAL.editing;CAL.pendingDel=null;calRender();};});
  c.querySelectorAll('.etrow[data-ct] [data-ccc]').forEach(function(inp){inp.onchange=function(){var t=inp.closest('.etrow').dataset.ct;if(CAL.TYPES[t]){CAL.TYPES[t].c=inp.value;calUpsertType(t);calRender();}};});
  c.querySelectorAll('.etrow[data-ct] [data-cnn]').forEach(function(inp){inp.onchange=function(){var t=inp.closest('.etrow').dataset.ct;if(CAL.TYPES[t]){CAL.TYPES[t].l=inp.value;calUpsertType(t);calRender();}};});
  function calDel(t){ delete CAL.TYPES[t]; var ix=CAL.ORDER.indexOf(t); if(ix>-1)CAL.ORDER.splice(ix,1); CAL.pendingDel=null; calDeleteTypeDB(t); calRender(); }
  c.querySelectorAll('.etdel').forEach(function(b){b.onclick=function(){var t=b.closest('.etrow').dataset.ct;var up=CAL.EV.filter(function(e){return e.type===t&&!calIsPast(e);}).length;if(up>0){CAL.pendingDel=t;calRender();}else{calDel(t);}};});
  c.querySelectorAll('[data-cconfirmdel]').forEach(function(b){b.onclick=function(){calDel(b.dataset.cconfirmdel);};});
  var cc=c.querySelector('[data-ccancel]'); if(cc) cc.onclick=function(){CAL.pendingDel=null;calRender();};
  var nb=c.querySelector('[data-cnew]'); if(nb) nb.onclick=function(){ var dk=(CAL.view==='day'&&CAL.day)?calKey(CAL.day):calTodayK(); calEvOpen(null, dk); };
  if(typeof ADMIN!=='undefined' && ADMIN){
    c.querySelectorAll('.cal-ev').forEach(function(el){ el.addEventListener('click', function(ev){ ev.stopPropagation(); var id=el.dataset.eid; var found=CAL.EV.filter(function(x){return String(x.id)===String(id);})[0]; if(found) calEvOpen(found); }); });
  }
  var ab=c.querySelector('[data-cadd]'); if(ab) ab.onclick=function(){var nm=document.getElementById('calnewN').value.trim(),col=document.getElementById('calnewC').value;if(!nm)return;var slug=nm.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'')||('type'+Date.now());if(CAL.TYPES[slug])slug=slug+'x';CAL.TYPES[slug]={l:nm,c:col};CAL.ORDER.push(slug);calUpsertType(slug);calRender();};
}
async function calLoad(projId){
  CAL.projId=projId; CAL.cursor=calToday(); CAL.cursor.setDate(1); CAL.day=calToday();
  CAL.view='month'; CAL.filter='all'; CAL.editing=false; CAL.pendingDel=null; CAL.TYPES={}; CAL.ORDER=[]; CAL.EV=[];
  try{
    var rt=await sb.from('calendar_types').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).order('sort',{ascending:true});
    var rows=(rt&&rt.data)||[];
    if(rows.length){ rows.forEach(function(r){ CAL.TYPES[r.key]={l:r.label,c:r.color}; CAL.ORDER.push(r.key); }); }
    else { CAL_DEFAULT_TYPES.forEach(function(d){ CAL.TYPES[d[0]]={l:d[1],c:d[2]}; CAL.ORDER.push(d[0]); }); }
  }catch(e){ CAL_DEFAULT_TYPES.forEach(function(d){ CAL.TYPES[d[0]]={l:d[1],c:d[2]}; CAL.ORDER.push(d[0]); }); }
  try{
    var re=await sb.from('calendar_events').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).order('date',{ascending:true});
    CAL.EV=((re&&re.data)||[]).map(function(r){ return { id:r.id, d:r.date, type:r.type, title:r.title, proj:r.project_id||'project', kind:r.kind||'major', time:r.time||'', notes:r.notes||'', frozen:r.frozen_color||null }; });
  }catch(e){ CAL.EV=[]; }
  calRender();
}

