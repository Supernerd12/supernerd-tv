  }

  /* ===================================================================
     v3.2 — visible mesh, brand "+", fullscreen zoom, collapsible feedback
     =================================================================== */
  /* mesh fully ON-screen + stronger, darker center for text legibility */
  body::before{
    background:
      radial-gradient(900px 620px at 16% 14%, rgba(186,192,30,.20), transparent 72%),
      radial-gradient(820px 600px at 88% 26%, rgba(186,192,30,.13), transparent 72%),
      radial-gradient(1000px 720px at 50% 110%, rgba(150,170,40,.17), transparent 70%),
      radial-gradient(120% 90% at 50% 42%, transparent 40%, rgba(5,5,5,.55) 100%);}
  #bg-art{opacity:.9}

  /* header lockup: Supernerd + [company logo] */
  .head-row{gap:20px}
  .brand-plus{font-family:var(--disp); font-weight:800; font-size:24px; line-height:1; color:#fff; opacity:.92; margin:0 2px}
  .cobrand{height:30px; width:auto; max-width:170px; object-fit:contain}
  @media (max-width:560px){ .brand-plus{font-size:19px} .cobrand{height:24px} }

  /* fullscreen image: rises up + scales as the backdrop darkens with ease */
  #overlay.show{animation:ovIn .34s var(--ease-out) both}
  @keyframes ovIn{from{background:rgba(3,3,3,0); -webkit-backdrop-filter:blur(0); backdrop-filter:blur(0)} to{background:rgba(3,3,3,.92); -webkit-backdrop-filter:blur(7px); backdrop-filter:blur(7px)}}
  .ov-img{animation:imgZoom .46s var(--ease-out) both; transform-origin:center}
  @keyframes imgZoom{from{opacity:0; transform:translateY(18px) scale(.9); filter:blur(8px)} to{opacity:1; transform:translateY(0) scale(1); filter:blur(0)}}

  /* collapsible feedback — fans latest -> oldest on expand */
  .notes-toggle{margin-left:auto; font-family:var(--mono); font-size:11px; letter-spacing:.04em; color:var(--dim); background:none; border:1px solid var(--line); border-radius:7px; padding:4px 11px; cursor:pointer; transition:color .15s var(--ease-out), border-color .15s var(--ease-out), transform .14s var(--ease-out)}
  .notes-toggle:hover{color:var(--green); border-color:rgba(186,192,30,.4)}
  .notes-toggle:active{transform:scale(.96)}
  .notes-list{overflow:hidden; max-height:7000px; opacity:1; transition:max-height .45s var(--ease-io), opacity .3s var(--ease-out)}
  .notes-list.collapsed{max-height:0; opacity:0}
  .notes-list.fan .note{animation:fanIn .5s var(--ease-out) both}
  .notes-list.fan .note:nth-child(1){animation-delay:0s}
  .notes-list.fan .note:nth-child(2){animation-delay:.05s}
  .notes-list.fan .note:nth-child(3){animation-delay:.1s}
  .notes-list.fan .note:nth-child(4){animation-delay:.15s}
  .notes-list.fan .note:nth-child(5){animation-delay:.2s}
  .notes-list.fan .note:nth-child(6){animation-delay:.25s}
  .notes-list.fan .note:nth-child(n+7){animation-delay:.3s}
  @keyframes fanIn{from{opacity:0; transform:translateY(-9px) scale(.99); filter:blur(4px)} to{opacity:1; transform:translateY(0) scale(1); filter:blur(0)}}
  @media (prefers-reduced-motion:reduce){ .notes-list.fan .note{animation:none} .ov-img{animation:none} #overlay.show{animation:none; background:rgba(3,3,3,.92)} }
</style>
