  .composer-tools{display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin:4px 0 2px}
  .tool-btn{font-family:var(--mono); font-size:12px; padding:7px 12px; border-radius:7px; border:1px solid var(--line); background:none; color:var(--dim); cursor:pointer; transition:color .12s var(--ease), border-color .12s var(--ease)}
