function parseRecipient(entry, defName){
  entry=(entry||'').trim(); if(!entry) return null;
  let m=entry.match(/^(.*?)[<(]\s*([^<>()\s]+@[^<>()\s]+\.[^<>()\s]+)\s*[>)]?$/);
  if(m && m[2]){ const nm=m[1].replace(/["']/g,'').trim(); return { email:m[2].trim(), name: nm||defName||null }; }
  m=entry.match(/([^\s,;<>]+@[^\s,;<>]+\.[^\s,;<>]+)/);
  if(m){ const nm=entry.replace(m[1],'').replace(/[<>"']/g,'').trim(); return { email:m[1], name: nm||defName||null }; }
  return null;
}
async function sendOnboarding(clientKey){
  const nameEl=document.getElementById('ob-name'), emEl=document.getElementById('ob-emails'), msg=document.getElementById('ob-msg'), btn=document.getElementById('ob-send');
  const defName=(nameEl&&nameEl.value||'').trim();
  const entries=((emEl&&emEl.value)||'').split(/[\n;,]+/).map(s=>s.trim()).filter(Boolean);
  const parsed=entries.map(e=>parseRecipient(e, defName)).filter(r=>r && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(r.email));
  msg.className='msg'; msg.textContent='';
  if(!parsed.length){ msg.className='msg err'; msg.textContent='Add at least one valid email address.'; return; }
  var pk=[].slice.call(document.querySelectorAll('.ob-proj-cb:checked')).map(function(c){return c.value;});
  if(!pk.length){ msg.className='msg err'; msg.textContent='Tick at least one project to grant access to.'; return; }
  btn.disabled=true; btn.textContent='Sending…';
  try{
    const rows=parsed.map(r=>({ email:r.email, name:r.name||null, review_slug:CONFIG.REVIEW_SLUG, project_keys:pk }));
    const { error } = await sb.from('invites').upsert(rows, { onConflict:'review_slug,email' });
    if(error) throw error;
    if(emEl) emEl.value=''; if(nameEl) nameEl.value='';
    await loadInvites(); renderOnboardList();
    msg.className='msg'; msg.textContent='Invite sent to '+parsed.length+' '+(parsed.length===1?'person':'people')+'.';
    setTimeout(()=>{ if(msg) msg.textContent=''; },4000);
  }catch(e){ console.error('onboard failed', e); msg.className='msg err'; msg.textContent='Could not send — run onboarding.sql in Supabase first.'; }
  finally{ btn.disabled=false; btn.textContent='Send invite'; }
}

