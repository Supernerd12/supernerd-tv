function nlDatePretty(d){ try{ var x=new Date(d+'T00:00:00'); return x.toLocaleDateString([], {weekday:'short', month:'short', day:'numeric'}); }catch(e){ return d; } }

/* ---------- builder entry ---------- */
async function nlLoad(projId){
  var proj=CONFIG.PROJECTS.find(function(p){return p.id===projId;}); if(!proj) return;
  NL.proj=projId; NL.projObj=proj;
  var m=document.getElementById('nlmount'); if(m) m.innerHTML='<div class="cal-loading">Loading newsletter studio\u2026</div>';
  NL.videos=nlProjVideos(proj);
  NL.members=await nlMembers(proj);
  var draft=null;
  try{ var r=await sb.from('newsletters').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',projId).maybeSingle(); if(r&&r.data&&r.data.data&&r.data.data.title!=null) draft=r.data.data; }catch(e){}
  NL.data = draft ? nlMerge(nlBlank(), draft) : await nlGather(proj);
  if(!NL.data.hero.uid && !NL.data.hero.url && NL.videos[0]){ NL.data.hero.uid=NL.videos[0].uid; NL.data.hero.t=0; }
  NL._heroSig=null;
  nlRender();
}
function nlMerge(base, over){ Object.keys(over||{}).forEach(function(k){ base[k]=over[k]; }); base.titleGreen=base.titleGreen||{}; base.hero=base.hero||{uid:'',t:0,url:'',composed:''}; base.latest=base.latest||{label:'',url:''}; base.review=base.review||{date:'',label:''}; ['happened','eyes','milestones','decisions','locked'].forEach(function(k){ if(!Array.isArray(base[k])) base[k]=[]; }); return base; }

/* ---------- collectors ---------- */
function nlV(id){ var e=document.getElementById(id); return e?e.value:''; }
function nlInputs(sel){ var out=[]; document.querySelectorAll(sel).forEach(function(i){ var v=(i.value||'').trim(); if(v) out.push(v); }); return out; }
function nlPairs(rowSel, aSel, bSel, mk, keepIf){ var out=[]; document.querySelectorAll(rowSel).forEach(function(r){ var a=r.querySelector(aSel), b=r.querySelector(bSel); var av=a?(a.value||'').trim():'', bv=b?(b.value||'').trim():''; var o=mk(av,bv); if(keepIf(o)) out.push(o); }); return out; }
function nlCollect(){
  var d=NL.data;
  d.eyebrow=nlV('nlEyebrow'); d.title=nlV('nlTitle'); d.sub=nlV('nlSub');
  d.latest.label=nlV('nlLatLabel'); d.latest.url=nlV('nlLatUrl');
  d.phase=nlV('nlPhase'); d.review.date=nlV('nlRevDate'); d.review.label=nlV('nlRevLabel');
  d.stand=nlV('nlStand');
  d.happened=nlInputs('.nl-hap');
  d.eyes=nlPairs('.nl-eye-row','.nl-eye-t','.nl-eye-u',function(t,u){return {text:t,url:u};},function(o){return o.text;});
  d.milestones=nlPairs('.nl-ms-row','.nl-ms-t','.nl-ms-g',function(t,g){return {text:t,tag:g};},function(o){return o.text;});
  d.decisions=nlInputs('.nl-dec');
  d.locked=nlInputs('.nl-lock');
}

/* ---------- render ---------- */
function nlTitleChips(){
  var d=NL.data; var words=(d.title||'').split(/\s+/).filter(Boolean);
  if(!words.length) return '<span class="nl-chip-hint">Type a title above, then tap words to make them acid-green.</span>';
