/* ---------- timezone options for onboarding ---------- */
function caTzOptions(cur){
  var detected=''; try{ detected=Intl.DateTimeFormat().resolvedOptions().timeZone||''; }catch(e){}
  var sel=cur||detected||'America/New_York';
  var list=[
    ['America/New_York','Eastern \u2014 New York'],['America/Chicago','Central \u2014 Chicago'],
    ['America/Denver','Mountain \u2014 Denver'],['America/Phoenix','Arizona \u2014 Phoenix'],
    ['America/Los_Angeles','Pacific \u2014 Los Angeles'],['America/Anchorage','Alaska \u2014 Anchorage'],
    ['Pacific/Honolulu','Hawaii \u2014 Honolulu'],['America/Toronto','Toronto'],['America/Mexico_City','Mexico City'],
    ['America/Sao_Paulo','S\u00e3o Paulo'],['Europe/London','London \u2014 GMT/BST'],['Europe/Paris','Paris \u2014 CET'],
    ['Europe/Berlin','Berlin'],['Africa/Lagos','Lagos \u2014 WAT'],['Africa/Johannesburg','Johannesburg'],
    ['Asia/Dubai','Dubai'],['Asia/Kolkata','India \u2014 Kolkata'],['Asia/Singapore','Singapore'],
    ['Asia/Tokyo','Tokyo'],['Australia/Sydney','Sydney']
  ];
  var found=list.some(function(z){return z[0]===sel;}); if(!found && sel){ list.unshift([sel, caTzShort(sel)]); }
  return list.map(function(z){ return '<option value="'+z[0]+'"'+(z[0]===sel?' selected':'')+'>'+esc(z[1])+'</option>'; }).join('');
}

