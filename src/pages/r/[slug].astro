function canvaEmbed(url){
  if(!url) return '';
  url=String(url).trim();
  var m=url.match(/canva\.com\/design\/([^/?#]+)(?:\/([^/?#]+))?/i);
  if(m){ var id=m[1], tok=m[2]||''; return 'https://www.canva.com/design/'+id+(tok?('/'+tok):'')+'/view?embed'; }
  if(/canva\.com/i.test(url)){ return url.split('#')[0].split('?')[0].replace(/\/(edit|view)\/?$/,'/view')+'?embed'; }
  return url;
}
function deckEmbedHTML(row){
  var src=canvaEmbed(row.url);
  if(!src) return '<div class="deck-empty">No link yet.</div>';
  return '<div class="deck-frame"><iframe loading="lazy" src="'+esc(src)+'" allow="fullscreen" allowfullscreen referrerpolicy="no-referrer"></iframe></div>'
    +'<div class="deck-foot"><a class="deck-open" href="'+esc(row.url)+'" target="_blank" rel="noopener">Open in Canva \u2197</a></div>';
}
async function deckLoad(projKey){
  var mount=document.getElementById('deckmount'); if(!mount) return;
  var rows=[];
  try{
    var r=await sb.from('presentations').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',projKey).order('sort',{ascending:true}).order('created_at',{ascending:true});
    if(r.error) throw r.error; rows=r.data||[];
  }catch(e){ console.error('decks load failed', e); mount.innerHTML='<div class="sec-empty">Could not load presentations. Run presentations.sql in Supabase first.</div>'; return; }
  DECKS_CACHE[projKey]=rows;
  var visible = ADMIN ? rows : rows.filter(function(x){ return x.published; });
  var order=[], map={};
  visible.forEach(function(x){ var n=x.name||'Presentation'; if(!map[n]){ map[n]=[]; order.push(n); } map[n].push(x); });
  var addBtn = ADMIN ? '<button class="deck-add" id="deckAdd">+ Add presentation</button>' : '';
  if(!order.length){ mount.innerHTML=addBtn+'<div class="sec-empty">'+(ADMIN?'No presentations yet. Add one with a Canva link.':'No presentations shared yet.')+'</div>'; if(ADMIN){ var b0=document.getElementById('deckAdd'); if(b0) b0.onclick=function(){ deckOpen(projKey,null); }; } return; }
  var html=addBtn+'<div class="deck-list">';
  order.forEach(function(n,gi){
    var vers=map[n].slice().sort(function(a,b){ return String(b.version||'').localeCompare(String(a.version||''),undefined,{numeric:true}); });
    var anyPub=vers.some(function(v){return v.published;});
    var did='deck-'+gi;
    var badge = ADMIN ? (anyPub?'<span class="deck-badge live">LIVE</span>':'<span class="deck-badge hid">HIDDEN</span>') : '';
    var chips = vers.length>1 ? '<div class="deck-vers">'+vers.map(function(v,vi){ return '<button class="deck-vchip'+(vi===0?' on':'')+(ADMIN&&!v.published?' off':'')+'" data-did="'+did+'" data-vid="'+esc(v.id)+'">'+esc(v.version||('v'+(vers.length-vi)))+'</button>'; }).join('')+'</div>' : '';
    var adminRow = ADMIN ? '<div class="deck-admin">'
        +vers.map(function(v){ return '<span class="deck-vrow"><b>'+esc(v.version||'v1')+'</b> <button class="deck-pub'+(v.published?' on':'')+'" data-vid="'+esc(v.id)+'" data-proj="'+esc(projKey)+'">'+(v.published?'Live':'Hidden')+'</button> <button class="deck-edit" data-vid="'+esc(v.id)+'" data-proj="'+esc(projKey)+'">Edit</button> <button class="deck-del" data-vid="'+esc(v.id)+'" data-proj="'+esc(projKey)+'">Delete</button></span>'; }).join('')
        +'<button class="deck-addver" data-name="'+esc(n)+'" data-proj="'+esc(projKey)+'">+ Add version</button></div>' : '';
    html+='<div class="deck-card" id="'+did+'" data-proj="'+esc(projKey)+'">'
      +'<div class="deck-head"><div class="deck-name">'+esc(n)+badge+'</div>'+chips+'</div>'
      +'<div class="deck-body" data-vid="'+esc(vers[0].id)+'">'+deckEmbedHTML(vers[0])+'</div>'
      +adminRow+'</div>';
  });
  html+='</div>';
  mount.innerHTML=html;
  var ab=document.getElementById('deckAdd'); if(ab) ab.onclick=function(){ deckOpen(projKey,null); };
  mount.querySelectorAll('.deck-vchip').forEach(function(ch){ ch.onclick=function(){
    var card=document.getElementById(ch.dataset.did); if(!card) return;
    card.querySelectorAll('.deck-vchip').forEach(function(c){ c.classList.remove('on'); }); ch.classList.add('on');
    var row=(DECKS_CACHE[projKey]||[]).find(function(x){return x.id===ch.dataset.vid;});
    var body=card.querySelector('.deck-body'); if(body && row){ body.dataset.vid=row.id; body.innerHTML=deckEmbedHTML(row); }
  }; });
  if(ADMIN){
    mount.querySelectorAll('.deck-pub').forEach(function(b){ b.onclick=function(){ deckTogglePublish(b.dataset.proj, b.dataset.vid); }; });
    mount.querySelectorAll('.deck-edit').forEach(function(b){ b.onclick=function(){ var row=(DECKS_CACHE[b.dataset.proj]||[]).find(function(x){return x.id===b.dataset.vid;}); deckOpen(b.dataset.proj, row); }; });
    mount.querySelectorAll('.deck-del').forEach(function(b){ b.onclick=function(){ deckDelete(b.dataset.proj, b.dataset.vid); }; });
    mount.querySelectorAll('.deck-addver').forEach(function(b){ b.onclick=function(){ deckOpen(b.dataset.proj, { name:b.dataset.name, _newVersion:true }); }; });
  }
}
