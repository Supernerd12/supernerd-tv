  .pc-foot{display:flex;align-items:center;gap:11px;margin-top:18px;padding-top:16px;border-top:1px solid var(--hair)}
  .logo-mono{width:34px;height:34px;border-radius:7px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#0c0d0e;overflow:hidden}
