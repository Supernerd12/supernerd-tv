  .pin-wrap{position:relative; display:block; line-height:0}
  .pin-layer{position:absolute; inset:0; pointer-events:none}
  .pin-layer.arming{pointer-events:auto; cursor:crosshair}
  .pin-marker{position:absolute; transform:translate(-50%,-50%); width:24px; height:24px; border-radius:50%; background:var(--green); color:var(--ink); font-family:var(--mono); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center; border:2px solid #050505; box-shadow:0 1px 7px rgba(0,0,0,.55); cursor:pointer; pointer-events:auto; z-index:2}
