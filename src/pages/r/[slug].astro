var CAL = { view:'month', cursor:null, filter:'all', day:null, editing:false, pendingDel:null, TYPES:{}, ORDER:[], EV:[], projId:null };
var CAL_DEFAULT_TYPES = [
 ['milestone','Milestone','#8e6fe0'],['meeting','Meeting','#4a90d9'],['deadline','Deadline','#e5484d'],
