/* ---------- onboarding / profile edit ---------- */
async function openOnboarding(prefill){
  if(!AUTH.user) return;
  ppEditTarget = prefill || (AUTH.profile||null);
  ppPendingFile = null;
  ppPendingLogo = null;
  if(!COMPANIES_CACHE || !COMPANIES_CACHE.length){ try{ await loadCompanies(); }catch(e){} }
  var ov=document.getElementById('onbOv');
  if(!ov){ ov=document.createElement('div'); ov.className='onb'; ov.id='onbOv'; ov.innerHTML='<div class="onb-card" id="onbCard"></div>'; document.body.appendChild(ov); }
  ov.classList.add('show');
  document.getElementById('onbCard').innerHTML=onbFormHTML(ppEditTarget);
  wireOnb();
}
function closeOnboarding(){ var ov=document.getElementById('onbOv'); if(ov) ov.classList.remove('show'); }
function onbFormHTML(p){
  var list=(COMPANIES_CACHE||[]);
  var sugg=list.map(function(c){ return '<option value="'+ppEsc(c.name)+'">'; }).join('');
  var curCo=(p&&p.company_id)?ppCompany(p.company_id):null;
  var cname=curCo?(curCo.name||p.company_id||''):'';
  var curLogo=(curCo&&curCo.logo_url)||'';
  var dropStyle=p&&p.avatar_url?'background-image:url('+p.avatar_url+')':'';
  var logoStyle=curLogo?'background-image:url('+curLogo+')':'';
  var nm=p?(p.full_name||''):'', rl=p?(p.position||''):'', ph=p?(p.phone||''):'';
  return '<div class="onb-eyebrow">'+ppEsc(CONFIG.COMPANY.name)+' \u00d7 review</div><div class="onb-title">'+(p?'Edit your profile':'Join the project')+'</div>'
    +'<div class="onb-sub">'+(p?'Update how you appear to the team.':'You\u2019ve been invited to review this project. Tell your team who you are so they can tag you in notes and approvals.')+'</div>'
    +'<div class="onb-av"><div class="drop" id="avDrop" style="'+dropStyle+'">'+(dropStyle?'':'+ Add<br>photo')+'</div><div class="av-tx">A clear headshot helps people<br>recognise you in comments.<br><span style="opacity:.7">Optional \u2014 initials are used otherwise.</span></div><input type="file" id="avFile" accept="image/*" style="display:none"></div>'
    +'<div class="onb-field"><label>Full name</label><input id="fName" placeholder="Jordan Rivera" value="'+ppEsc(nm)+'"></div>'
    +'<div class="onb-field"><label>Job position</label><input id="fRole" placeholder="Creative Director" value="'+ppEsc(rl)+'"></div>'
    +'<div class="onb-field"><label>Phone <span style="opacity:.45;text-transform:none;letter-spacing:0">optional</span></label><input id="fPhone" type="tel" placeholder="(917) 555-0148" value="'+ppEsc(ph)+'"></div>'
    +'<div class="onb-field"><label>Company</label><input id="fComp" list="compList" autocomplete="off" placeholder="Your company" value="'+ppEsc(cname)+'"><datalist id="compList">'+sugg+'</datalist></div>'
    +'<div class="onb-field"><label>Company logo <span style="opacity:.45;text-transform:none;letter-spacing:0">optional</span></label><div class="logo-row"><div class="logo-prev" id="logoPrev" style="'+logoStyle+'">'+(logoStyle?'':'\u25a2')+'</div><button type="button" class="logo-up" id="logoBtn">'+(logoStyle?'Replace logo':'Upload logo')+'</button><input type="file" id="logoFile" accept="image/*" style="display:none"></div></div>'
    +'<div class="onb-actions"><button class="onb-join" id="joinBtn"'+(p?'':' disabled')+'>'+(p?'Save profile':'Join project')+'</button><button class="onb-cancel" id="cancelBtn">Cancel</button></div><div class="lm-msg" id="onbMsg"></div>';
}
function wireOnb(){
  var avDrop=document.getElementById('avDrop'),avFile=document.getElementById('avFile');
  avDrop.onclick=function(){ avFile.click(); };
  avFile.onchange=function(){ var f=avFile.files[0]; if(!f) return; openCropper(f, function(file,url){ ppPendingFile=file; avDrop.style.backgroundImage='url('+url+')'; avDrop.innerHTML=''; }); avFile.value=''; };
  var logoPrev=document.getElementById('logoPrev'),logoBtn=document.getElementById('logoBtn'),logoFile=document.getElementById('logoFile');
  if(logoBtn&&logoFile){
    logoBtn.onclick=function(){ logoFile.click(); };
    logoFile.onchange=function(){ var f=logoFile.files[0]; if(!f) return; ppPendingLogo=f; var u=URL.createObjectURL(f); logoPrev.style.backgroundImage='url('+u+')'; logoPrev.style.backgroundSize='contain'; logoPrev.style.backgroundRepeat='no-repeat'; logoPrev.style.backgroundPosition='center'; logoPrev.textContent=''; logoBtn.textContent='Replace logo'; logoFile.value=''; };
  }
  var fName=document.getElementById('fName'),fRole=document.getElementById('fRole'),fPhone=document.getElementById('fPhone'),fComp=document.getElementById('fComp'),joinBtn=document.getElementById('joinBtn');
  function gate(){ joinBtn.disabled=!(fName.value.trim()&&fRole.value.trim()&&fComp.value.trim()); }
  [fName,fRole,fComp].forEach(function(el){ if(el) el.oninput=gate; });
  document.getElementById('cancelBtn').onclick=closeOnboarding;
  joinBtn.onclick=async function(){
    if(!AUTH.user){ var lg=document.getElementById('onbMsg'); if(lg) lg.textContent='Please log in first to save changes.'; return; }
    var isOwner = !!(ppEditTarget && ppEditTarget.owner);
    joinBtn.disabled=true; joinBtn.textContent='Saving\u2026';
    var cname=fComp.value.trim();
    var existing=(COMPANIES_CACHE||[]).find(function(c){ return (c.name||'').toLowerCase()===cname.toLowerCase(); });
    var cid=existing?existing.id:(cname.toLowerCase().replace(/[^a-z0-9]+/g,'_')||('co'+Date.now()));
    var logoUrl=null;
    if(ppPendingLogo){ try{ logoUrl=await ppUploadLogo(ppPendingLogo, cid); }catch(e){} }
    var coRow={ review_slug:CONFIG.REVIEW_SLUG, id:cid, name:cname };
    if(logoUrl) coRow.logo_url=logoUrl;
    try{ await sb.from('companies').upsert(coRow,{onConflict:'review_slug,id'}); }catch(e){}
    COMPANIES_CACHE=null; await loadCompanies();
    var avatarUrl = (ppEditTarget&&ppEditTarget.avatar_url) || null;
    if(ppPendingFile){ var u=await ppUploadAvatar(ppPendingFile); if(u) avatarUrl=u; }
    var err=null, savedName=fName.value.trim();
    if(isOwner){
      try{ var ro=await sb.from('review_settings').upsert({review_slug:CONFIG.REVIEW_SLUG, owner_name:savedName, owner_position:fRole.value.trim(), owner_company_id:cid, owner_avatar_url:avatarUrl, owner_phone:fPhone?fPhone.value.trim():null, owner_uid:AUTH.user.id, updated_at:new Date().toISOString()},{onConflict:'review_slug'}); if(ro.error) err=ro.error; }catch(e){ err=e; }
      if(!err){ OWNER={ id:'__owner__', uid:AUTH.user.id, full_name:savedName, position:fRole.value.trim(), company_id:cid, avatar_url:avatarUrl, phone:fPhone?fPhone.value.trim():null, owner:true }; if(avatarUrl) AVA_BY_EMAIL[String(OWNER_EMAIL).toLowerCase()]=avatarUrl; }
    } else {
      var row={ id:AUTH.user.id, review_slug:CONFIG.REVIEW_SLUG, email:AUTH.user.email, full_name:savedName, position:fRole.value.trim(), phone:fPhone?fPhone.value.trim():null, company_id:cid, avatar_url:avatarUrl, updated_at:new Date().toISOString() };
      try{ var r=await sb.from('profiles').upsert(row,{onConflict:'id'}); if(r.error) err=r.error; }catch(e){ err=e; }
      if(!err){ AUTH.profile=row; if(avatarUrl && AUTH.user.email) AVA_BY_EMAIL[String(AUTH.user.email).toLowerCase()]=avatarUrl; }
    }
    if(err){ var m=document.getElementById('onbMsg'); if(m) m.textContent='Could not save: '+(err.message||'try again'); joinBtn.disabled=false; joinBtn.textContent='Save'; return; }
    document.getElementById('onbCard').innerHTML='<div class="onb-success"><div class="tick">\u2713</div><h3>'+(ppEditTarget&&ppEditTarget.full_name?'Saved!':'You\u2019re in, '+ppEsc(savedName.split(/\s+/)[0])+'!')+'</h3><p>Your card is on the Project Partners page.</p></div>';
    setTimeout(function(){ closeOnboarding(); renderAuthSlot(); if(currentFolder==='partners') loadPartners(); },1100);
  };
}
async function ppUploadAvatar(file){
  try{
    var ext='png'; if(file.name && file.name.indexOf('.')>=0){ ext=file.name.split('.').pop().toLowerCase(); } else if(file.type && file.type.indexOf('/')>=0){ ext=file.type.split('/')[1]; }
    var path=AUTH.user.id+'/'+Date.now()+'.'+ext;
    var up=await sb.storage.from('avatars').upload(path, file, {upsert:true, cacheControl:'3600'});
    if(up.error) return null;
    var pub=sb.storage.from('avatars').getPublicUrl(path);
    return pub && pub.data ? pub.data.publicUrl : null;
  }catch(e){ return null; }
}
async function ppUploadLogo(file, cid){
  try{
    var ext='png'; if(file.name && file.name.indexOf('.')>=0){ ext=file.name.split('.').pop().toLowerCase(); } else if(file.type && file.type.indexOf('/')>=0){ ext=file.type.split('/')[1]; }
    var safe=String(cid||'co').replace(/[^a-z0-9_-]+/gi,'_');
    var path='company-logos/'+safe+'/'+Date.now()+'.'+ext;
    var up=await sb.storage.from('avatars').upload(path, file, {upsert:true, cacheControl:'3600'});
    if(up.error) return null;
    var pub=sb.storage.from('avatars').getPublicUrl(path);
    return pub && pub.data ? pub.data.publicUrl : null;
  }catch(e){ return null; }
}


/* ---------- avatar cropper (zoom + reposition) ---------- */
function openCropper(file, cb){
  var url=URL.createObjectURL(file);
  var img=new Image();
  img.onload=function(){
    var S=264;
    var ov=document.createElement('div'); ov.className='onb show'; ov.id='crOv';
    ov.innerHTML='<div class="cr-card">'
      +'<div class="cr-title">Position your photo</div>'
      +'<div class="cr-sub">Drag to move \u00b7 slider to zoom</div>'
      +'<div class="cr-stage" id="crStage"><img id="crImg" src="'+url+'" draggable="false" alt=""><div class="cr-ring"></div></div>'
      +'<div class="cr-zoomrow"><span>\u2212</span><input type="range" id="crZoom" min="1" max="3" step="0.01" value="1"><span>+</span></div>'
      +'<div class="cr-actions"><button class="onb-join" id="crApply">Use photo</button><button class="onb-cancel" id="crCancel">Cancel</button></div>'
      +'</div>';
    document.body.appendChild(ov);
    var im=document.getElementById('crImg'), zoom=document.getElementById('crZoom');
    var iw=img.naturalWidth||1, ih=img.naturalHeight||1;
    var cover=Math.max(S/iw, S/ih), z=1, tx=0, ty=0;
    function apply(){
      var sc=cover*z, w=iw*sc, h=ih*sc;
      var maxX=Math.max(0,(w-S)/2), maxY=Math.max(0,(h-S)/2);
      tx=Math.max(-maxX,Math.min(maxX,tx)); ty=Math.max(-maxY,Math.min(maxY,ty));
      im.style.width=w+'px'; im.style.height=h+'px';
      im.style.left=(S/2-w/2+tx)+'px'; im.style.top=(S/2-h/2+ty)+'px';
    }
    apply();
    zoom.oninput=function(){ z=parseFloat(zoom.value)||1; apply(); };
    var dragging=false, sx=0, sy=0;
    function pt(e){ var t=(e.touches&&e.touches[0])?e.touches[0]:e; return {x:t.clientX,y:t.clientY}; }
    function down(e){ dragging=true; var p=pt(e); sx=p.x-tx; sy=p.y-ty; e.preventDefault(); }
    function move(e){ if(!dragging) return; var p=pt(e); tx=p.x-sx; ty=p.y-sy; apply(); e.preventDefault(); }
    function up(){ dragging=false; }
    im.addEventListener('mousedown',down); window.addEventListener('mousemove',move); window.addEventListener('mouseup',up);
    im.addEventListener('touchstart',down,{passive:false}); window.addEventListener('touchmove',move,{passive:false}); window.addEventListener('touchend',up);
    function cleanup(){ window.removeEventListener('mousemove',move); window.removeEventListener('mouseup',up); window.removeEventListener('touchmove',move); window.removeEventListener('touchend',up); try{URL.revokeObjectURL(url);}catch(e){} ov.remove(); }
    document.getElementById('crCancel').onclick=cleanup;
    document.getElementById('crApply').onclick=function(){
      var OUT=400, f=OUT/S, sc=cover*z, w=iw*sc, h=ih*sc;
      var cv=document.createElement('canvas'); cv.width=OUT; cv.height=OUT; var ctx=cv.getContext('2d');
      ctx.fillStyle='#0b0c0d'; ctx.fillRect(0,0,OUT,OUT);
      ctx.save(); ctx.beginPath(); ctx.arc(OUT/2,OUT/2,OUT/2,0,Math.PI*2); ctx.closePath(); ctx.clip();
      ctx.drawImage(img,(S/2-w/2+tx)*f,(S/2-h/2+ty)*f,w*f,h*f);
      ctx.restore();
      cv.toBlob(function(blob){
        var out=blob?new File([blob],'avatar.png',{type:'image/png'}):file;
        var purl=URL.createObjectURL(blob||file);
        cb(out, purl); cleanup();
      },'image/png',0.92);
    };
  };
  img.onerror=function(){ cb(file, url); };
  img.src=url;
}

/* ---------- profile menu ---------- */
function openProfileMenu(e){
  if(e){ e.preventDefault(); e.stopPropagation(); }
  if(document.getElementById('profMenu')){ closeProfMenu(); return; }
  var btn=document.getElementById('profBtn');
  var nm=(AUTH.profile&&AUTH.profile.full_name)||AUTH.user.email, rl=(AUTH.profile&&AUTH.profile.position)||'', co=AUTH.profile?ppCompany(AUTH.profile.company_id).name:'';
  var m=document.createElement('div'); m.className='prof-menu'; m.id='profMenu';
  m.innerHTML='<div class="prof-head"><div class="pn">'+ppEsc(nm)+'</div><div class="pr">'+ppEsc(rl)+(co?' \u00b7 '+ppEsc(co):'')+'</div></div><button type="button" id="pmEdit">Edit profile</button><button type="button" id="pmLogout" class="logout">Log out</button>';
  document.body.appendChild(m);
  if(btn){ var r=btn.getBoundingClientRect(); m.style.position='fixed'; m.style.top=(r.bottom+8)+'px'; m.style.right=Math.max(8,(window.innerWidth-r.right))+'px'; m.style.left='auto'; m.style.marginTop='0'; m.style.zIndex='200'; }
  m.querySelector('#pmEdit').addEventListener('click', function(ev){ ev.preventDefault(); ev.stopPropagation(); closeProfMenu(); editMe(); });
  m.querySelector('#pmLogout').addEventListener('click', function(ev){ ev.preventDefault(); ev.stopPropagation(); closeProfMenu(); authSignOut(); });
  setTimeout(function(){ document.addEventListener('click', closeProfOnce, true); window.addEventListener('resize', closeProfMenu); window.addEventListener('scroll', closeProfMenu, true); },0);
}
function closeProfMenu(){ var m=document.getElementById('profMenu'); if(m) m.remove(); document.removeEventListener('click', closeProfOnce, true); window.removeEventListener('resize', closeProfMenu); window.removeEventListener('scroll', closeProfMenu, true); }
function closeProfOnce(e){ var m=document.getElementById('profMenu'); if(!m){ document.removeEventListener('click', closeProfOnce, true); return; } if(m.contains(e.target)) return; if(e.target.closest && e.target.closest('#profBtn')) return; closeProfMenu(); }
async function editMe(){
  if(!AUTH.user) return;
  var tgt=null;
  try{
    var ro=await sb.from('review_settings').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).maybeSingle();
    if(ro && ro.data && ro.data.owner_uid && ro.data.owner_uid===AUTH.user.id){
      tgt={ id:'__owner__', uid:ro.data.owner_uid, owner:true, full_name:ro.data.owner_name||'', position:ro.data.owner_position||'', company_id:ro.data.owner_company_id||'', avatar_url:ro.data.owner_avatar_url||null, phone:ro.data.owner_phone||null };
      OWNER=tgt;
    }
  }catch(e){}
  if(!tgt){ try{ await loadProfile(); }catch(e){} tgt=AUTH.profile; }
  openOnboarding(tgt||{});
}

/* ---------- partners page ---------- */
async function loadPartners(){
  var m=document.getElementById('ppmount'); if(!m) return;
  await loadCompanies();
  await loadOwner();
  var profiles=[];
  try{ var r=await sb.from('profiles').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).order('created_at',{ascending:true}); profiles=r.data||[]; }catch(e){ profiles=[]; }
  renderPartners(profiles);
}
function ppCardHTML(p){
  var c=ppCompany(p.company_id);
  var logo=c.logo_url
    ? '<span class="pc-logo"><img src="'+ppEsc(c.logo_url)+'" alt=""></span>'
    : '<span class="logo-mono" style="background:'+c.color+'">'+ppEsc((ppInitials(c.name)[0]||'').toUpperCase())+'</span>';
  var dotKey=p.owner?(p.uid||'__owner__'):p.id;
  var online=PRESENCE.online[dotKey]?' on':'';
  var rm=((typeof ADMIN!=='undefined' && ADMIN) && !p.owner)?'<button class="pc-remove" data-rm="'+ppEsc(p.id)+'" title="Remove from project">\u00d7</button>':'';
  return '<div class="pcard" data-pid="'+ppEsc(p.id)+'">'+rm+'<div class="pc-top"><div class="pc-avwrap"><div class="avatar" style="'+ppAvStyle(p)+'">'+(p.avatar_url?'':ppEsc(ppInitials(p.full_name).toUpperCase()))+'</div><span class="pc-dot'+online+'" data-dot="'+ppEsc(dotKey)+'"></span></div>'
    +'<div class="pc-id"><div class="pc-name">'+ppEsc(p.full_name)+'</div><div class="pc-role">'+ppEsc(p.position)+'</div></div></div>'
    +'<div class="pc-foot">'+logo+'<span class="pc-company">'+ppEsc(c.name)+'</span></div></div>';
}
function renderPartners(profiles){
  var m=document.getElementById('ppmount'); if(!m) return;
  PP.profiles=profiles||[];
  var all=[OWNER].concat(PP.profiles);
  var used={}; all.forEach(function(p){ used[p.company_id]=1; });
  var chips='<button class="fchip '+(PP.filter==='all'?'on':'')+'" data-ppf="all">All partners</button>'
    +(COMPANIES_CACHE||[]).filter(function(c){return used[c.id];}).map(function(c){ return '<button class="fchip '+(PP.filter===c.id?'on':'')+'" data-ppf="'+ppEsc(c.id)+'"><span class="lm" style="background:'+c.color+'">'+ppEsc((ppInitials(c.name)[0]||'').toUpperCase())+'</span>'+ppEsc(c.name)+'</button>'; }).join('');
  var invite = ADMIN ? '<button class="pp-invite" id="ppInvite">+ Invite partner</button><div class="invite-pop" id="ppInvitePop" hidden></div>' : '';
  var list=all.filter(function(p){ return PP.filter==='all'||p.company_id===PP.filter; });
  list.sort(function(a,b){ return (b.owner?1:0)-(a.owner?1:0) || String(a.full_name||'').localeCompare(String(b.full_name||'')); });
  m.innerHTML='<div class="pp-top"><div class="pp-filter">'+chips+'</div>'+invite+'</div><div class="pgrid">'+list.map(ppCardHTML).join('')+'</div>';
  m.querySelectorAll('.fchip').forEach(function(b){ b.onclick=function(){ PP.filter=b.dataset.ppf; renderPartners(PP.profiles); }; });
  m.querySelectorAll('.pcard').forEach(function(card){ card.onclick=function(e){ if(e.target.closest && e.target.closest('.pc-remove')) return; openCard(card.dataset.pid); }; });
  m.querySelectorAll('.pc-remove').forEach(function(b){ b.onclick=function(e){ e.stopPropagation(); removeFlow(b.dataset.rm); }; });
  if(ADMIN){ var ib=document.getElementById('ppInvite'); if(ib) ib.onclick=function(ev){ ev.stopPropagation(); ppToggleInvite(); }; }
  refreshOnlineDots();
}
function ppToggleInvite(){
  var pop=document.getElementById('ppInvitePop'); if(!pop) return;
  if(!pop.hasAttribute('hidden')){ pop.setAttribute('hidden',''); return; }
  pop.innerHTML='<h4>Invite a partner</h4><p>Email them a one-tap magic link. They land on the onboarding form, no password.</p>'
    +'<div class="ip-row"><input id="ppInvEmail" type="email" placeholder="name@company.com"><button class="ip-btn" id="ppInvSend">Send invite</button></div>'
    +'<div class="ip-link"><span>'+ppEsc(location.origin+location.pathname)+'</span><button class="ip-copy" id="ppInvCopy">Copy link</button></div>'
    +'<div class="ip-msg" id="ppInvMsg"></div>';
  pop.removeAttribute('hidden');
  document.getElementById('ppInvCopy').onclick=function(){ try{ navigator.clipboard.writeText(location.origin+location.pathname); }catch(e){} this.textContent='Copied \u2713'; };
  document.getElementById('ppInvSend').onclick=async function(){
    var em=document.getElementById('ppInvEmail').value.trim(); if(!em) return; this.disabled=true; this.textContent='Sending\u2026';
    try{ await sb.from('invites').upsert({review_slug:CONFIG.REVIEW_SLUG, email:em},{onConflict:'review_slug,email'}); }catch(e){}
    var res=await signInMagic(em);
    var msg=document.getElementById('ppInvMsg');
    if(res && res.error){ if(msg) msg.textContent=res.error.message||'Could not send.'; this.disabled=false; this.textContent='Send invite'; return; }
    if(msg) msg.textContent='Invite sent to '+em+' \u2713'; this.textContent='Sent \u2713';
  };
  setTimeout(function(){ document.addEventListener('click', ppInvAway); },0);
}
function ppInvAway(e){ var pop=document.getElementById('ppInvitePop'); if(pop && !pop.hasAttribute('hidden') && !pop.contains(e.target) && !(e.target.closest && e.target.closest('#ppInvite'))){ pop.setAttribute('hidden',''); } document.removeEventListener('click', ppInvAway); }


/* ---------- owner card (editable, persisted) ---------- */
async function loadOwner(){
  try{
    var r=await sb.from('review_settings').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).maybeSingle();
    if(r && r.data){
      OWNER={ id:'__owner__', uid:r.data.owner_uid||null, full_name:r.data.owner_name||'Shaun Harrison', position:r.data.owner_position||'Creative Director', company_id:r.data.owner_company_id||'supernerd', avatar_url:r.data.owner_avatar_url||null, phone:r.data.owner_phone||null, owner:true };
    }
  }catch(e){}
  try{
    if(typeof ADMIN!=='undefined' && ADMIN && AUTH.user && OWNER.uid!==AUTH.user.id){
      await sb.from('review_settings').upsert({review_slug:CONFIG.REVIEW_SLUG, owner_uid:AUTH.user.id},{onConflict:'review_slug'});
      OWNER.uid=AUTH.user.id;
    }
  }catch(e){}
}

/* ---------- realtime presence (online lights) ---------- */
function presenceKey(){ return AUTH.user?AUTH.user.id:null; }
function startPresence(){
  var key=presenceKey();
  if(PRESENCE.channel && PRESENCE.key===key) return;
  stopPresence();
  if(!key) return;
  PRESENCE.key=key;
  try{
    var ch=sb.channel('partners-'+CONFIG.REVIEW_SLUG, { config:{ presence:{ key:key } } });
    ch.on('presence',{event:'sync'},function(){
      var st=ch.presenceState(); PRESENCE.online={};
      Object.keys(st).forEach(function(k){ PRESENCE.online[k]=1; });
      refreshOnlineDots();
    });
    ch.subscribe(function(status){ if(status==='SUBSCRIBED'){ try{ ch.track({ at:Date.now() }); }catch(e){} } });
    PRESENCE.channel=ch;
  }catch(e){}
}
function stopPresence(){ if(PRESENCE.channel){ try{ sb.removeChannel(PRESENCE.channel); }catch(e){} } PRESENCE.channel=null; PRESENCE.key=null; }
function refreshOnlineDots(){ document.querySelectorAll('.pc-dot[data-dot]').forEach(function(d){ d.classList.toggle('on', !!PRESENCE.online[d.dataset.dot]); }); }

/* ---------- click a card ---------- */
function openCard(pid){
  if(pid==='__owner__'){ if(typeof ADMIN!=='undefined' && ADMIN) openOnboarding(Object.assign({},OWNER)); else openPartnerDetail(OWNER); return; }
  var p=(PP.profiles||[]).find(function(x){ return x.id===pid; }); if(!p) return;
  if(AUTH.user && pid===AUTH.user.id) openOnboarding(p);
  else openPartnerDetail(p);
}

/* ---------- read-only detail (others' cards) ---------- */
function telHref(s){ return String(s||'').replace(/[^+0-9]/g,''); }
function openPartnerDetail(p){
  var c=ppCompany(p.company_id), online=!!PRESENCE.online[p.owner?(p.uid||'__owner__'):p.id];
  var dot='<span class="pc-dot'+(online?' on':'')+'" style="position:static;display:inline-block;width:9px;height:9px;border-width:0;vertical-align:middle;margin-right:7px"></span>';
  var rm=((typeof ADMIN!=='undefined' && ADMIN) && !p.owner)?'<button class="pd-remove" id="pdRemove">Remove from project</button>':'';
  var coLogo = c.logo_url
    ? '<span class="pd-colmono"><img src="'+ppEsc(c.logo_url)+'" alt=""></span>'
    : '<span class="logo-mono" style="background:'+c.color+'">'+ppEsc((ppInitials(c.name)[0]||'').toUpperCase())+'</span>';
  var ph=telHref(p.phone);
  var phoneRow = p.phone
    ? '<div class="pd-phone"><span class="pd-ph-num">'+ppEsc(p.phone)+'</span><a class="pd-ph-act" href="tel:'+ppEsc(ph)+'">Call</a><a class="pd-ph-act" href="sms:'+ppEsc(ph)+'">Text</a></div>'
    : '';
  var ov=document.createElement('div'); ov.className='onb show'; ov.id='pdOv';
  ov.innerHTML='<div class="lm-modal" id="pdCard">'
    +'<div class="pd-top"><div class="pd-av" style="'+ppAvStyle(p)+'">'+(p.avatar_url?'':ppEsc(ppInitials(p.full_name).toUpperCase()))+'</div>'
    +'<div class="pd-id"><div class="pd-name">'+ppEsc(p.full_name)+'</div><div class="pd-role">'+ppEsc(p.position)+'</div></div></div>'
    +'<div class="pd-meta"><div class="pd-co">'+coLogo+'<span>'+ppEsc(c.name)+'</span></div>'
    +phoneRow
    +(p.email?'<div class="pd-email"><a href="mailto:'+ppEsc(p.email)+'">'+ppEsc(p.email)+'</a></div>':'')
    +'<div class="pd-status">'+dot+(online?'Online now':'Offline')+'</div></div>'
    +rm+'<div class="lm-foot"><button id="pdClose">Close</button></div></div>';
  document.body.appendChild(ov);
  ov.addEventListener('click',function(e){ if(e.target===ov) ov.remove(); });
  document.getElementById('pdClose').onclick=function(){ ov.remove(); };
  var rb=document.getElementById('pdRemove'); if(rb) rb.onclick=function(){ removeFlow(p.id); };
}

/* ---------- admin remove ---------- */
function removeFlow(id){
  var p=(PP.profiles||[]).find(function(x){ return x.id===id; }); var nm=p?p.full_name:'this partner';
  var ov=document.createElement('div'); ov.className='onb show'; ov.id='rmOv';
  ov.innerHTML='<div class="lm-modal"><div class="lm-title" style="font-size:19px">Remove '+ppEsc(nm)+'?</div><div class="lm-sub">They\u2019ll be taken off this project\u2019s partner list. They can rejoin from a new invite.</div><div class="onb-actions"><button class="onb-join" id="rmYes" style="background:#c0353a;color:#fff">Remove</button><button class="onb-cancel" id="rmNo">Cancel</button></div></div>';
  document.body.appendChild(ov);
  ov.addEventListener('click',function(e){ if(e.target===ov) ov.remove(); });
  document.getElementById('rmNo').onclick=function(){ ov.remove(); };
  document.getElementById('rmYes').onclick=async function(){ this.disabled=true; this.textContent='Removing\u2026'; await deleteProfile(id); ov.remove(); var pd=document.getElementById('pdOv'); if(pd) pd.remove(); };
}
async function deleteProfile(id){ try{ await sb.from('profiles').delete().eq('id',id); }catch(e){} loadPartners(); }


authInit();

</script>
</body>
</html>
