  var DPR=Math.min(window.devicePixelRatio||1,1.25), W=0,H=0,N=0,pts=[];
  var GREEN='186,192,30', BONE='236,236,234', SC=0.0016, SP=0.6;
  var seed=20231, perm=new Uint8Array(512);
  function rnd(){ seed=(seed*1664525+1013904223)>>>0; return ((seed>>>8)&0xffffff)/0xffffff; }
  (function(){ var p=[],i,j,t; for(i=0;i<256;i++)p[i]=i; for(i=255;i>0;i--){ j=(rnd()*(i+1))|0; t=p[i];p[i]=p[j];p[j]=t; } for(i=0;i<512;i++)perm[i]=p[i&255]; })();
  function fade(t){ return t*t*t*(t*(t*6-15)+10); }
  function lerp(a,b,t){ return a+(b-a)*t; }
  function grad(h,x,y){ switch(h&3){ case 0:return x+y; case 1:return -x+y; case 2:return x-y; default:return -x-y; } }
  function noise(x,y){ var X=Math.floor(x)&255,Y=Math.floor(y)&255; x-=Math.floor(x); y-=Math.floor(y);
    var u=fade(x),v=fade(y), aa=perm[perm[X]+Y],ab=perm[perm[X]+Y+1],ba=perm[perm[X+1]+Y],bb=perm[perm[X+1]+Y+1];
    return lerp(lerp(grad(aa,x,y),grad(ba,x-1,y),u), lerp(grad(ab,x,y-1),grad(bb,x-1,y-1),u), v); }
  function resize(){ W=c.width=Math.floor(innerWidth*DPR); H=c.height=Math.floor(innerHeight*DPR);
    c.style.width=innerWidth+'px'; c.style.height=innerHeight+'px';
    N=Math.max(380,Math.min(1500,Math.floor(innerWidth*innerHeight/1500))); pts=[];
    for(var i=0;i<N;i++) pts.push({x:rnd()*W,y:rnd()*H,life:20+rnd()*120});
    ctx.clearRect(0,0,W,H); }
  function step(){
    // fade trails by ERASING alpha — canvas stays transparent so the green mesh shows through
    ctx.globalCompositeOperation='destination-out';
    ctx.fillStyle='rgba(0,0,0,0.085)'; ctx.fillRect(0,0,W,H);
    ctx.globalCompositeOperation='lighter';
    for(var i=0;i<N;i++){ var p=pts[i];
      var a=noise(p.x*SC,p.y*SC)*Math.PI*2.4;
      var nx=p.x+Math.cos(a)*SP*DPR, ny=p.y+Math.sin(a)*SP*DPR;
      var g=(noise(p.x*SC+99,p.y*SC+99)+1)*0.5;
      ctx.strokeStyle='rgba('+(g>0.4?GREEN:BONE)+','+(0.05+g*0.12).toFixed(3)+')';
      ctx.lineWidth=DPR*1.3; ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(nx,ny); ctx.stroke();
      p.x=nx; p.y=ny; p.life--;
      if(p.life<0||nx<0||nx>W||ny<0||ny>H){ p.x=rnd()*W; p.y=rnd()*H; p.life=20+rnd()*120; } }
    ctx.globalCompositeOperation='source-over'; }
  var raf,running=false;
  function loop(){ if(!running) return; step(); raf=requestAnimationFrame(loop); }
  function start(){ if(running||reduce) return; running=true; loop(); }
  function stop(){ running=false; if(raf) cancelAnimationFrame(raf); }
  try{
    resize();
    var rt; addEventListener('resize', function(){ clearTimeout(rt); rt=setTimeout(resize,200); });
    document.addEventListener('visibilitychange', function(){ document.hidden?stop():start(); });
    if(reduce){ for(var k=0;k<70;k++) step(); } else { start(); }
  }catch(e){}
})();
(function(){ var rb=document.getElementById('routebar'); if(!rb||!rb.animate) return;
  addEventListener('hashchange', function(){ try{ rb.animate([{transform:'scaleX(0)',opacity:1},{transform:'scaleX(0.92)',opacity:1,offset:.7},{transform:'scaleX(1)',opacity:0}],{duration:620,easing:'cubic-bezier(.23,1,.32,1)'}); }catch(e){} });
})();
</script>

