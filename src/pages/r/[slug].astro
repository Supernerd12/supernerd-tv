function calDayTitle(dt){ return CAL_DOWF[dt.getDay()]+', '+CAL_MON[dt.getMonth()]+' '+dt.getDate(); }
function calDayHTML(dt){
  var evs=calEvOn(dt).sort(function(a,b){return (a.kind==='meeting'?1:0)-(b.kind==='meeting'?1:0)||String(a.title).localeCompare(String(b.title));});
  if(!evs.length) return '<div class="day-wrap"><div class="day-empty">No events on '+calDayTitle(dt)+'.</div></div>';
  var rows=evs.map(function(e){return '<div class="dayrow cal-ev" '+calEvAttrs(e)+' style="border-left-color:'+calEvColor(e)+'"><div class="dtime">'+(e.time?esc(e.time):'All day')+'</div><div><div class="dttl">'+esc(e.title)+'</div><div class="dmeta">'+esc(calTypeL(e.type))+' \u00b7 '+esc(calProjName(e.proj))+(e.notes?' \u2014 '+esc(e.notes):'')+'</div></div></div>';}).join('');
