function calMonthHTML(){
  var y=CAL.cursor.getFullYear(),m=CAL.cursor.getMonth(),T=calToday();
  var first=new Date(y,m,1),start=first.getDay(),dts=[],mk=[];
  for(var j=0;j<42;j++){var d0=new Date(y,m,1-start+j);dts.push(d0);mk.push(calMajorKeyOn(d0));}
  var dow='<div class="cal-dow">'+CAL_DOW.map(function(d){return '<span>'+d+'</span>';}).join('')+'</div>';
  var cells='';
  for(var i=0;i<42;i++){
    var dt=dts[i],col=i%7,inM=dt.getMonth()===m;
    var evs=calEvOn(dt),majors=evs.filter(function(e){return e.kind!=='meeting';}),mtgs=evs.filter(function(e){return e.kind==='meeting';});
    var contLeft=col>0&&mk[i]&&mk[i-1]===mk[i],contRight=col<6&&mk[i]&&mk[i+1]===mk[i];
    var cls='cell'+(inM?'':' out')+(calSameDay(dt,T)?' today':''),inner='',cellAttrs='';
