  specs:  ['1920\u00d71080 (1080p)','3840\u00d72160 (4K UHD)','4096\u00d72160 (DCI 4K)','1280\u00d7720 (720p)','1080\u00d71920 (9:16 vertical)','1080\u00d71080 (1:1 square)','2560\u00d71440 (1440p)','7680\u00d74320 (8K)','LED pixel map (custom)','Other'],
  codec:  ['H.264','H.265 / HEVC','ProRes 422','ProRes 422 HQ','ProRes 4444','DNxHD','DNxHR','VP9','AV1','Uncompressed','Other'],
  fps:    ['23.976','24','25','29.97','30','50','59.94','60','120']
};
function cbParseArr(v){ if(Array.isArray(v)) return v; if(!v) return []; try{ var p=JSON.parse(v); if(Array.isArray(p)) return p; }catch(e){} return String(v).split('\n').map(function(s){return s.trim();}).filter(Boolean); }
function cbParseObj(v){ if(v&&typeof v==='object') return v; if(!v) return {}; try{ var p=JSON.parse(v); if(p&&typeof p==='object') return p; }catch(e){} return {}; }
function cbParseOuts(v){ if(!v) return [{}]; try{ var p=JSON.parse(v); if(Array.isArray(p)) return p.length?p:[{}]; if(p&&typeof p==='object'&&Object.keys(p).length) return [p]; }catch(e){} return [{}]; }

