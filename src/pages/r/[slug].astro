  if(msg){ msg.className='admin-msg'; msg.textContent=''; }
  try{
    var inner='<p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#c9ccd1;">If you\u2019re reading this, your portal can send email through Resend. \u2713</p>'
      +'<p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#c9ccd1;">That means the Project Overview newsletter and comment / welcome notifications can now go out straight from here.</p>'
      +'<p style="margin:0;font-size:13px;line-height:1.6;color:#8a8e94;">Test sent to '+esc(to)+'.</p>';
    var html=emailShell('Email is working', inner);
    await sendEmail({ to:[to], subject:'Supernerd portal \u2014 email test \u2713', html:html });
    if(msg){ msg.className='admin-msg ok'; msg.textContent='Sent \u2713 \u2014 check '+to+' (first one may land in spam).'; }
  }catch(e){
    if(msg){ msg.className='admin-msg err'; msg.textContent='Failed: '+(e.message||'unknown')+' \u2014 check the function secrets / FROM_EMAIL domain.'; }
  }
  if(btn){ btn.disabled=false; btn.textContent=orig; }
}

/* ============================================================
   v22 — PROJECT NEWSLETTER STUDIO
   ============================================================ */
var NL = { proj:null, data:null, members:[], videos:[], heroBusy:false, sending:false };

function nlBlank(){
  return {
    eyebrow:'Project Update Newsletter',
    title:'', titleGreen:{},               // titleGreen[index]=true => acid word
    sub:'',
    hero:{ uid:'', t:0, url:'', composed:'' },
    latest:{ label:'On Track', url:'' },
    phase:'', review:{ date:'', label:'' },
    stand:'',
    happened:[], eyes:[], milestones:[], decisions:[], locked:[],
    reviewUrl:''
  };
}
function nlEsc(s){ var d=document.createElement('div'); d.textContent=(s==null?'':s); return d.innerHTML; }
function nlStreamThumb(uid, t){ return 'https://'+CONFIG.STREAM_CUSTOMER+'/'+uid+'/thumbnails/thumbnail.jpg?time='+Math.max(0,Math.floor(t||0))+'s&height=720'; }
function nlProjVideos(proj){
  var out=[];
  (proj.sections||[]).forEach(function(sec){ (sec.stacks||[]).forEach(function(st){ (st.versions||[]).forEach(function(v){ if(v.type==='video' && v.stream_uid){ out.push({ uid:v.stream_uid, label:(st.title||v.title||'Video')+(v.version?(' '+v.version):''), section:sec.name }); } }); }); });
  // de-dupe by uid
  var seen={}, uniq=[]; out.forEach(function(v){ if(!seen[v.uid]){ seen[v.uid]=1; uniq.push(v); } });
  return uniq;
}
function nlLatestStackUrl(proj){
  var s=(proj.sections||[])[0]; if(!s) return '';
  var st=(s.stacks||[])[0]; if(!st) return '';
  return location.origin+'/r/'+CONFIG.REVIEW_SLUG+'/#p='+encodeURIComponent(proj.id)+'&k='+encodeURIComponent(st.id);
}
function nlReviewUrl(proj){ return location.origin+'/r/'+CONFIG.REVIEW_SLUG+'/#p='+encodeURIComponent(proj.id); }

/* ---------- live data defaults ---------- */
async function nlGather(proj){
  var d=nlBlank();
  d.reviewUrl=nlReviewUrl(proj);
  d.latest.url=nlLatestStackUrl(proj)||d.reviewUrl;
  d.title=(proj.title||'Project')+' update';
  // current phase from project_status
  try{ var ps=await sb.from('project_status').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',proj.id).maybeSingle(); if(ps&&ps.data){ d.phase=ps.data.phase||ps.data.label||ps.data.current||''; } }catch(e){}
  // next review date from calendar (soonest upcoming)
  try{
    var today=new Date().toISOString().slice(0,10);
    var ev=await sb.from('calendar_events').select('*').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_id',proj.id).gte('date',today).order('date',{ascending:true}).limit(1);
    if(ev&&ev.data&&ev.data[0]){ d.review.date=ev.data[0].date; d.review.label=ev.data[0].title||''; }
  }catch(e){}
  // what happened — recent comments + announcements
  try{
    var cm=await sb.from('comments').select('author_name,body,created_at,asset_id').eq('review_slug',CONFIG.REVIEW_SLUG).like('asset_id',proj.id+':%').order('created_at',{ascending:false}).limit(5);
    if(cm&&cm.data){ cm.data.forEach(function(c){ var who=c.author_name||'Someone'; var snip=(c.body||'').replace(/\s+/g,' ').slice(0,70); d.happened.push(who+' commented'+(snip?(': \u201c'+snip+'\u201d'):'')); }); }
  }catch(e){}
  try{
    var an=await sb.from('announcements').select('message,section,created_at').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project',proj.id).order('created_at',{ascending:false}).limit(3);
    if(an&&an.data){ an.data.forEach(function(a){ d.happened.push((a.section?(a.section+': '):'')+(a.message||'New work posted for review')); }); }
  }catch(e){}
  // tasks: needs-eyes + locked
  try{
    var tk=await sb.from('tasks').select('title,status').eq('review_slug',CONFIG.REVIEW_SLUG).eq('project_key',proj.id);
    if(tk&&tk.data){
      tk.data.forEach(function(t){
        if(['needs_client_feedback','needs_approval','needs_changes'].indexOf(t.status)>-1) d.eyes.push({ text:t.title, url:'' });
        if(t.status==='complete') d.locked.push(t.title);
      });
    }
  }catch(e){}
  if(!d.happened.length) d.happened.push('Latest cut posted for review');
  return d;
}
async function nlMembers(proj){
  var list=[];
  try{ var r=await sb.from('profiles').select('email,full_name').eq('review_slug',CONFIG.REVIEW_SLUG); if(r&&r.data){ r.data.forEach(function(p){ if(p.email) list.push({ email:p.email, name:p.full_name||p.email }); }); } }catch(e){}
  var seen={}, out=[]; list.forEach(function(m){ var k=m.email.toLowerCase(); if(!seen[k]){ seen[k]=1; out.push(m); } });
  return out;
}

/* ---------- EMAIL HTML (inline styles, table-based) ---------- */
