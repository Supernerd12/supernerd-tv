}
function nlRender(){
  var m=document.getElementById('nlmount'); if(!m) return; var d=NL.data;
  var vidOpts='<option value="">\u2014 No video / pick later \u2014</option>'+NL.videos.map(function(v){ return '<option value="'+nlEsc(v.uid)+'"'+(d.hero.uid===v.uid?' selected':'')+'>'+nlEsc(v.label)+' \u00b7 '+nlEsc(v.section)+'</option>'; }).join('');
  var thumb = d.hero.uid ? nlStreamThumb(d.hero.uid, d.hero.t) : (d.hero.url||'');
  function listRows(kind){
    if(kind==='hap') return (d.happened.length?d.happened:['']).map(function(t){ return '<div class="nl-row"><input class="nl-hap" value="'+nlEsc(t)+'" placeholder="e.g. Client color notes were applied"><button type="button" class="nl-x" data-rm>\u00d7</button></div>'; }).join('');
    if(kind==='eye') return (d.eyes.length?d.eyes:[{text:'',url:''}]).map(function(e){ return '<div class="nl-row nl-eye-row"><input class="nl-eye-t" value="'+nlEsc(e.text)+'" placeholder="What needs their eyes"><input class="nl-eye-u" value="'+nlEsc(e.url)+'" placeholder="Link (optional)"><button type="button" class="nl-x" data-rm>\u00d7</button></div>'; }).join('');
    if(kind==='ms') return (d.milestones.length?d.milestones:[{text:'',tag:''}]).map(function(e){ return '<div class="nl-row nl-ms-row"><input class="nl-ms-t" value="'+nlEsc(e.text)+'" placeholder="Milestone"><input class="nl-ms-g" value="'+nlEsc(e.tag)+'" placeholder="Tag / date"><button type="button" class="nl-x" data-rm>\u00d7</button></div>'; }).join('');
    if(kind==='dec') return (d.decisions.length?d.decisions:['']).map(function(t){ return '<div class="nl-row"><input class="nl-dec" value="'+nlEsc(t)+'" placeholder="A decision you need from them"><button type="button" class="nl-x" data-rm>\u00d7</button></div>'; }).join('');
    if(kind==='lock') return (d.locked.length?d.locked:['']).map(function(t){ return '<div class="nl-row"><input class="nl-lock" value="'+nlEsc(t)+'" placeholder="Something approved / locked"><button type="button" class="nl-x" data-rm>\u00d7</button></div>'; }).join('');
    return '';
  }
  function block(title, hint, inner, addKind){
    return '<div class="nl-block"><div class="nl-bh"><h4>'+title+'</h4>'+(hint?'<span class="nl-bhint">'+hint+'</span>':'')+'</div>'+inner+(addKind?'<button type="button" class="nl-add" data-add="'+addKind+'">+ Add</button>':'')+'</div>';
  }
  var recHTML = NL.members.length
    ? NL.members.map(function(mm){ return '<label class="nl-rec-row"><input type="checkbox" class="nl-rec" value="'+nlEsc(mm.email)+'" checked><span>'+nlEsc(mm.name)+' <i>'+nlEsc(mm.email)+'</i></span></label>'; }).join('')
    : '<div class="nl-empty-sm">No project partners have onboarded yet. Add a recipient below, or send yourself a preview.</div>';

  m.innerHTML=''
  + '<div class="nl-studio">'
  // HERO
  + block('Header image', 'Pick a video, scrub to the frame you want. The title gets baked onto it.', ''
      +'<div class="nl-hero-pick">'
      +'<div class="nl-hp-l"><label class="nl-l">Video</label><select id="nlVid" class="nl-i">'+vidOpts+'</select>'
      +'<label class="nl-l">Timecode <span id="nlTlabel" class="nl-tlabel">'+nlFmtT(d.hero.t)+'</span></label>'
      +'<input id="nlT" class="nl-range" type="range" min="0" max="600" step="1" value="'+(d.hero.t||0)+'">'
      +'<div class="nl-trow"><input id="nlTnum" class="nl-i sm" type="number" min="0" step="1" value="'+(d.hero.t||0)+'"><span class="nl-unit">seconds</span></div></div>'
      +'<div class="nl-hp-r"><div class="nl-hero-prev" id="nlHeroPrev">'+(thumb?'<img id="nlHeroImg" src="'+nlEsc(thumb)+'" alt="">':'<div class="nl-hero-none">No frame yet</div>')+'</div></div>'
      +'</div>')
  // TITLE
  + block('Title &amp; intro','', ''
      +'<label class="nl-l">Eyebrow</label><input id="nlEyebrow" class="nl-i" value="'+nlEsc(d.eyebrow)+'" placeholder="Project Update Newsletter">'
      +'<label class="nl-l">Title</label><input id="nlTitle" class="nl-i" value="'+nlEsc(d.title)+'" placeholder="Brand film is moving into Rough Cut">'
      +'<div class="nl-wchips" id="nlTitleWords">'+nlTitleChips()+'</div>'
