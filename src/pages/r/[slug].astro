  .pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px}
  .pcard{position:relative;border-radius:18px;padding:22px;background:linear-gradient(165deg,rgba(28,30,34,.66),rgba(13,14,16,.66));-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid var(--hair);box-shadow:0 18px 50px -30px #000,inset 0 1px 0 rgba(255,255,255,.04);transition:transform .18s var(--ease-out),border-color .18s var(--ease-out)}
  .pcard:hover{transform:translateY(-3px);border-color:rgba(186,192,30,.3)}
  .pc-top{display:flex;align-items:center;gap:13px}
