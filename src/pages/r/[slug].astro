async function nlSaveDraft(loud){
  nlCollect();
  var row={ review_slug:CONFIG.REVIEW_SLUG, project_key:NL.proj, data:NL.data, updated_by:myEmail(), updated_at:new Date().toISOString() };
  try{ var r=await sb.from('newsletters').upsert(row,{onConflict:'review_slug,project_key'}); if(r.error){ if(loud) nlStatus('Save failed: '+r.error.message,'err'); return false; } if(loud) nlStatus('Draft saved \u2713','ok'); return true; }catch(e){ if(loud) nlStatus('Save failed.','err'); return false; }
}
async function nlSend(){
  nlCollect();
  var recips=[]; document.querySelectorAll('.nl-rec:checked').forEach(function(c){ if(c.value) recips.push(c.value); });
  if(!recips.length){ nlStatus('Pick at least one recipient.','err'); return; }
  if(!confirm('Send this newsletter to '+recips.length+' recipient'+(recips.length>1?'s':'')+'? You\u2019ll get a copy too.')) return;
