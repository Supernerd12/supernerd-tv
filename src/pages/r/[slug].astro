function nlFmtT(t){ t=Math.max(0,Math.floor(t||0)); var mm=Math.floor(t/60), ss=t%60; return mm+':'+String(ss).padStart(2,'0'); }

/* ---------- wiring ---------- */
function nlWire(){
  var d=NL.data;
  var vid=document.getElementById('nlVid'); if(vid) vid.onchange=function(){ d.hero.uid=vid.value; d.hero.url=''; d.hero.composed=''; nlUpdHero(); };
  var rng=document.getElementById('nlT'), num=document.getElementById('nlTnum'), tl=document.getElementById('nlTlabel');
  function setT(v){ v=Math.max(0,parseInt(v,10)||0); d.hero.t=v; d.hero.composed=''; if(rng&&+rng.value!==v) rng.value=v; if(num&&+num.value!==v) num.value=v; if(tl) tl.textContent=nlFmtT(v); nlUpdHeroDeb(); }
  if(rng) rng.oninput=function(){ setT(rng.value); };
  if(num) num.oninput=function(){ setT(num.value); };
  var ti=document.getElementById('nlTitle'); if(ti) ti.oninput=function(){ d.title=ti.value; var box=document.getElementById('nlTitleWords'); if(box){ box.innerHTML=nlTitleChips(); nlWireChips(); } };
  nlWireChips();
  document.querySelectorAll('.nl-add[data-add]').forEach(function(b){ b.onclick=function(){ nlCollect(); var k=b.dataset.add; var map={hap:'happened',dec:'decisions',lock:'locked'}; if(map[k]){ d[map[k]].push(''); } else if(k==='eye'){ d.eyes.push({text:'',url:''}); } else if(k==='ms'){ d.milestones.push({text:'',tag:''}); } nlRender(); }; });
  document.querySelectorAll('.nl-x[data-rm]').forEach(function(b){ b.onclick=function(){ var row=b.closest('.nl-row'); if(row) row.parentNode.removeChild(row); nlCollect(); }; });
  var ar=document.getElementById('nlAddRecBtn'); if(ar) ar.onclick=function(){ var inp=document.getElementById('nlAddRec'); var em=(inp.value||'').trim(); if(!em||em.indexOf('@')<0) return; var recs=document.querySelector('.nl-recs'); var lbl=document.createElement('label'); lbl.className='nl-rec-row'; lbl.innerHTML='<input type="checkbox" class="nl-rec" value="'+nlEsc(em)+'" checked><span>'+nlEsc(em)+'</span>'; var empty=recs.querySelector('.nl-empty-sm'); if(empty) empty.remove(); recs.appendChild(lbl); inp.value=''; };
  var sb1=document.getElementById('nlSaveBtn'); if(sb1) sb1.onclick=function(){ nlSaveDraft(false); };
  var pb=document.getElementById('nlPreviewBtn'); if(pb) pb.onclick=nlPreview;
