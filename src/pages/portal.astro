<style is:global>
  :root{
    --ink:#050505; --green:#BAC01E; --green-hi:#D6DC3A; --bone:#ECECEA;
    --dim:rgba(236,236,234,.55); --line:rgba(236,236,234,.13); --hair:rgba(236,236,234,.07);
    --panel:rgba(18,19,22,.55); --field:rgba(10,11,12,.7);
    --disp:"Bricolage Grotesque",system-ui,sans-serif; --mono:"Space Mono",ui-monospace,monospace;
    --ease:cubic-bezier(.2,.7,.2,1);
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{background:var(--ink);color:var(--bone);font-family:var(--disp);-webkit-font-smoothing:antialiased;
    min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:26px;overflow:hidden}
  #art{position:fixed;inset:0;z-index:0;display:block}
  .flask{position:fixed;right:-7vw;bottom:-9vh;height:84vh;width:auto;opacity:.05;mix-blend-mode:screen;filter:saturate(0);z-index:1;pointer-events:none}
  .scrim{position:fixed;inset:0;z-index:2;pointer-events:none;
    background:radial-gradient(120% 90% at 50% 36%, rgba(5,5,5,.12), rgba(5,5,5,.66) 56%, rgba(5,5,5,.92) 100%)}
  .grain{position:fixed;inset:0;z-index:2;opacity:.05;pointer-events:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>")}
  .wrap{position:relative;z-index:5;width:100%;max-width:392px;text-align:center}
  .brand{display:flex;flex-direction:column;align-items:center;margin-bottom:26px}
  .mark{width:160px;height:auto;margin-bottom:18px;filter:drop-shadow(0 10px 40px rgba(0,0,0,.6))}
  .eye{font-family:var(--mono);font-size:11px;letter-spacing:.42em;text-transform:uppercase;color:var(--green);padding-left:.42em}
  .tagline{font-family:var(--mono);font-size:12px;color:var(--dim);line-height:1.6;margin-top:14px;max-width:300px}
  .stage{margin-top:4px}
  .gbtn{width:100%;display:flex;align-items:center;justify-content:center;gap:11px;background:rgba(22,23,27,.66);
    color:var(--bone);border:1px solid var(--line);border-radius:13px;padding:15px;font-family:var(--disp);font-size:15px;
    font-weight:600;cursor:pointer;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);transition:border-color .15s,background .15s,transform .12s var(--ease)}
  .gbtn+.gbtn{margin-top:10px}
  .gbtn:hover{border-color:rgba(255,255,255,.26);background:rgba(30,32,36,.78);transform:translateY(-1px)}
  .or{display:flex;align-items:center;gap:12px;margin:18px 2px;font-family:var(--mono);font-size:11px;color:var(--dim)}
  .or::before,.or::after{content:"";flex:1;height:1px;background:var(--line)}
  .mailrow{display:flex;gap:9px}
  .mailrow input{flex:1;min-width:0;background:var(--field);border:1px solid var(--line);border-radius:12px;color:var(--bone);
    font-family:var(--disp);font-size:15px;padding:14px;text-align:center;transition:border-color .15s}
  .mailrow input::placeholder{color:rgba(236,236,234,.4)}
  .mailrow input:focus{outline:none;border-color:rgba(186,192,30,.55)}
  .mailrow button{flex:0 0 auto;width:52px;background:var(--green);border:none;border-radius:12px;color:#0c0d0e;font-size:19px;
    font-weight:700;cursor:pointer;transition:background .15s}
  .mailrow button:hover{background:var(--green-hi)}
  .mailrow button:disabled{opacity:.5;cursor:not-allowed}
  .lock{display:flex;align-items:center;justify-content:center;gap:7px;font-family:var(--mono);font-size:10.5px;
    letter-spacing:.06em;color:rgba(236,236,234,.42);margin-top:22px}
  .lock svg{width:11px;height:11px;opacity:.7}
  .msg{font-family:var(--mono);font-size:11px;line-height:1.5;margin-top:13px;min-height:14px}
  .msg.err{color:#e5757a}.msg.ok{color:var(--green)}
  a.link{color:var(--green);text-decoration:none}a.link:hover{text-decoration:underline}
  .panel{background:var(--panel);-webkit-backdrop-filter:blur(22px) saturate(150%);backdrop-filter:blur(22px) saturate(150%);
    border:1px solid var(--line);border-radius:20px;padding:28px;box-shadow:0 40px 120px -52px #000, inset 0 1px 0 rgba(255,255,255,.05);text-align:left}
  h1{font-size:23px;font-weight:800;letter-spacing:-.03em;margin:0 0 7px}
  .sub{font-family:var(--mono);font-size:12px;color:var(--dim);line-height:1.65;margin-bottom:20px}
  .cta{width:100%;font-family:var(--disp);font-size:15px;font-weight:700;color:#0c0d0e;background:var(--green);border:none;
    border-radius:13px;padding:15px;cursor:pointer;transition:background .15s,transform .12s var(--ease)}
  .cta:hover{background:var(--green-hi);transform:translateY(-1px)}
  .ghost{background:none;border:none;color:var(--dim);font-family:var(--mono);font-size:11px;cursor:pointer;padding:8px}
  .ghost:hover{color:var(--green)}
  .foot{margin-top:18px;text-align:center}
  label{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-bottom:8px}
  input,select{width:100%;background:var(--field);border:1px solid var(--line);border-radius:12px;color:var(--bone);
    font-family:var(--disp);font-size:15px;padding:13px 14px;transition:border-color .15s}
  input:focus,select:focus{outline:none;border-color:rgba(186,192,30,.55)}
  .av{display:flex;align-items:center;gap:15px;margin-bottom:18px}
  .av .drop{width:80px;height:80px;border-radius:50%;border:1.5px dashed var(--line);display:flex;align-items:center;justify-content:center;
    cursor:pointer;background-size:cover;background-position:center;color:var(--dim);font-family:var(--mono);font-size:10px;text-align:center;flex:0 0 auto;transition:border-color .15s}
  .av .drop:hover{border-color:rgba(186,192,30,.55);color:var(--green)}
  .av .tx{font-family:var(--mono);font-size:11px;color:var(--dim);line-height:1.5}
  .fld{margin-bottom:15px}
  .center{text-align:center;padding:6px 0}
  .tick{width:62px;height:62px;border-radius:50%;margin:0 auto 16px;display:flex;align-items:center;justify-content:center;
    background:rgba(186,192,30,.14);border:1px solid rgba(186,192,30,.5);color:var(--green);font-size:28px}
  .av-big{width:74px;height:74px;border-radius:50%;margin:0 auto 14px;background-size:cover;background-position:center;
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:26px;color:#0b0c0d;box-shadow:inset 0 0 0 2px rgba(255,255,255,.1)}
  .spin{width:28px;height:28px;border:2px solid var(--line);border-top-color:var(--green);border-radius:50%;margin:26px auto;animation:sp 1s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  .admin-tag{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#0c0d0e;background:var(--green);border-radius:6px;padding:3px 8px;display:inline-block;margin-bottom:14px}
  textarea{width:100%;min-height:120px;background:var(--field);border:1px solid var(--line);border-radius:12px;color:var(--bone);
    font-family:var(--mono);font-size:13px;line-height:1.7;padding:13px 14px;resize:vertical}
  textarea:focus{outline:none;border-color:rgba(186,192,30,.55)}
  .ilog{font-family:var(--mono);font-size:11px;line-height:1.8;margin-top:14px;max-height:170px;overflow:auto;text-align:left}
  .ilog .ok{color:var(--green)}.ilog .er{color:#e5757a}.ilog .pend{color:var(--dim)}
  .note{font-family:var(--mono);font-size:11px;color:var(--dim);text-align:center;margin-top:18px;line-height:1.6}
.logo-row{display:flex;align-items:center;gap:13px}
  .logo-prev{width:54px;height:54px;flex:0 0 auto;border-radius:11px;border:1.5px dashed var(--line);background:#0c0d0e;background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:18px}
  .logo-up{background:rgba(236,236,234,.06);border:1px solid var(--line);color:var(--bone);font-family:var(--mono);font-size:11px;letter-spacing:.04em;border-radius:10px;padding:11px 15px;cursor:pointer;transition:border-color .15s,background .15s}
  .logo-up:hover{border-color:rgba(186,192,30,.55);color:var(--green);background:rgba(186,192,30,.08)}
    .cr-ov{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(4,5,4,.92);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
  .cr-card{width:100%;max-width:330px;border-radius:22px;padding:26px;background:var(--panel);-webkit-backdrop-filter:blur(22px) saturate(150%);backdrop-filter:blur(22px) saturate(150%);border:1px solid var(--line);box-shadow:0 40px 120px -40px #000;text-align:center}
  .cr-title{font-size:19px;font-weight:800;letter-spacing:-.02em}
  .cr-sub{font-family:var(--mono);font-size:11px;color:var(--dim);margin:5px 0 18px}
  .cr-stage{position:relative;width:264px;height:264px;margin:0 auto;border-radius:50%;overflow:hidden;background:#0b0c0d;cursor:grab;touch-action:none;box-shadow:0 0 0 1px rgba(255,255,255,.08)}
  .cr-stage:active{cursor:grabbing}
  .cr-stage img{position:absolute;user-select:none;-webkit-user-drag:none;max-width:none}
  .cr-ring{position:absolute;inset:0;border-radius:50%;box-shadow:inset 0 0 0 2px rgba(186,192,30,.45);pointer-events:none}
  .cr-zoomrow{display:flex;align-items:center;gap:12px;margin:18px 4px 4px}
  .cr-zoomrow span{font-family:var(--mono);color:var(--dim);font-size:16px;width:14px;text-align:center}
  .cr-zoomrow input[type=range]{flex:1;accent-color:var(--green)}
  .cr-actions{margin-top:18px;display:flex;gap:12px;justify-content:center}
  .cr-actions .cta{width:auto;padding:12px 22px}
  @media (max-width:440px){ .mark{width:138px} }
</style>
