    font-family:var(--mono);font-size:13px;line-height:1.7;padding:13px 14px;resize:vertical}
  textarea:focus{outline:none;border-color:rgba(186,192,30,.55)}
  .ilog{font-family:var(--mono);font-size:11px;line-height:1.8;margin-top:14px;max-height:170px;overflow:auto;text-align:left}
  .ilog .ok{color:var(--green)}.ilog .er{color:#e5757a}.ilog .pend{color:var(--dim)}
  .note{font-family:var(--mono);font-size:11px;color:var(--dim);text-align:center;margin-top:18px;line-height:1.6}
.logo-row{display:flex;align-items:center;gap:13px}
  .logo-prev{width:54px;height:54px;flex:0 0 auto;border-radius:11px;border:1.5px dashed var(--line);background-color:#0c0d0e;background-size:contain;background-repeat:no-repeat;background-position:center;background-origin:content-box;padding:7px;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:18px}
  .logo-up{background:rgba(236,236,234,.06);border:1px solid var(--line);color:var(--bone);font-family:var(--mono);font-size:11px;letter-spacing:.04em;border-radius:10px;padding:11px 15px;cursor:pointer;transition:border-color .15s,background .15s}
  .logo-up:hover{border-color:rgba(186,192,30,.55);color:var(--green);background:rgba(186,192,30,.08)}
    /* onboarding wizard takeover */
    .ob{position:fixed;inset:0;z-index:30;display:flex;align-items:center;justify-content:center;padding:26px;clip-path:inset(0 0 100% 0);transition:clip-path .62s cubic-bezier(.76,0,.24,1)}
    .ob.show{clip-path:inset(0 0 0% 0)}
    .ob-scrim{position:absolute;inset:0;background:radial-gradient(120% 90% at 50% 36%, #0b0c0a 0%, #070806 46%, #050505 100%);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
    .ob-inner{position:relative;z-index:1;width:100%;max-width:432px}
    .ob-mark{display:block;width:84px;height:auto;opacity:.92;margin:0 auto 22px}
    .ob-prog{display:flex;gap:8px;justify-content:center;margin-bottom:32px;min-height:3px}
    .ob-dot{width:26px;height:3px;border-radius:2px;background:rgba(236,236,234,.16);transition:background .3s}
    .ob-dot.on{background:var(--green)}
    .ob-dot.done{background:rgba(186,192,30,.5)}
    .ob-stage{position:relative}
    .ob-step>*{opacity:0;animation:obIn .5s cubic-bezier(.2,.7,.2,1) forwards;animation-delay:calc(var(--i,0)*68ms)}
