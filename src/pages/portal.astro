    @keyframes obIn{from{opacity:0;transform:translateX(34px)}to{opacity:1;transform:none}}
    @keyframes obInBack{from{opacity:0;transform:translateX(-34px)}to{opacity:1;transform:none}}
    .ob-step.leaving>*{animation:obOut .3s cubic-bezier(.4,0,.2,1) forwards;animation-delay:calc(var(--i,0)*32ms)}
    .ob-step.leaving.back>*{animation-name:obOutBack}
    @keyframes obOut{to{opacity:0;transform:translateX(-42px)}}
    @keyframes obOutBack{to{opacity:0;transform:translateX(42px)}}
    .ob-eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--green);margin-bottom:14px;text-align:center}
    .ob-h{font-size:29px;font-weight:800;letter-spacing:-.03em;margin:0 0 10px;text-align:center;line-height:1.06}
    .ob-p{font-family:var(--mono);font-size:12px;color:var(--dim);line-height:1.65;margin:0 auto 26px;text-align:center;max-width:330px}
    .ob-f{margin-bottom:16px}
    .ob-avwrap{display:flex;justify-content:center;margin-bottom:6px}
    .ob-drop{width:142px;height:142px;border-radius:50%;border:1.5px dashed var(--line);display:flex;align-items:center;justify-content:center;cursor:pointer;background-size:cover;background-position:center;color:var(--dim);font-family:var(--mono);font-size:12px;text-align:center;transition:border-color .15s}
    .ob-drop:hover{border-color:rgba(186,192,30,.55);color:var(--green)}
    .ob-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:24px}
    .ob-nav .cta{width:auto;flex:1;padding:15px 22px}
    .ob-back{background:none;border:1px solid var(--line);color:var(--dim);font-family:var(--mono);font-size:12px;border-radius:13px;padding:14px 20px;cursor:pointer;transition:border-color .15s,color .15s}
    .ob-back:hover{border-color:rgba(236,236,234,.3);color:var(--bone)}
    .ob-tick{width:64px;height:64px;border-radius:50%;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;background:rgba(186,192,30,.14);border:1px solid rgba(186,192,30,.5);color:var(--green);font-size:30px}
    .cta:disabled{opacity:.4;cursor:not-allowed;transform:none}
    .ob-close{position:absolute;top:22px;right:24px;z-index:2;width:38px;height:38px;border-radius:50%;background:rgba(20,21,24,.6);border:1px solid var(--line);color:var(--bone);font-size:20px;cursor:pointer;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
    .ob-close:hover{border-color:rgba(255,255,255,.26)}
    .cr-ov{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(4,5,4,.92);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
  .cr-card{width:100%;max-width:330px;border-radius:22px;padding:26px;background:var(--panel);-webkit-backdrop-filter:blur(22px) saturate(150%);backdrop-filter:blur(22px) saturate(150%);border:1px solid var(--line);box-shadow:0 40px 120px -40px #000;text-align:center}
  .cr-title{font-size:19px;font-weight:800;letter-spacing:-.02em}
  .cr-sub{font-family:var(--mono);font-size:11px;color:var(--dim);margin:5px 0 18px}
  .cr-stage{position:relative;width:264px;height:264px;margin:0 auto;border-radius:50%;overflow:hidden;background:#0b0c0d;cursor:grab;touch-action:none;box-shadow:0 0 0 1px rgba(255,255,255,.08)}
  .cr-stage:active{cursor:grabbing}
  .cr-stage img{position:absolute;user-select:none;-webkit-user-drag:none;max-width:none}
  .cr-ring{position:absolute;inset:0;border-radius:50%;box-shadow:inset 0 0 0 2px rgba(186,192,30,.45);pointer-events:none}
  .cr-zoomrow{display:flex;align-items:center;gap:12px;margin:18px 4px 4px}
  .cr-zoomrow span{font-family:var(--mono);color:var(--dim);font-size:16px;width:14px;text-align:center}
  .cr-zoomrow input[type=range]{flex:1;accent-color:var(--green)}
  .cr-actions{margin-top:18px;display:flex;gap:12px;justify-content:center}
  .cr-actions .cta{width:auto;padding:12px 22px}
  @media (max-width:440px){ .mark{width:138px} }
</style>
