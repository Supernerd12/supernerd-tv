<script is:inline>
(function(){
  var cv=document.getElementById('art'); if(!cv) return; var ctx=cv.getContext('2d');
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W,H,DPR,parts=[],N;
  var perm=new Uint8Array(512);(function(){var p=[];for(var i=0;i<256;i++)p[i]=i;for(var i=255;i>0;i--){var j=(Math.random()*(i+1))|0;var t=p[i];p[i]=p[j];p[j]=t;}for(var i=0;i<512;i++)perm[i]=p[i&255];})();
  function fade(t){return t*t*t*(t*(t*6-15)+10);}
  function lerp(a,b,t){return a+(b-a)*t;}
  function grad(h,x,y){var u=(h&1)?x:-x,v=(h&2)?y:-y;return u+v;}
  function noise(x,y){var X=Math.floor(x)&255,Y=Math.floor(y)&255;x-=Math.floor(x);y-=Math.floor(y);var u=fade(x),v=fade(y);var A=perm[X]+Y,B=perm[X+1]+Y;return lerp(lerp(grad(perm[A],x,y),grad(perm[B],x-1,y),u),lerp(grad(perm[A+1],x,y-1),grad(perm[B+1],x-1,y-1),u),v);}
  function resize(){DPR=Math.min(window.devicePixelRatio||1,2);W=cv.width=Math.floor(innerWidth*DPR);H=cv.height=Math.floor(innerHeight*DPR);cv.style.width=innerWidth+'px';cv.style.height=innerHeight+'px';ctx.fillStyle='#070806';ctx.fillRect(0,0,W,H);N=reduce?0:Math.min(900,Math.floor(innerWidth*innerHeight/1700));parts=[];for(var i=0;i<N;i++)parts.push({x:Math.random()*W,y:Math.random()*H,p:Math.random(),life:Math.random()*500|0});}
  resize(); addEventListener('resize',resize,{passive:true});
  var SCALE=0.0015, SPEED=0.42;
  function frame(t){
    ctx.fillStyle='rgba(7,8,6,0.055)'; ctx.fillRect(0,0,W,H);
    var sp=SPEED*DPR;
    for(var i=0;i<parts.length;i++){var q=parts[i];
      var a=noise(q.x*SCALE,q.y*SCALE+t*0.000035)*6.2831853*1.6;
      q.x+=Math.cos(a)*sp; q.y+=Math.sin(a)*sp; q.life++;
      if(q.x<0||q.x>W||q.y<0||q.y>H||q.life>520){q.x=Math.random()*W;q.y=Math.random()*H;q.life=0;}
      ctx.fillStyle='rgba('+(150+(q.p*46|0))+','+(160+(q.p*44|0))+',34,0.34)';
      ctx.fillRect(q.x,q.y,1.15*DPR,1.15*DPR);
    }
    requestAnimationFrame(frame);
  }
  if(!reduce) requestAnimationFrame(frame);
})();
</script>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY, REVIEW_SLUG, OWNER_EMAIL, OWNER_LOGINS, ADMIN_KEY }}>
(function(){
  var sb = supabase.createClient(SUPABASE_URL, SUPABASE_KEY, { auth:{ persistSession:true, autoRefreshToken:true, detectSessionInUrl:true, flowType:"pkce" } });
  var params = new URLSearchParams(location.search);
  var ADMIN  = params.get("admin") === ADMIN_KEY;
  var SESSION=null, EMAIL=null, INVITE=null, PROFILE=null, COMPANIES=[], PENDING=null, PENDING_LOGO=null, EDIT=null, RETURN_ENTERED=false;
  var stage=document.getElementById("stage");

  function esc(s){ return String(s==null?"":s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];}); }
  function initials(n){ var p=String(n||"").trim().split(/\s+/); return ((p[0]||"")[0]||"")+((p[1]||"")[0]||""); }
  function slug(){ return (INVITE&&INVITE.review_slug)||(PROFILE&&PROFILE.review_slug)||REVIEW_SLUG; }
  function company(id){ return COMPANIES.find(function(c){return c.id===id;})||{id:id,name:id,color:"#8b8f98"}; }
  function reEmail(e){ return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e); }

  async function loadInvite(){ try{ var r=await sb.from("invites").select("*").ilike("email",EMAIL).limit(1); INVITE=(r.data&&r.data[0])||null; }catch(e){ INVITE=null; } }
  async function loadProfile(){
    PROFILE=null;
    if(!(SESSION && SESSION.user)) return;
    var em=(SESSION.user.email||"").toLowerCase();
    var ownerEmail = (OWNER_LOGINS||[]).map(function(x){return String(x).toLowerCase();}).indexOf(em)>=0;
    var ro=null; try{ var q=await sb.from("review_settings").select("*").eq("review_slug",REVIEW_SLUG).maybeSingle(); ro=q.data||null; }catch(e){}
    var ownerUid = ro && ro.owner_uid && ro.owner_uid===SESSION.user.id;
    if(ownerEmail || ownerUid){
      PROFILE={ id:SESSION.user.id, review_slug:REVIEW_SLUG, email:SESSION.user.email,
        full_name:(ro&&ro.owner_name)||"Supernerd", position:(ro&&ro.owner_position)||"",
        company_id:(ro&&ro.owner_company_id)||null, avatar_url:(ro&&ro.owner_avatar_url)||null,
        phone:(ro&&ro.owner_phone)||null, owner:true };
      return;
    }
    try{ var r=await sb.from("profiles").select("*").eq("id",SESSION.user.id).maybeSingle(); PROFILE=r.data||null; }catch(e){ PROFILE=null; }
  }
  async function loadCompanies(){ try{ var r=await sb.from("companies").select("*").eq("review_slug",slug()).order("sort"); COMPANIES=r.data||[]; }catch(e){ COMPANIES=[]; } }

  async function boot(){
    try{ var s=await sb.auth.getSession(); SESSION=s&&s.data?s.data.session:null; }catch(e){}
    EMAIL = SESSION ? SESSION.user.email : null;
    if(EMAIL){ await loadInvite(); await loadProfile(); }
    await loadCompanies();
    render();
    sb.auth.onAuthStateChange(function(ev, session){
      setTimeout(async function(){
        SESSION=session; EMAIL=session?session.user.email:null;
        if(EMAIL){ await loadInvite(); await loadProfile(); await loadCompanies(); }
        render();
      },0);
    });
  }

  function render(){
    if(document.getElementById('ob')) return;        // wizard owns the screen; don't redraw behind it
    var br=document.querySelector('.brand'); if(br) br.style.visibility='';
    if(ADMIN) return renderAdmin();
    if(!EMAIL) return renderGate();                   // LOG IN — the front door, always
    if(!INVITE && !PROFILE) return renderBlocked();   // signed in, not invited
    if(!PROFILE) return renderSignedIn();             // signed in + invited, not onboarded yet
    return renderBack();                              // signed in + onboarded
  }

  function gsvg(){ return '<svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.6 2.4 30.2 0 24 0 14.6 0 6.4 5.4 2.6 13.2l7.9 6.1C12.4 13.2 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.1 5.4-4.6 7l7.1 5.5c4.2-3.9 6.6-9.6 6.6-17z"/><path fill="#FBBC05" d="M10.5 28.3a14.5 14.5 0 0 1 0-8.6l-7.9-6.1a24 24 0 0 0 0 20.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.5l-7.1-5.5c-2 1.3-4.6 2.1-8.1 2.1-6.3 0-11.6-3.7-13.5-9l-7.9 6.1C6.4 42.6 14.6 48 24 48z"/></svg>'; }
  function locksvg(){ return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>'; }

  function renderGate(){
    stage.innerHTML='<div class="tagline" style="margin:0 auto 26px">Private review access for Supernerd clients. Entry is by invitation only.</div>'
      +'<button class="gbtn" id="g">'+gsvg()+' Continue with Google</button>'
      +'<div class="or">or</div>'
      +'<div class="mailrow"><input id="em" type="email" placeholder="the email you were invited with" autocomplete="email"><button id="send" aria-label="Send link">\u2192</button></div>'
      +'<div class="msg" id="m"></div>'
      +'<div class="lock">'+locksvg()+' Invitation only \u00b7 access granted by Supernerd</div>';
    document.getElementById("g").onclick=function(){ sb.auth.signInWithOAuth({ provider:"google", options:{ redirectTo: location.origin+"/portal" } }); };
    var send=document.getElementById("send"), em=document.getElementById("em"), m=document.getElementById("m");
    send.onclick=async function(){
      var v=em.value.trim().toLowerCase(); m.className="msg";
      if(!reEmail(v)){ m.className="msg err"; m.textContent="Enter a valid email."; return; }
      send.disabled=true; send.textContent="\u2026";
      var inv=null; try{ var r=await sb.from("invites").select("email").ilike("email",v).limit(1); inv=(r.data&&r.data[0])||null; }catch(e){}
      if(!inv){ m.className="msg err"; m.textContent="That email isn\u2019t on the invite list. Ask Supernerd for access."; send.disabled=false; send.textContent="\u2192"; return; }
      var res=await sb.auth.signInWithOtp({ email:v, options:{ emailRedirectTo: location.origin+"/portal" } });
      if(res && res.error){ m.className="msg err"; m.textContent=res.error.message||"Could not send."; send.disabled=false; send.textContent="\u2192"; return; }
      stage.innerHTML='<div class="center"><div class="tick">\u2709\ufe0f</div><h1 style="font-size:20px;text-align:center">Check your email</h1><div class="sub" style="text-align:center;margin:8px 0 0">We sent a sign-in link to <b style="color:var(--bone)">'+esc(v)+'</b>. Tap it to enter the portal and finish onboarding.</div></div>';
    };
    em.addEventListener("keydown",function(e){ if(e.key==="Enter") send.click(); });
  }

  function renderBlocked(){
    stage.innerHTML='<div class="panel"><h1>Private area</h1><div class="sub">You\u2019re signed in as <b style="color:var(--bone)">'+esc(EMAIL)+'</b>, but this email hasn\u2019t been invited to a project. The client portal is invitation-only.</div>'
      +'<div class="note" style="margin-top:0;text-align:left">Ask Supernerd to send an invite to this exact address, then open the link in that email.</div></div>'
      +'<div class="foot"><button class="ghost" id="out">Sign out</button></div>';
    document.getElementById("out").onclick=async function(){ await sb.auth.signOut(); location.href="/portal"; };
  }

  function renderSignedIn(){
    var ob=document.getElementById('ob'); if(ob) ob.remove();
    stage.innerHTML='<div class="panel center"><div class="tick">\u2713</div>'
      +'<h1 style="text-align:center;font-size:21px">You\u2019re signed in</h1>'
      +'<div class="sub" style="text-align:center">Signed in as <b style="color:var(--bone)">'+esc(EMAIL)+'</b>. One quick step before you enter \u2014 set up your profile so the team can tag you in notes and approvals.</div>'
      +'<button class="cta" id="start">Set up your profile</button></div>'
      +'<div class="foot"><button class="ghost" id="out">Not you? Sign out</button></div>';
    document.getElementById("start").onclick=function(){ EDIT=null; renderOnboard(); };
    document.getElementById("out").onclick=async function(){ await sb.auth.signOut(); location.href="/portal"; };
  }

  function renderOnboard(){
    if(document.getElementById('ob')) return;
    var e=EDIT||{};
    var curCo=e.company_id?company(e.company_id):null;
    var OB={ step:0, dir:1, name:e.full_name||'', role:e.position||'',
      phone:e.phone||'', company:(curCo?(curCo.name||e.company_id||''):''),
      companyLogo:(curCo&&curCo.logo_url)||'', avatar:e.avatar_url||'' };
    PENDING=null; PENDING_LOGO=null;
    var TOTAL=3;
    var brand=document.querySelector('.brand'); if(brand) brand.style.visibility='hidden';
    stage.innerHTML='';
    var ov=document.createElement('div'); ov.className='ob'; ov.id='ob';
    ov.innerHTML='<div class="ob-scrim"></div><button class="ob-close" id="obClose" aria-label="Back">\u00d7</button><div class="ob-inner"><img class="ob-mark" src="/portal-logo.png" alt=""><div class="ob-prog" id="obProg"></div><div class="ob-stage" id="obStage"></div></div>';
    document.body.appendChild(ov);
    requestAnimationFrame(function(){ ov.classList.add('show'); });
    document.getElementById('obClose').onclick=function(){ EDIT=null; ov.remove(); if(brand) brand.style.visibility=''; render(); };

    function progDots(){ var h=''; for(var i=0;i<TOTAL;i++){ h+='<span class="ob-dot'+(i===OB.step?' on':'')+(i<OB.step?' done':'')+'"></span>'; } var pe=document.getElementById('obProg'); if(pe) pe.innerHTML=h; }
    function stepHTML(i){
      if(i===0){
        return '<div class="ob-eyebrow" style="--i:0">Step 1 of 3</div>'
          +'<h2 class="ob-h" style="--i:1">Let\u2019s introduce you</h2>'
          +'<p class="ob-p" style="--i:2">This is how the team will see you in notes and approvals.</p>'
          +'<div class="ob-f" style="--i:3"><label>Full name</label><input id="obName" placeholder="Jordan Rivera" value="'+esc(OB.name)+'"></div>'
          +'<div class="ob-f" style="--i:4"><label>Job position</label><input id="obRole" placeholder="Creative Director" value="'+esc(OB.role)+'"></div>'
          +'<div class="ob-nav" style="--i:5"><span></span><button class="cta" id="obNext">Continue</button></div>';
      }
      if(i===1){
        var sugg=COMPANIES.map(function(c){ return '<option value="'+esc(c.name)+'">'; }).join('');
        var ls=OB.companyLogo?'background-image:url('+OB.companyLogo+');background-size:contain;background-repeat:no-repeat;background-position:center':'';
        return '<div class="ob-eyebrow" style="--i:0">Step 2 of 3</div>'
          +'<h2 class="ob-h" style="--i:1">Where you work</h2>'
          +'<p class="ob-p" style="--i:2">Your company shows on your partner card. Phone is optional.</p>'
          +'<div class="ob-f" style="--i:3"><label>Phone <span style="opacity:.5">optional</span></label><input id="obPhone" type="tel" placeholder="(917) 555-0148" value="'+esc(OB.phone)+'"></div>'
          +'<div class="ob-f" style="--i:4"><label>Company</label><input id="obComp" list="obCoList" autocomplete="off" placeholder="Your company" value="'+esc(OB.company)+'"><datalist id="obCoList">'+sugg+'</datalist></div>'
          +'<div class="ob-f" style="--i:5"><label>Company logo <span style="opacity:.5">optional</span></label><div class="logo-row"><div class="logo-prev" id="obLogoPrev" style="'+ls+'">'+(ls?'':'\u25a2')+'</div><button type="button" class="logo-up" id="obLogoBtn">'+(ls?'Replace logo':'Upload logo')+'</button><input type="file" id="obLogoFile" accept="image/*" hidden></div></div>'
          +'<div class="ob-nav" style="--i:6"><button class="ob-back" id="obBack">Back</button><button class="cta" id="obNext">Continue</button></div>';
      }
      var drop=OB.avatar?'background-image:url('+OB.avatar+');background-size:cover;background-position:center':'';
      return '<div class="ob-eyebrow" style="--i:0">Step 3 of 3</div>'
        +'<h2 class="ob-h" style="--i:1">Put a face to the name</h2>'
        +'<p class="ob-p" style="--i:2">A clear headshot helps people recognise you in comments. Optional \u2014 initials are used otherwise.</p>'
        +'<div class="ob-avwrap" style="--i:3"><div class="ob-drop" id="obDrop" style="'+drop+'">'+(drop?'':'+ Add<br>photo')+'</div></div>'
        +'<input type="file" id="obFile" accept="image/*" hidden>'
        +'<div class="ob-nav" style="--i:4"><button class="ob-back" id="obBack">Back</button><button class="cta" id="obFinish">Finish \u00b7 enter portal</button></div>'
        +'<div class="msg" id="obMsg" style="--i:5;text-align:center"></div>';
    }
    function paint(){
      var st=document.getElementById('obStage'); if(!st) return;
      var div=document.createElement('div'); div.className='ob-step'+(OB.dir<0?' back':''); div.innerHTML=stepHTML(OB.step);
      st.innerHTML=''; st.appendChild(div); progDots(); wire();
    }
    function go(to){
      var cur=document.getElementById('obStage').querySelector('.ob-step');
      OB.dir=to>OB.step?1:-1;
      if(cur){ cur.classList.add('leaving'); if(OB.dir<0) cur.classList.add('back'); }
      setTimeout(function(){ OB.step=to; paint(); }, 300);
    }
    function sync0(){ var n=document.getElementById('obName'),r=document.getElementById('obRole'); if(n)OB.name=n.value; if(r)OB.role=r.value; }
    function sync1(){ var p=document.getElementById('obPhone'),c=document.getElementById('obComp'); if(p)OB.phone=p.value; if(c)OB.company=c.value; }
    function wire(){
      if(OB.step===0){
        var n=document.getElementById('obName'),r=document.getElementById('obRole'),nx=document.getElementById('obNext');
        function g(){ nx.disabled=!(n.value.trim()&&r.value.trim()); }
        n.oninput=g; r.oninput=g; g();
        nx.onclick=function(){ if(nx.disabled)return; sync0(); go(1); };
        setTimeout(function(){ try{ n.focus(); }catch(_){} },420);
      } else if(OB.step===1){
        var c=document.getElementById('obComp'),nx=document.getElementById('obNext');
        function g(){ nx.disabled=!c.value.trim(); }
        c.oninput=g; g();
        document.getElementById('obBack').onclick=function(){ sync1(); go(0); };
        nx.onclick=function(){ if(nx.disabled)return; sync1(); go(2); };
        var lp=document.getElementById('obLogoPrev'),lb=document.getElementById('obLogoBtn'),lf=document.getElementById('obLogoFile');
        lb.onclick=function(){ lf.click(); };
        lf.onchange=function(){ var f=lf.files[0]; if(!f)return; PENDING_LOGO=f; var u=URL.createObjectURL(f); lp.style.backgroundImage='url('+u+')'; lp.style.backgroundSize='contain'; lp.style.backgroundRepeat='no-repeat'; lp.style.backgroundPosition='center'; lp.textContent=''; lb.textContent='Replace logo'; lf.value=''; };
      } else {
        document.getElementById('obBack').onclick=function(){ go(1); };
        var drop=document.getElementById('obDrop'),file=document.getElementById('obFile');
        drop.onclick=function(){ file.click(); };
        file.onchange=function(){ var f=file.files[0]; if(!f)return; openCropper(f,function(out,purl){ PENDING=out; OB.avatar=purl; drop.style.backgroundImage='url('+purl+')'; drop.style.backgroundSize='cover'; drop.style.backgroundPosition='center'; drop.innerHTML=''; }); file.value=''; };
        document.getElementById('obFinish').onclick=save;
      }
    }
    async function save(){
      var fin=document.getElementById('obFinish'), m=document.getElementById('obMsg');
      fin.disabled=true; fin.textContent='Saving\u2026'; if(m){ m.className='msg'; m.textContent=''; }
      var cname=(OB.company||'').trim();
      var existing=COMPANIES.find(function(c){ return (c.name||'').toLowerCase()===cname.toLowerCase(); });
      var cid=existing?existing.id:(cname.toLowerCase().replace(/[^a-z0-9]+/g,'_')||('co'+Date.now()));
      var logoUrl=null; if(PENDING_LOGO){ logoUrl=await ppUploadLogo(PENDING_LOGO,cid); }
      if(cname){ var coRow={review_slug:slug(),id:cid,name:cname}; if(logoUrl) coRow.logo_url=logoUrl; try{ await sb.from('companies').upsert(coRow,{onConflict:'review_slug,id'}); }catch(e){} }
      var avatarUrl=(EDIT&&EDIT.avatar_url)||null;
      if(PENDING){ try{ var ext=(PENDING.name&&PENDING.name.indexOf('.')>=0)?PENDING.name.split('.').pop().toLowerCase():'png'; var path=SESSION.user.id+'/'+Date.now()+'.'+ext; var up=await sb.storage.from('avatars').upload(path,PENDING,{upsert:true,cacheControl:'3600'}); if(!up.error){ avatarUrl=sb.storage.from('avatars').getPublicUrl(path).data.publicUrl; } }catch(e){} }
      var row={ id:SESSION.user.id, review_slug:slug(), email:SESSION.user.email, full_name:(OB.name||'').trim(), position:(OB.role||'').trim(), phone:(OB.phone||'').trim(), company_id:cname?cid:null, avatar_url:avatarUrl, updated_at:new Date().toISOString() };
      var err=null; try{ var r=await sb.from('profiles').upsert(row,{onConflict:'id'}); if(r.error) err=r.error; }catch(e){ err=e; }
      if(err){ if(m){ m.className='msg err'; m.textContent=(/row-level|policy/i.test(err.message||'')?'This email isn\u2019t invited to onboard. Ask Supernerd for an invite.':'Could not save: '+(err.message||'try again')); } fin.disabled=false; fin.textContent='Finish \u00b7 enter portal'; return; }
      PROFILE=row; EDIT=null;
      var st=document.getElementById('obStage');
      st.innerHTML='<div class="ob-step"><div class="ob-tick" style="--i:0">\u2713</div><h2 class="ob-h" style="--i:1">You\u2019re in, '+esc((row.full_name||'there').split(/\s+/)[0])+'!</h2><p class="ob-p" style="--i:2">Your partner card is live. Supernerd has been notified.</p><div class="ob-nav" style="--i:3"><span></span><button class="cta" id="obEnter">Enter the portal</button></div></div>';
      var pe=document.getElementById('obProg'); if(pe) pe.innerHTML='';
      document.getElementById('obEnter').onclick=goPortal;
    }
    paint();
  }
  async function ppUploadLogo(file, cid){
    try{
      var ext=(file.name&&file.name.indexOf(".")>=0)?file.name.split(".").pop().toLowerCase():"png";
      var safe=String(cid||"co").replace(/[^a-z0-9_-]+/gi,"_");
      var path="company-logos/"+safe+"/"+Date.now()+"."+ext;
      var up=await sb.storage.from("avatars").upload(path,file,{upsert:true,cacheControl:"3600"});
      if(up.error) return null;
      return sb.storage.from("avatars").getPublicUrl(path).data.publicUrl;
    }catch(e){ return null; }
  }

  function renderBack(){
    var c=company(PROFILE.company_id);
    var av=PROFILE.avatar_url?'background-image:url('+PROFILE.avatar_url+')':'background:linear-gradient(150deg,'+(c.color||'#BAC01E')+',#0b0c0d)';
    var first=esc((PROFILE.full_name||'there').split(/\s+/)[0]);
    stage.innerHTML='<div class="panel center"><div class="av-big" style="'+av+'">'+(PROFILE.avatar_url?"":esc(initials(PROFILE.full_name).toUpperCase()))+'</div>'
      +'<h1 style="text-align:center;font-size:21px">Welcome back, '+first+'</h1>'
      +'<div class="sub" style="text-align:center">Taking you into the portal\u2026</div>'
      +'<button class="cta" id="enter">Enter now</button></div>'
      +'<div class="foot">'+(PROFILE.owner?'':'<button class="ghost" id="edit">Edit profile</button> &nbsp;\u00b7&nbsp; ')+'<button class="ghost" id="out">Sign out</button></div>';
    document.getElementById("enter").onclick=goPortal;
    var ed=document.getElementById("edit"); if(ed) ed.onclick=function(){ EDIT=PROFILE; renderOnboard(); };
    document.getElementById("out").onclick=async function(){ await sb.auth.signOut(); location.href="/portal"; };
    if(!RETURN_ENTERED){ RETURN_ENTERED=true; setTimeout(goPortal, 650); }
  }

  function goPortal(){
    var s=REVIEW_SLUG||slug();
    var q=(PROFILE&&PROFILE.owner)?("?admin="+encodeURIComponent(ADMIN_KEY)):"";
    location.href="/r/"+s+"/"+q;
  }

  function renderAdmin(){
    stage.innerHTML='<div class="panel"><div class="admin-tag">Admin \u00b7 Supernerd</div><h1>Invite partners</h1>'
      +'<div class="sub">Paste emails (commas, spaces, or new lines). Each person gets a link that drops them into onboarding for this project.</div>'
      +'<div class="fld"><label>Project</label><input id="aslug" value="'+esc(REVIEW_SLUG)+'"></div>'
      +'<div class="fld"><label>Emails</label><textarea id="emails" placeholder="ada@studio.com&#10;winnie@funkychild.co&#10;margot@trrp.org"></textarea></div>'
      +'<button class="cta" id="go">Send invites</button>'
      +'<div class="ilog" id="log"></div>'
      +'<div class="note">Re-inviting just resends \u2014 no duplicates. <a class="link" href="/r/'+esc(REVIEW_SLUG)+'/?admin='+esc(ADMIN_KEY)+'">Open the portal \u2192</a></div></div>';
    var go=document.getElementById("go"), log=document.getElementById("log");
    go.onclick=async function(){
      var sl=document.getElementById("aslug").value.trim()||REVIEW_SLUG;
      var raw=document.getElementById("emails").value.split(/[\s,;]+/).map(function(s){return s.trim().toLowerCase();}).filter(Boolean);
      var seen={}, list=raw.filter(function(e){ if(seen[e])return false; seen[e]=1; return reEmail(e); });
      if(!list.length){ log.innerHTML='<span class="er">No valid emails found.</span>'; return; }
      go.disabled=true; go.textContent="Sending\u2026"; log.innerHTML="";
      for(var i=0;i<list.length;i++){
        var e=list[i];
        var line=document.createElement("div"); line.innerHTML='<span class="pend">\u2026 '+esc(e)+'</span>'; log.appendChild(line);
        try{ await sb.from("invites").upsert({ review_slug:sl, email:e },{ onConflict:"review_slug,email" }); }catch(err){}
        var res=await sb.auth.signInWithOtp({ email:e, options:{ emailRedirectTo: location.origin+"/portal" } });
        if(res && res.error){ line.innerHTML='<span class="er">\u2717 '+esc(e)+' \u2014 '+esc(res.error.message||"failed")+'</span>'; }
        else { line.innerHTML='<span class="ok">\u2713 '+esc(e)+' \u2014 invite sent</span>'; }
        await new Promise(function(r){ setTimeout(r, 700); });
      }
      go.disabled=false; go.textContent="Send invites";
      var done=document.createElement("div"); done.innerHTML='<span class="ok" style="display:block;margin-top:8px">Done \u2014 '+list.length+' invite(s) processed.</span>'; log.appendChild(done);
    };
  }

  function openCropper(file, cb){
    var url=URL.createObjectURL(file), img=new Image();
    img.onload=function(){
      var S=264;
      var ov=document.createElement("div"); ov.className="cr-ov"; ov.id="crOv";
      ov.innerHTML='<div class="cr-card"><div class="cr-title">Position your photo</div><div class="cr-sub">Drag to move \u00b7 slider to zoom</div>'
        +'<div class="cr-stage" id="crStage"><img id="crImg" src="'+url+'" draggable="false" alt=""><div class="cr-ring"></div></div>'
        +'<div class="cr-zoomrow"><span>\u2212</span><input type="range" id="crZoom" min="1" max="3" step="0.01" value="1"><span>+</span></div>'
        +'<div class="cr-actions"><button class="cta" id="crApply">Use photo</button><button class="ghost" id="crCancel">Cancel</button></div></div>';
      document.body.appendChild(ov);
      var im=document.getElementById("crImg"), zoom=document.getElementById("crZoom");
      var iw=img.naturalWidth||1, ih=img.naturalHeight||1, cover=Math.max(S/iw,S/ih), z=1, tx=0, ty=0;
      function apply(){ var sc=cover*z, w=iw*sc, h=ih*sc, mx=Math.max(0,(w-S)/2), my=Math.max(0,(h-S)/2); tx=Math.max(-mx,Math.min(mx,tx)); ty=Math.max(-my,Math.min(my,ty)); im.style.width=w+"px"; im.style.height=h+"px"; im.style.left=(S/2-w/2+tx)+"px"; im.style.top=(S/2-h/2+ty)+"px"; }
      apply(); zoom.oninput=function(){ z=parseFloat(zoom.value)||1; apply(); };
      var dg=false, sx=0, sy=0;
      function pt(e){ var t=(e.touches&&e.touches[0])?e.touches[0]:e; return {x:t.clientX,y:t.clientY}; }
      function dn(e){ dg=true; var p=pt(e); sx=p.x-tx; sy=p.y-ty; e.preventDefault(); }
      function mv(e){ if(!dg)return; var p=pt(e); tx=p.x-sx; ty=p.y-sy; apply(); e.preventDefault(); }
      function up(){ dg=false; }
      im.addEventListener("mousedown",dn); window.addEventListener("mousemove",mv); window.addEventListener("mouseup",up);
      im.addEventListener("touchstart",dn,{passive:false}); window.addEventListener("touchmove",mv,{passive:false}); window.addEventListener("touchend",up);
      function clean(){ window.removeEventListener("mousemove",mv); window.removeEventListener("mouseup",up); window.removeEventListener("touchmove",mv); window.removeEventListener("touchend",up); try{URL.revokeObjectURL(url);}catch(e){} ov.remove(); }
      document.getElementById("crCancel").onclick=clean;
      document.getElementById("crApply").onclick=function(){
        var OUT=400, f=OUT/S, sc=cover*z, w=iw*sc, h=ih*sc;
        var cvn=document.createElement("canvas"); cvn.width=OUT; cvn.height=OUT; var c2=cvn.getContext("2d");
        c2.fillStyle="#0b0c0d"; c2.fillRect(0,0,OUT,OUT);
        c2.save(); c2.beginPath(); c2.arc(OUT/2,OUT/2,OUT/2,0,Math.PI*2); c2.closePath(); c2.clip();
        c2.drawImage(img,(S/2-w/2+tx)*f,(S/2-h/2+ty)*f,w*f,h*f); c2.restore();
        cvn.toBlob(function(blob){ var out=blob?new File([blob],"avatar.png",{type:"image/png"}):file; cb(out, URL.createObjectURL(blob||file)); clean(); },"image/png",0.92);
      };
    };
    img.onerror=function(){ cb(file,url); };
    img.src=url;
  }

  boot();
})();
</script>
</body>
</html>
