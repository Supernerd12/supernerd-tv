<style is:global>

  :root{
    --ink:#050505; --green:#BAC01E; --green-hi:#D6DC3A; --bone:#ECECEA;
    --dim:rgba(236,236,234,.55); --faint:rgba(236,236,234,.20);
    --disp:"Bricolage Grotesque",system-ui,sans-serif;
    --mono:"Space Mono",ui-monospace,monospace;
    --ease:cubic-bezier(.16,1,.3,1);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{background:var(--ink); color:var(--bone); font-family:var(--mono);
    overflow:hidden; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;}

  /* ===== STAGE: aligned full-frame plates, stacked 1:1 ===== */
  .stage{position:fixed; inset:0; overflow:hidden;
    background:radial-gradient(125% 100% at 64% 44%, #111308 0%, #080804 52%, #030302 100%);}
  .plane{position:absolute; inset:-4%; width:108%; height:108%;
    background-position:center; background-size:cover; background-repeat:no-repeat;
    will-change:transform;}

  .p-smoke   { z-index:1; background-image:url("/hero/smoke.png");      }
  .p-flask   { z-index:2; background-image:url("/hero/flask.png");      mix-blend-mode:overlay; }
  .p-person  { z-index:4; background-image:url("/hero/person.png");     background-position:70% center; }
  .p-fsmoke  { z-index:5; background-image:url("/hero/frontsmoke.png"); mix-blend-mode:screen; }

  /* wordmark: large + dominant. Width glides ~80vw (desktop) -> ~112vw (phone),
     left-anchored so it starts at the left, runs behind the person, and is allowed
     to bleed off the right edge on small screens rather than shrinking tiny. */
  .wordimg{ position:absolute; z-index:3; left:3%; top:52%; transform:translateY(-50%);
    width:calc(68.1vw + 171px); max-width:1700px; height:auto; pointer-events:none;
    filter:drop-shadow(0 0 30px rgba(186,192,30,.22)); }

  .vignette{position:fixed; inset:0; z-index:6; pointer-events:none;
    background:radial-gradient(140% 115% at 62% 46%, transparent 50%, rgba(0,0,0,.6) 100%);}
  .grain{position:fixed; inset:-50%; z-index:7; pointer-events:none; opacity:.045;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    animation:grain 6s steps(6) infinite;}
  @keyframes grain{0%{transform:translate(0,0)}20%{transform:translate(-4%,3%)}40%{transform:translate(3%,-4%)}60%{transform:translate(-3%,2%)}80%{transform:translate(4%,3%)}100%{transform:translate(0,0)}}

  /* ===== CHROME ===== */
  .ui{position:fixed; inset:0; z-index:11;}
  .ui>*{pointer-events:auto;}
  .top{position:absolute; top:0; left:0; right:0; padding:26px 40px; display:flex; align-items:center; justify-content:space-between;}
  .menu{display:flex; flex-direction:column; gap:5px; cursor:pointer; width:30px;}
  .menu span{height:2px; background:var(--bone); border-radius:2px; transition:.3s var(--ease);}
  .menu span:nth-child(2){width:70%} .menu:hover span:nth-child(2){width:100%}
  .brand{font-family:var(--mono); font-size:12px; letter-spacing:.42em; text-transform:uppercase; color:var(--green-hi);}
  .contact{font-family:var(--mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--bone);
    border:1px solid rgba(236,236,234,.34); padding:11px 20px; border-radius:2px; background:transparent; cursor:pointer; transition:.3s var(--ease);}
  .contact:hover{border-color:var(--green); color:var(--green-hi); box-shadow:0 0 22px rgba(186,192,30,.25);}
  .label-lol{position:absolute; top:33%; left:40px; transform:translateY(-50%) rotate(180deg); writing-mode:vertical-rl;
    font-family:var(--mono); font-size:10px; letter-spacing:.4em; text-transform:uppercase; color:var(--faint);}
  .bottom{position:absolute; left:40px; bottom:44px; max-width:44ch;}
  .quote{font-family:var(--disp); font-weight:700; font-size:clamp(20px,2.4vw,30px); line-height:1.18; color:var(--bone); margin-bottom:6px;
    text-shadow:0 2px 26px rgba(0,0,0,.7);}
  .quote .mk{color:var(--green-hi); white-space:nowrap;}
  .sub{font-family:var(--mono); font-size:12px; letter-spacing:.12em; color:var(--dim); margin-bottom:24px;}
  .cta{font-family:var(--mono); font-size:12px; letter-spacing:.18em; text-transform:uppercase; color:var(--ink); background:var(--green);
    border:0; padding:14px 26px; border-radius:2px; display:inline-flex; align-items:center; gap:10px; cursor:pointer; transition:.3s var(--ease);}
  .cta .dot{width:7px; height:7px; border-radius:50%; background:var(--ink);}
  .cta:hover{background:var(--green-hi); box-shadow:0 0 30px rgba(186,192,30,.45); transform:translateY(-1px);}
  .social{position:absolute; right:40px; bottom:44px; display:flex; flex-direction:column; gap:14px; align-items:center;
    font-family:var(--mono); font-size:12px; color:var(--dim);}
  .social a{color:var(--dim); text-decoration:none; transition:.25s;} .social a:hover{color:var(--green-hi);}

  .stage,.ui{opacity:0; transition:opacity 1.1s var(--ease);}
  body.live .stage,body.live .ui{opacity:1;}
  body.live .bottom,body.live .top,body.live .social{animation:rise 1s var(--ease) both;}
  body.live .bottom{animation-delay:.25s} body.live .social{animation-delay:.4s}
  @keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}

  /* ===== INTRO TEXT MOMENTS ===== */
  .intro{position:fixed; inset:0; z-index:40; background:var(--ink); display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:22px; text-align:center; transition:opacity 1.2s var(--ease),visibility 1.2s; cursor:pointer;}
  .intro.gone{opacity:0; visibility:hidden;}
  .intro .kick{font-family:var(--mono); font-size:11px; letter-spacing:.55em; text-transform:uppercase; color:var(--green-hi); opacity:0; animation:lineIn .8s var(--ease) .2s forwards;}
  .intro .l1{font-family:var(--disp); font-weight:800; letter-spacing:-.02em; font-size:clamp(30px,6.4vw,86px); line-height:.98; color:var(--bone); opacity:0; animation:lineIn 1s var(--ease) .8s forwards;}
  .intro .l2{font-family:var(--disp); font-weight:600; font-size:clamp(15px,2vw,24px); color:var(--dim); opacity:0; animation:lineIn 1s var(--ease) 1.7s forwards;}
  .intro .l2 b{color:var(--green-hi); font-weight:700;}
  .intro .hint{position:absolute; bottom:40px; font-family:var(--mono); font-size:10px; letter-spacing:.3em; text-transform:uppercase; color:var(--faint); opacity:0; animation:lineIn 1s var(--ease) 2.6s forwards;}
  @keyframes lineIn{from{opacity:0;transform:translateY(22px);filter:blur(6px)}to{opacity:1;transform:none;filter:blur(0)}}

  @media (max-width:640px){
    .top{ padding:18px 20px }
    .label-lol,.social{ display:none }
    .bottom{ left:20px; right:20px; bottom:26px; max-width:none; }
  }
  @media (prefers-reduced-motion:reduce){ .grain{display:none} *{animation-duration:.001s!important; transition-duration:.2s!important} }

</style>

<div class="stage" id="stage">
    <div class="plane p-smoke"  data-depth="6"></div>
    <div class="plane p-flask"  data-depth="16"></div>
    <img  class="wordimg"       data-depth="12" src="/hero/wordcrop.png" alt="supernerd">
    <div class="plane p-person" data-depth="22"></div>
    <div class="plane p-fsmoke" data-depth="34"></div>
  </div>
  <div class="vignette"></div>
  <div class="grain"></div>

  <div class="ui">
    <div class="top">
      <div class="menu"><span></span><span></span><span></span></div>
      <div class="brand">supernerd</div>
      <button class="contact">Contact</button>
    </div>
    <div class="label-lol">supernerd.tv — 01 / 01</div>
    <div class="bottom">
      <p class="quote" data-depth="20">“ Now meet the <span class="mk">secret weapon</span><br>behind the moments you never forget. ”</p>
      <div class="sub" data-depth="14">You've seen the work.</div>
      <button class="cta" data-depth="24"><span class="dot"></span> Meet the mind</button>
    </div>
    <div class="social"><a href="#">IG</a><a href="#">IN</a><a href="#">YT</a></div>
  </div>

  <div class="intro" id="intro">
    <div class="kick">supernerd.tv</div>
    <div class="l1">You've already<br>seen his work.</div>
    <div class="l2">Now meet the <b>secret weapon</b> behind it.</div>
    <div class="hint">click anywhere to enter</div>
  </div>

<script is:inline>

(function(){
  const intro=document.getElementById('intro');
  const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  function enter(){ if(document.body.classList.contains('live'))return;
    document.body.classList.add('live'); intro.classList.add('gone'); enableGyro(); }
  const auto=setTimeout(enter, reduce?200:4200);
  ['click','keydown','wheel','touchstart'].forEach(ev=>
    window.addEventListener(ev,()=>{clearTimeout(auto); enter();},{once:true,passive:true}));

  const planes=[...document.querySelectorAll('[data-depth]')];
  let tx=0,ty=0,cx=0,cy=0,raf=null; const fine=matchMedia('(pointer:fine)').matches;
  function onMove(e){ tx=(e.clientX/innerWidth-0.5); ty=(e.clientY/innerHeight-0.5); if(!raf)raf=requestAnimationFrame(tick); }
  function tick(){ cx+=(tx-cx)*0.06; cy+=(ty-cy)*0.06;
    for(const el of planes){ const d=+el.dataset.depth;
      const base=el.classList.contains('wordimg')?' translateY(-50%)':'';
      el.style.transform=`translate(${(-cx*d).toFixed(2)}px,${(-cy*d*0.62).toFixed(2)}px)`+base; }
    if(Math.abs(tx-cx)>0.001||Math.abs(ty-cy)>0.001) raf=requestAnimationFrame(tick); else raf=null; }
  if(fine&&!reduce) window.addEventListener('mousemove',onMove,{passive:true});

  // gyroscope parallax for phones/tablets — drives the same tick() loop as the mouse
  let gyroOn=false;
  function startGyro(){ if(gyroOn)return; gyroOn=true;
    window.addEventListener('deviceorientation',e=>{
      if(e.gamma==null&&e.beta==null) return;
      tx=Math.max(-1,Math.min(1,(e.gamma||0)/28))*0.6;        // left / right tilt
      ty=Math.max(-1,Math.min(1,((e.beta||0)-45)/28))*0.6;    // forward / back tilt (held ~45°)
      if(!raf) raf=requestAnimationFrame(tick);
    },{passive:true});
  }
  function enableGyro(){
    if(fine||reduce) return;
    const DOE=window.DeviceOrientationEvent;
    if(DOE && typeof DOE.requestPermission==='function'){      // iOS 13+: needs the tap gesture
      DOE.requestPermission().then(s=>{ if(s==='granted') startGyro(); }).catch(()=>{});
    } else if(DOE){ startGyro(); }                              // Android & others
  }
})();

</script>
